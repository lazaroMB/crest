# Generated by scripts/publish-homebrew.sh from packaging/homebrew/crest.rb.in
# in lazaroMB/crest; edit the template there, not this file.
cask "crest" do
  arch arm: "aarch64", intel: "x86_64"

  version "@VERSION@"
  sha256 arm:   "@SHA256_ARM@",
         intel: "@SHA256_INTEL@"

  url "https://github.com/lazaroMB/crest/releases/download/v#{version}/crest-#{version}-#{arch}-apple-darwin.tar.gz"
  name "crest"
  desc "Desktop coding agent for Claude and OpenCode models"
  homepage "https://github.com/lazaroMB/crest"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :big_sur"
  depends_on formula: ["ripgrep", "fzf"]

  app "crest-#{version}-#{arch}-apple-darwin/crest.app"
  binary "#{appdir}/crest.app/Contents/MacOS/crest"

  # Homebrew does not write in your home: the commented init.lua and the
  # example color themes of the tarball stay in the Caskroom.
  caveats <<~EOS
    A commented init.lua and example color themes are in
      #{staged_path}/crest-#{version}-#{arch}-apple-darwin/config
    To copy them into crest's config folder without replacing your files:
      mkdir -p ~/.config/crest/themes
      cp -n #{staged_path}/crest-#{version}-#{arch}-apple-darwin/config/init.lua ~/.config/crest/
      cp -n #{staged_path}/crest-#{version}-#{arch}-apple-darwin/config/themes/*.lua ~/.config/crest/themes/
  EOS

  zap trash: [
    "~/.config/crest",
    "~/.local/share/crest",
  ]
end
