# Generated by scripts/publish-homebrew.sh from packaging/homebrew/crest.rb.in
# in lazaroMB/crest; edit the template there, not this file.
cask "crest" do
  arch arm: "aarch64", intel: "x86_64"

  version "@VERSION@"
  sha256 arm:   "@SHA256_ARM@",
         intel: "@SHA256_INTEL@"

  url "https://github.com/lazaroMB/crest/releases/download/v#{version}/crest-#{version}-#{arch}-apple-darwin.tar.gz"
  name "crest"
  desc "Desktop coding agent for Claude and OpenCode models"
  homepage "https://github.com/lazaroMB/crest"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :big_sur"
  depends_on formula: ["ripgrep", "fzf"]

  app "crest-#{version}-#{arch}-apple-darwin/crest.app"
  binary "#{appdir}/crest.app/Contents/MacOS/crest"

  zap trash: [
    "~/.config/crest",
    "~/.local/share/crest",
  ]
end
