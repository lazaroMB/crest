---
source: crates/app/src/tools/files.rs
expression: def
---
{
  "name": "read_file",
  "description": "Reads a text file of the workspace. Lines are returned numbered as `cat -n` does (line number, a tab, the line); the numbers are not part of the file.\n- `path` is relative to the workspace root.\n- Returns up to 2000 lines by default. For long files pass `offset` (1-based first line) and `limit` (number of lines) to read a range; a cut result ends with the offset to continue.\n- Binary files are rejected, and files over 2 MB can only be read with an explicit range.\n- Read a file before editing it, so `edit_file` gets the exact current text.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "File to read."
      },
      "offset": {
        "type": [
          "integer",
          "null"
        ],
        "format": "uint",
        "minimum": 0,
        "description": "1-based number of the first line to return (default 1).",
        "default": null
      },
      "limit": {
        "type": [
          "integer",
          "null"
        ],
        "format": "uint",
        "minimum": 0,
        "description": "Maximum number of lines to return (default 2000).",
        "default": null
      }
    },
    "required": [
      "path"
    ],
    "description": "Input of the `read_file` tool.",
    "title": "ReadFileRequest",
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "cache": false
}
