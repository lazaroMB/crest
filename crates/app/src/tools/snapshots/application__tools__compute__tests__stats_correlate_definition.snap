---
source: crates/app/src/tools/compute.rs
expression: "definition(StatsCorrelateTool::new(ports))"
---
{
  "name": "stats_correlate",
  "description": "Computes a correlation matrix (Pearson, Spearman or Kendall) with crest's deterministic engine, with p-values adjusted for the number of pairs (Holm by default) and pairwise n. For two variables it also gives the interval of r. The user sees a heatmap card; you get the values as slots to cite.",
  "input_schema": {
    "type": "object",
    "properties": {
      "data": {
        "$ref": "#/$defs/DataInput"
      },
      "variables": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Numeric columns; all numeric columns when empty.",
        "default": []
      },
      "method": {
        "$ref": "#/$defs/CorrelationMethod",
        "description": "Coefficient (default pearson).",
        "default": "pearson"
      },
      "adjustment": {
        "$ref": "#/$defs/PAdjust",
        "description": "Adjustment of the p-values for the number of pairs (default holm).",
        "default": "holm"
      },
      "conf_level": {
        "type": "number",
        "format": "double",
        "description": "Level of the interval reported for a single pair (default 0.95).",
        "default": 0.95
      }
    },
    "required": [
      "data"
    ],
    "description": "Input of `correlate`: a correlation matrix.",
    "title": "CorrelateRequest",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "DataInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ],
            "description": "A CSV or TSV file of the workspace whose first row names the\ncolumns, e.g. `data/cars.csv`. Cells that all read as numbers make a\nnumeric column; empty cells and `NA` are missing. Give this or\n`columns`, not both.",
            "default": null
          },
          "delimiter": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1,
            "description": "Field separator of `path`; by default a tab for `.tsv` files and a\ncomma otherwise.",
            "default": null
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/DataColumn"
            },
            "description": "Inline columns of equal length: `{\"name\": \"mpg\", \"values\": [21.0,\nnull, 22.8]}` (numbers or strings; `null` is missing).",
            "default": []
          }
        },
        "description": "Where a statistics tool reads its data from."
      },
      "PAdjust": {
        "oneOf": [
          {
            "type": "string",
            "const": "none",
            "description": "Raw p-values."
          },
          {
            "type": "string",
            "const": "holm",
            "description": "Holm step-down."
          },
          {
            "type": "string",
            "const": "bh",
            "description": "Benjamini-Hochberg false discovery rate."
          },
          {
            "type": "string",
            "const": "bonferroni",
            "description": "Bonferroni."
          }
        ],
        "description": "Multiple-comparison adjustment of p-values."
      },
      "DataColumn": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Column name, as the other request fields refer to it."
          },
          "values": {
            "$ref": "#/$defs/ColumnValues",
            "description": "The values; `null` is a missing value."
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Unit of numeric values, e.g. `mi/gal`."
          }
        },
        "required": [
          "name",
          "values"
        ],
        "description": "One named column."
      },
      "ColumnValues": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "description": "Numbers (`null` = missing)."
          },
          {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": "Categories (`null` = missing)."
          }
        ],
        "description": "The values of a column: all numbers or all text."
      },
      "CorrelationMethod": {
        "oneOf": [
          {
            "type": "string",
            "const": "pearson",
            "description": "Pearson's r."
          },
          {
            "type": "string",
            "const": "spearman",
            "description": "Spearman's ρ."
          },
          {
            "type": "string",
            "const": "kendall",
            "description": "Kendall's τ-b."
          }
        ],
        "description": "Correlation coefficient."
      }
    }
  }
}
