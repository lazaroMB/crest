---
source: crates/app/src/tools/form.rs
expression: "json!({\n    \"name\": tool.name(), \"description\": tool.description(), \"input_schema\":\n    tool.input_schema(),\n})"
---
{
  "name": "ask_user",
  "description": "Shows the user a form in the timeline and waits until they submit or cancel it. Use it when you need structured answers (pick one or several options, numbers with bounds, yes/no, short or long text) instead of asking in prose. `schema` is a JSON Schema object: `properties` are the fields in display order and `required` lists the mandatory ones. Each property has `type` string, number, integer, boolean or array, plus optional `title` (the label), `description` and `default`. Strings take `minLength`/`maxLength` (whole numbers) and `format: \"multiline\"` for long text; `format: \"date\"` shows a date picker and returns `YYYY-MM-DD`, bounded by `formatMinimum`/`formatMaximum` (`email`, `uri` and `date-time` are shown as text); numbers and integers take `minimum`/`maximum`; one choice is a string with `enum` (labels in `enumNames`) or `oneOf: [{const, title}]`; several choices are `{type: \"array\", items: {type: \"string\", enum: [...]}}` with `minItems`/`maxItems` (whole numbers). Annotations such as `examples`, `pattern` or `readOnly` are accepted but not enforced; nested objects, `$ref`, `anyOf`, `allOf` and `const` are rejected. Returns the submitted values by field name (empty optional fields are absent), the user's words when they answer in the chat instead, or an error when the user cancels.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "description": "Heading of the form: what you need to know."
      },
      "description": {
        "type": [
          "string",
          "null"
        ],
        "description": "Why you ask, shown under the heading.",
        "default": null
      },
      "schema": {
        "description": "The questions: a JSON Schema object with `properties` (one per\nfield, in order) and `required`.",
        "type": "object"
      },
      "submit_label": {
        "type": [
          "string",
          "null"
        ],
        "description": "Text of the submit button; `Submit` when absent.",
        "default": null
      }
    },
    "required": [
      "title",
      "schema"
    ],
    "description": "Input of `ask_user`.",
    "title": "AskUser",
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
