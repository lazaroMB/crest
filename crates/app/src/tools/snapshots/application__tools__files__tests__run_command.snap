---
source: crates/app/src/tools/files.rs
expression: def
---
{
  "name": "run_command",
  "description": "Runs a program in the workspace root and returns its exit code, stdout and stderr.\n- `command` is the program and `args` its arguments, one per element. No shell is involved: pipes, redirections, `&&`, globs and variables are not interpreted.\n- Use it to build, test, format or inspect history (`git log`, `git blame`, `git diff`, `git status`, `git show` run without approval). Other commands may need the user's approval.\n- Prefer `grep`, `find_file`, `list_files`, `tree` and `read_file` over `rg`, `find`, `ls` or `cat`, and `edit_file`/`write_file` over commands that modify files.\n- The process is killed after `timeout_s` seconds (default 120). Long output is cut; a non-zero exit code is reported in the result, not as a failure of the tool.",
  "input_schema": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "description": "Program to run, looked up on `PATH`; no shell is involved, so pipes,\nredirections and globs are not interpreted."
      },
      "args": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Arguments passed to the program as-is.",
        "default": []
      },
      "timeout_s": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0,
        "description": "Seconds before the process is killed (default 120).",
        "default": 120
      }
    },
    "required": [
      "command"
    ],
    "description": "Input of the `run_command` tool.",
    "title": "RunCommandRequest",
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "cache": false
}
