---
source: crates/app/src/tools/compute.rs
expression: "definition(StatsDistributionTool::new(ports))"
---
{
  "name": "stats_distribution",
  "description": "Shows the distribution of one numeric variable with crest's deterministic engine: a histogram (binning rule and width stated), a Gaussian kernel density (bandwidth rule stated), box and violin plots with 1.5×IQR outliers, a normal QQ plot with a pointwise band and the ECDF with its DKW band; one per group of `by`. The user sees the plots; you get n, mean, SD, quartiles, outlier count, bin width and bandwidth as slots to cite.",
  "input_schema": {
    "type": "object",
    "properties": {
      "data": {
        "$ref": "#/$defs/DataInput"
      },
      "variable": {
        "type": "string",
        "description": "Numeric column to describe."
      },
      "by": {
        "type": [
          "string",
          "null"
        ],
        "description": "Grouping column: one distribution per level, drawn side by side."
      },
      "bin_rule": {
        "$ref": "#/$defs/BinRule",
        "description": "Binning rule (default freedman_diaconis); `bins` overrides it.",
        "default": "freedman_diaconis"
      },
      "bins": {
        "type": [
          "integer",
          "null"
        ],
        "format": "uint32",
        "minimum": 0,
        "description": "Number of histogram bins (1–200), instead of the rule."
      },
      "bandwidth_rule": {
        "$ref": "#/$defs/BandwidthRule",
        "description": "Kernel bandwidth rule (default silverman); `bandwidth` overrides it.",
        "default": "silverman"
      },
      "bandwidth": {
        "type": [
          "number",
          "null"
        ],
        "format": "double",
        "description": "Kernel bandwidth in the variable's unit, instead of the rule."
      },
      "conf_level": {
        "type": "number",
        "format": "double",
        "description": "Coverage of the QQ and ECDF bands (default 0.95).",
        "default": 0.95
      }
    },
    "required": [
      "data",
      "variable"
    ],
    "description": "Input of `distribution`: histogram, kernel density, box/violin, normal\nQQ and ECDF of one numeric variable, per group of `by`.",
    "title": "DistributionRequest",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "DataInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ],
            "description": "A CSV or TSV file of the workspace whose first row names the\ncolumns, e.g. `data/cars.csv`. Cells that all read as numbers make a\nnumeric column; empty cells and `NA` are missing. Give this or\n`columns`, not both.",
            "default": null
          },
          "delimiter": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1,
            "description": "Field separator of `path`; by default a tab for `.tsv` files and a\ncomma otherwise.",
            "default": null
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/DataColumn"
            },
            "description": "Inline columns of equal length: `{\"name\": \"mpg\", \"values\": [21.0,\nnull, 22.8]}` (numbers or strings; `null` is missing).",
            "default": []
          }
        },
        "description": "Where a statistics tool reads its data from."
      },
      "BandwidthRule": {
        "oneOf": [
          {
            "type": "string",
            "const": "silverman",
            "description": "Silverman's rule of thumb, 0.9·min(SD, IQR/1.34)·n^(−1/5) (R's\n`bw.nrd0`)."
          },
          {
            "type": "string",
            "const": "scott",
            "description": "Scott's rule, 1.06·min(SD, IQR/1.34)·n^(−1/5) (R's `bw.nrd`)."
          },
          {
            "type": "string",
            "const": "fixed",
            "description": "A bandwidth given in the request."
          }
        ],
        "description": "How the kernel bandwidth was chosen."
      },
      "DataColumn": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Column name, as the other request fields refer to it."
          },
          "values": {
            "$ref": "#/$defs/ColumnValues",
            "description": "The values; `null` is a missing value."
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Unit of numeric values, e.g. `mi/gal`."
          }
        },
        "required": [
          "name",
          "values"
        ],
        "description": "One named column."
      },
      "ColumnValues": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "description": "Numbers (`null` = missing)."
          },
          {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": "Categories (`null` = missing)."
          }
        ],
        "description": "The values of a column: all numbers or all text."
      },
      "BinRule": {
        "oneOf": [
          {
            "type": "string",
            "const": "freedman_diaconis",
            "description": "Freedman-Diaconis: width 2·IQR·n^(−1/3) (Sturges when the IQR is 0)."
          },
          {
            "type": "string",
            "const": "sturges",
            "description": "Sturges: ⌈log₂ n⌉ + 1 bins."
          },
          {
            "type": "string",
            "const": "scott",
            "description": "Scott: width 3.49·SD·n^(−1/3)."
          },
          {
            "type": "string",
            "const": "fixed",
            "description": "A bin count given in the request."
          }
        ],
        "description": "How the histogram bins were chosen."
      }
    }
  }
}
