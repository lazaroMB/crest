      "input_schema": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "cache_control": {
        "type": "ephemeral"
      }
    },
    {
      "name": "shell",
      "description": "Run a command",
      "input_schema": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      }
    },
    {
      "type": "web_search_20260318",
      "name": "web_search",
      "max_uses": 5
    },
    {
      "type": "web_fetch_20260318",
      "name": "web_fetch",
      "citations": {
        "enabled": true
