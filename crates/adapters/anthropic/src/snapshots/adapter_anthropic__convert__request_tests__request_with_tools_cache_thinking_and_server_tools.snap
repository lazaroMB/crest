---
source: crates/adapters/anthropic/src/convert.rs
expression: "messages_request(&req, &req.model.spec.id, true)"
---
{
  "model": "claude-opus-4-6",
  "max_tokens": 20000,
  "system": [
    {
      "type": "text",
