      "cache_control": {
        "type": "ephemeral"
      }
    },
    {
      "type": "text",
      "text": "Workspace: /tmp/project"
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Find the bug"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "read_file",
