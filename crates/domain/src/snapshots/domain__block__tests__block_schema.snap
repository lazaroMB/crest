            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "snippet": {
          "description": "Source excerpt of the location.",
          "type": [
            "string",
            "null"
          ]
        },
        "help_uri": {
          "description": "Link to the rule's documentation.",
          "type": [
            "string",
            "null"
          ]
        },
        "fix": {
          "description": "Suggested fix as a unified diff, made from [`Finding::fixes`]\nagainst the files.",
          "type": [
            "string",
            "null"
          ]
        },
        "fixes": {
          "description": "Suggested fixes as the log describes them (SARIF `fixes`): edits\nof byte or text ranges. Alternatives; the first is the preferred.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FindingFix"
          }
        }
      },
      "required": [
        "severity",
        "message"
      ]
    },
    "FindingSeverity": {
      "description": "Severity of a [`Finding`], the SARIF levels.",
      "oneOf": [
        {
          "description": "A problem.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "A possible problem.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Information.",
          "type": "string",
          "const": "note"
        },
        {
          "description": "No severity given.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "FindingFix": {
      "description": "A suggested fix: edits of one or more files.",
      "type": "object",
      "properties": {
        "description": {
          "description": "What it does.",
          "type": [
            "string",
            "null"
          ]
        },
        "edits": {
          "description": "The edits, in log order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixEdit"
          }
        }
      },
      "required": [
        "edits"
      ]
    },
    "FixEdit": {
      "description": "Replaces a range of a file with `inserted` (SARIF `replacement`). The\nrange is given by lines and columns (1-based, the end column\nexclusive; columns count characters), by character offset and length,\nor by byte offset and length.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The file, as the log names it (made workspace-relative by the tool).",
          "type": "string"
        },
        "start_line": {
          "description": "First line of the range.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "start_column": {
          "description": "First column; 1 when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "description": "Last line; `start_line` when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_column": {
          "description": "Column after the range; the end of `end_line` when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "char_offset": {
          "description": "Characters before the range, when given by offset.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "char_length": {
          "description": "Characters in the range (0 when absent).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "byte_offset": {
          "description": "Bytes before the range, when given by byte offset.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "byte_length": {
          "description": "Bytes in the range (0 when absent).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inserted": {
          "description": "The new text.",
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "path"
      ]
    },
    "FindingsSpec": {
      "description": "Static-analysis findings, SARIF-like.",
      "type": "object",
      "properties": {
        "tool": {
          "description": "Tool that produced them, e.g. `clippy 0.1.95`.",
          "type": [
            "string",
            "null"
          ]
        },
        "findings": {
          "description": "The findings, in report order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "required": [
        "findings"
      ]
    },
    "DatasetFormat": {
      "description": "Format of a dataset file.",
      "oneOf": [
        {
          "description": "Comma-separated values.",
          "type": "string",
          "const": "csv"
        },
        {
          "description": "Tab-separated values.",
          "type": "string",
          "const": "tsv"
        },
        {
          "description": "Apache Parquet.",
          "type": "string",
          "const": "parquet"
        },
        {
          "description": "Arrow IPC.",
          "type": "string",
          "const": "arrow"
        },
        {
          "description": "JSON lines.",
          "type": "string",
          "const": "jsonl"
        }
      ]
    },
    "DatasetColumn": {
      "description": "Schema and statistics of one column.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "dtype": {
          "description": "Data type as the file or the inference names it, e.g. `int64`,\n`utf8`, `timestamp[ms]`.",
          "type": "string"
        },
        "null_percent": {
          "description": "Share of null values, 0–100.",
          "type": "number",
          "format": "double"
        },
        "distinct": {
          "description": "Number of distinct values, when computed.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "distinct_capped": {
          "description": "Whether counting stopped at a cap: there are at least `distinct`\nvalues.",
          "type": "boolean"
        },
        "min": {
          "description": "Smallest value.",
          "anyOf": [
            {
              "$ref": "#/$defs/Cell"
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "description": "Largest value.",
          "anyOf": [
            {
              "$ref": "#/$defs/Cell"
            },
            {
              "type": "null"
            }
          ]
        },
        "histogram": {
          "description": "Distribution for the sparkline (numeric columns).",
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "dtype",
        "null_percent"
      ]
    },
    "DatasetSpec": {
      "description": "A dataset preview.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Workspace-relative path of the file.",
          "type": "string"
        },
        "format": {
          "description": "File format.",
          "$ref": "#/$defs/DatasetFormat"
        },
        "rows": {
          "description": "Total number of rows, when known without reading everything.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "sampled": {
          "description": "Whether the statistics come from a sample of the rows.",
          "type": "boolean",
          "default": false
        },
        "columns": {
          "description": "One entry per column, in file order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DatasetColumn"
          }
        },
        "preview": {
          "description": "The first rows.",
          "$ref": "#/$defs/TableSpec"
        }
      },
      "required": [
        "path",
        "format",
        "columns",
        "preview"
      ]
    },
    "MoleculeSpec": {
      "description": "A molecule drawn from SMILES.",
      "type": "object",
      "properties": {
        "smiles": {
          "description": "SMILES as given.",
          "type": "string"
        },
        "name": {
          "description": "Name to show beside the drawing.",
          "type": [
            "string",
            "null"
          ]
        },
        "svg": {
          "description": "2D depiction, SVG source.",
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "description": "Molecular formula in Hill order, computed.",
          "type": [
            "string",
            "null"
          ]
        },
        "mw": {
          "description": "Molecular weight in g/mol, computed.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "charge": {
          "description": "Net formal charge, computed.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "canonical": {
          "description": "Canonical SMILES, computed.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "Why the SMILES could not be parsed, with the column when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_formula": {
          "description": "Formula the model stated, to compare with the computed one.",
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_matches": {
          "description": "Whether `claimed_formula` matches `formula` (see [`formulas_match`]).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "smiles"
      ]
    },
    "Well": {
      "description": "One well of a plate.",
      "type": "object",
      "properties": {
        "well": {
          "description": "Position, row letter and 1-based column: `A1`, `P24`.",
          "type": "string"
        },
        "label": {
          "description": "Sample label, e.g. `blank`, `ctrl+`.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "Measured value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "well"
      ]
    },
    "PlateScale": {
      "description": "The colour scale of a plate map.",
      "oneOf": [
        {
          "description": "Faint at the minimum to solid at the maximum.",
          "type": "string",
          "const": "sequential"
        },
        {
          "description": "Two hues away from a centre (fold changes, z-scores, % of control).",
          "type": "string",
          "const": "diverging"
        },
        {
          "description": "Sequential over `log10` of the values (concentrations, counts);\nwells at or below 0 are not coloured.",
          "type": "string",
          "const": "log"
        }
      ]
    },
    "PlateSpec": {
      "description": "A microplate map: a value and a label per well, drawn as a heatmap.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "Number of wells: 96 (8×12) or 384 (16×24).",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "value_label": {
          "description": "What the values are, e.g. `OD600`.",
          "type": [
            "string",
            "null"
          ]
        },
        "wells": {
          "description": "Wells with data; the others are drawn empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Well"
          }
        },
        "scale": {
          "description": "How values map to colours.",
          "$ref": "#/$defs/PlateScale"
        },
        "center": {
          "description": "Centre of a diverging scale; 0 when the values straddle 0, else\ntheir median.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "format",
        "wells"
      ]
    },
    "TraceFormat": {
      "description": "The file format a trace came from.",
      "oneOf": [
        {
          "description": "OTLP JSON (`ExportTraceServiceRequest`, or one per line).",
          "type": "string",
          "const": "otlp"
        },
        {
          "description": "Jaeger's JSON (`/api/traces` or the UI's download).",
          "type": "string",
          "const": "jaeger"
        },
        {
          "description": "Zipkin v2 JSON.",
          "type": "string",
          "const": "zipkin"
        }
      ]
    },
    "TraceSpec": {
      "description": "One or more traces, drawn as a waterfall.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption; the file name when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path of the file.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "What the file was.",
          "$ref": "#/$defs/TraceFormat"
        },
        "traces": {
          "description": "Distinct trace ids.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "services": {
          "description": "Services, in order of first appearance.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "started_at": {
          "description": "Wall clock of the first span start, in seconds since the epoch.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "total_spans": {
          "description": "Spans in the file; more than the rows when it was cut at\n[`MAX_SPANS`].",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "timeline": {
          "description": "One row per span in tree order, times in ms from the first start.",
          "$ref": "#/$defs/TimelineSpec"
        },
        "critical_path": {
          "description": "Row ids on the critical path of the longest trace, root first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "format",
        "traces",
        "total_spans",
        "timeline"
      ]
    },
    "ProfileFormat": {
      "description": "The file format a profile came from.",
      "oneOf": [
        {
          "description": "Brendan Gregg's collapsed stacks: `frame;frame;frame count`.",
          "type": "string",
          "const": "folded"
        },
        {
          "description": "A pprof `profile.proto` (gzipped or not).",
          "type": "string",
          "const": "pprof"
        }
      ]
    },
    "FlameNode": {
      "description": "One frame of the call tree.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Function (or frame) name.",
          "type": "string"
        },
        "depth": {
          "description": "0 for the root, 1 for its callees...",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "start": {
          "description": "Offset on the value axis: the parent's start plus the totals of the\nsiblings before it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "description": "Value of the frame and everything it called.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "self_value": {
          "description": "Value spent in the frame itself.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "depth",
        "start",
        "total",
        "self_value"
      ]
    },
    "FlameSpec": {
      "description": "A call tree to draw as an icicle.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption; the file name when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path of the file.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "What the file was.",
          "$ref": "#/$defs/ProfileFormat"
        },
        "unit": {
          "description": "What a value counts: `samples`, or a pprof sample type such as\n`cpu nanoseconds` or `alloc_space bytes`.",
          "type": "string"
        },
        "nodes": {
          "description": "The root first, then each frame followed by its callees.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlameNode"
          }
        },
        "hidden": {
          "description": "Frames left out because they were too small to draw.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "format",
        "unit",
        "nodes"
      ]
    },
    "LogFormat": {
      "description": "How the lines were written.",
      "oneOf": [
        {
          "description": "One JSON object per line (pino, bunyan, zap, slog, tracing...).",
          "type": "string",
          "const": "json"
        },
        {
          "description": "`key=value` pairs (logrus, Go `log/slog` text, Heroku).",
          "type": "string",
          "const": "logfmt"
        },
        {
          "description": "Free text; level and timestamp guessed from each line.",
          "type": "string",
          "const": "text"
        }
      ]
    },
    "LogHistogram": {
      "description": "Lines over time: `buckets.len()` buckets of `width` seconds from\n`start` (seconds since the epoch).",
      "type": "object",
      "properties": {
        "start": {
          "description": "Start of the first bucket.",
          "type": "number",
          "format": "double"
        },
        "width": {
          "description": "Width of a bucket, in seconds.",
          "type": "number",
          "format": "double"
        },
        "buckets": {
          "description": "Counts per bucket.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BucketCounts"
          }
        }
      },
      "required": [
        "start",
        "width",
        "buckets"
      ]
    },
    "BucketCounts": {
      "description": "Lines of one time bucket, by level class.",
      "type": "object",
      "properties": {
        "errors": {
          "description": "Fatal and error lines.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "warnings": {
          "description": "Warnings.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "other": {
          "description": "Everything else (info, debug, no level).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "LogSpec": {
      "description": "A log file.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Workspace path of the file.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "How the lines were written (most of them).",
          "$ref": "#/$defs/LogFormat"
        },
        "total_lines": {
          "description": "Records in the bytes read; more than the items when cut at\n[`MAX_LINES`].",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "truncated": {
          "description": "Only the head of the file was read.",
          "type": "boolean"
        },
        "list": {
          "description": "The records, with the title and facets.",
          "$ref": "#/$defs/ListSpec"
        },
        "histogram": {
          "description": "Lines per time bucket, when enough timestamps parsed.",
          "anyOf": [
            {
              "$ref": "#/$defs/LogHistogram"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format",
        "total_lines",
        "list"
      ]
    },
    "PlanEngine": {
      "description": "The database that wrote the plan.",
      "oneOf": [
        {
          "description": "PostgreSQL `EXPLAIN (FORMAT JSON)`.",
          "type": "string",
          "const": "postgres"
        }
      ]
    },
    "PlanNode": {
      "description": "One node of the plan.",
      "type": "object",
      "properties": {
        "node_type": {
          "description": "`Node Type`: `Seq Scan`, `Hash Join`, `Sort`...",
          "type": "string"
        },
        "depth": {
          "description": "Nesting level, 0 for the root.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "relation": {
          "description": "Table, view, function or CTE scanned (`schema.name` when the schema\nwas given).",
          "type": [
            "string",
            "null"
          ]
        },
        "alias": {
          "description": "Alias of the relation, when it differs from its name.",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "description": "Index used.",
          "type": [
            "string",
            "null"
          ]
        },
        "join_type": {
          "description": "`Inner`, `Left`, `Semi`... of a join.",
          "type": [
            "string",
            "null"
          ]
        },
        "parent_relationship": {
          "description": "How the node feeds its parent: `Outer`, `Inner`, `InitPlan`,\n`SubPlan`.",
          "type": [
            "string",
            "null"
          ]
        },
        "subplan_name": {
          "description": "Name of an `InitPlan` / `SubPlan`.",
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {
          "description": "The main condition or key (index, hash, merge or join condition,\nfilter, sort or group key).",
          "type": [
            "string",
            "null"
          ]
        },
        "startup_cost": {
          "description": "Planner cost to the first row.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "total_cost": {
          "description": "Planner cost to the last row.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "plan_rows": {
          "description": "Rows the planner expected, per loop.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "actual_time": {
          "description": "Time to the last row, per loop, in ms (`ANALYZE`).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "actual_rows": {
          "description": "Rows produced, per loop (`ANALYZE`).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "loops": {
          "description": "Times the node ran (`ANALYZE`); 0 means it never ran.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rows_removed": {
          "description": "Rows removed by the filter, join filter and index recheck, per\nloop.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "workers": {
          "description": "Workers launched (`Gather`, `Gather Merge`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "buffers": {
          "description": "Buffer counts (`BUFFERS`).",
          "anyOf": [
            {
              "$ref": "#/$defs/PlanBuffers"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort_space_type": {
          "description": "`Sort Space Type` (`Memory`, `Disk`) of a sort.",
          "type": [
            "string",
            "null"
          ]
        },
        "sort_space_kb": {
          "description": "`Sort Space Used`, in kB.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "hash_batches": {
          "description": "`Hash Batches` of a hash; more than one means it spilled.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inclusive_time": {
          "description": "Time over all loops (per process of a parallel plan), in ms; set\nby [`QueryPlanSpec::analyse`].",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "self_time": {
          "description": "[`Self::inclusive_time`] minus the children's, in ms; set by\n[`QueryPlanSpec::analyse`].",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "warnings": {
          "description": "What looks wrong with the node; set by [`QueryPlanSpec::analyse`].",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attrs": {
          "description": "The node's other scalar properties, as written.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "node_type"
      ]
    },
    "PlanBuffers": {
      "description": "Buffer counts of a node (`BUFFERS`), in blocks.",
      "type": "object",
      "properties": {
        "shared_hit": {
          "description": "Shared blocks found in the cache.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "shared_read": {
          "description": "Shared blocks read from disk (or the OS cache).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "shared_dirtied": {
          "description": "Shared blocks dirtied.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "shared_written": {
          "description": "Shared blocks written.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "local": {
          "description": "Local (temporary table) blocks hit or read.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "temp_read": {
          "description": "Temporary file blocks read.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "temp_written": {
          "description": "Temporary file blocks written (a spill).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "QueryPlanSpec": {
      "description": "A plan, its timings and its nodes.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption; the file name when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path of the file, when the plan came from one.",
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "description": "Who wrote the plan.",
          "$ref": "#/$defs/PlanEngine",
          "default": "postgres"
        },
        "analyzed": {
          "description": "The plan has actual times and rows (`ANALYZE`).",
          "type": "boolean",
          "default": false
        },
        "buffers": {
          "description": "The plan has buffer counts (`BUFFERS`).",
          "type": "boolean",
          "default": false
        },
        "planning_time": {
          "description": "`Planning Time`, in ms.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "execution_time": {
          "description": "`Execution Time`, in ms.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "trigger_time": {
          "description": "Time in triggers, in ms.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "jit_time": {
          "description": "JIT compilation time, in ms.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "nodes": {
          "description": "Nodes in preorder, the root first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanNode"
          }
        }
      },
      "required": [
        "nodes"
      ]
    },
    "HarPage": {
      "description": "A page load the requests belong to.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Id the entries refer to.",
          "type": "string"
        },
        "title": {
          "description": "Title (often the URL).",
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "description": "Start, in ms from the first request.",
          "type": "number",
          "format": "double"
        },
        "on_content_load": {
          "description": "`DOMContentLoaded`, in ms from the page start.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "on_load": {
          "description": "`load`, in ms from the page start.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "id",
        "start"
      ]
    },
    "HarEntry": {
      "description": "One request and its response.",
      "type": "object",
      "properties": {
        "method": {
          "description": "`GET`, `POST`...",
          "type": "string"
        },
        "url": {
          "description": "The full URL as requested.",
          "type": "string"
        },
        "http_version": {
          "description": "`HTTP/1.1`, `h2`...",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Response status; 0 when there was no response (blocked, aborted,\nfailed).",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "status_text": {
          "description": "Reason phrase.",
          "type": [
            "string",
            "null"
          ]
        },
        "resource_type": {
          "description": "`document`, `script`, `stylesheet`, `image`, `font`, `xhr`,\n`fetch`, `media`, `websocket` or `other`.",
          "type": "string"
        },
        "mime_type": {
          "description": "Media type of the response.",
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "description": "Start, in ms from the start of the first request.",
          "type": "number",
          "format": "double"
        },
        "time": {
          "description": "Total time, in ms.",
          "type": "number",
          "format": "double"
        },
        "timings": {
          "description": "Where the time went.",
          "$ref": "#/$defs/HarTimings",
          "default": {}
        },
        "request_headers": {
          "description": "Request headers.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HarHeader"
          }
        },
        "response_headers": {
          "description": "Response headers.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HarHeader"
          }
        },
        "query": {
          "description": "Query string parameters.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HarHeader"
          }
        },
        "request_body": {
          "description": "The posted body.",
          "anyOf": [
            {
              "$ref": "#/$defs/HarBody"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_body": {
          "description": "The response body.",
          "anyOf": [
            {
              "$ref": "#/$defs/HarBody"
            },
            {
              "type": "null"
            }
          ]
        },
        "transfer_size": {
          "description": "Bytes on the wire (headers and compressed body).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "content_size": {
          "description": "Size of the decoded response body.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "server_ip": {
          "description": "IP address of the server.",
          "type": [
            "string",
            "null"
          ]
        },
        "redirect_url": {
          "description": "Target of a redirect.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "Why the request failed (`net::ERR_...`), when the file says.",
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "description": "Id of the page it belongs to.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "url",
        "resource_type",
        "start",
        "time"
      ]
    },
    "HarTimings": {
      "description": "Where a request's time went, in ms (`None` when the phase did not\napply, `-1` in the file).",
      "type": "object",
      "properties": {
        "blocked": {
          "description": "Queued, waiting for a connection.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "dns": {
          "description": "DNS lookup.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "connect": {
          "description": "TCP connect, without the TLS handshake (the file's `connect`\nincludes `ssl`; the adapter takes it out).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "ssl": {
          "description": "TLS handshake.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "send": {
          "description": "Sending the request.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "wait": {
          "description": "Waiting for the first byte (server time plus a round trip).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "receive": {
          "description": "Reading the response.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "HarHeader": {
      "description": "A header, query parameter or form field.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name as written.",
          "type": "string"
        },
        "value": {
          "description": "Value as written.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "HarBody": {
      "description": "A request or response body.",
      "type": "object",
      "properties": {
        "mime_type": {
          "description": "Its media type.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "Size in bytes, when the file gave it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "text": {
          "description": "The first [`MAX_BODY_PREVIEW`] bytes of the text; `None` when the\nfile did not keep it or it is binary.",
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "description": "The text was cut to the preview size.",
          "type": "boolean"
        },
        "base64": {
          "description": "The file stored it base64-encoded (binary); no preview is kept.",
          "type": "boolean"
        }
      }
    },
    "HarSpec": {
      "description": "The requests of a HAR file.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption; the file name when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path of the file.",
          "type": [
            "string",
            "null"
          ]
        },
        "creator": {
          "description": "What wrote it (`WebInspector 537.36`, `Firefox 131.0`).",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "description": "Wall clock of the first request, in seconds since the epoch.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "pages": {
          "description": "Page loads.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HarPage"
          }
        },
        "entries": {
          "description": "Requests in start order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HarEntry"
          }
        },
        "total_entries": {
          "description": "Requests in the file; more than `entries` when it was cut at\n[`MAX_ENTRIES`].",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "entries",
        "total_entries"
      ]
    },
    "PlanSource": {
      "description": "Where the plan came from.",
      "oneOf": [
        {
          "description": "`terraform show -json <planfile>`: attribute values included.",
          "type": "string",
          "const": "show"
        },
        {
          "description": "The `planned_change` lines of `terraform plan -json`: actions only.",
          "type": "string",
          "const": "stream"
        }
      ]
    },
    "ResourceChange": {
      "description": "One resource with a planned change.",
      "type": "object",
      "properties": {
        "address": {
          "description": "Full address (`module.net.aws_subnet.private[1]`).",
          "type": "string"
        },
        "kind": {
          "description": "Resource type (`aws_instance`).",
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "description": "`data` for a data source.",
          "type": "boolean"
        },
        "provider": {
          "description": "The provider (`registry.terraform.io/hashicorp/aws`).",
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "description": "What happens to it.",
          "$ref": "#/$defs/PlanAction"
        },
        "reason": {
          "description": "Why (`replace_because_cannot_update`, `delete_because_no_resource_config`).",
          "type": [
            "string",
            "null"
          ]
        },
        "previous_address": {
          "description": "The resource moves from this address.",
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "description": "The attributes that change (all set ones for a create or\ndestroy), at most [`MAX_ATTRS`].",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttrChange"
          }
        },
        "attributes_total": {
          "description": "Attribute changes before the cap at [`MAX_ATTRS`].",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "address",
        "action"
      ]
    },
    "PlanAction": {
      "description": "What happens to a resource or output.",
      "oneOf": [
        {
          "description": "Destroyed.",
          "type": "string",
          "const": "delete"
        },
        {
          "description": "Destroyed and created again (in either order).",
          "type": "string",
          "const": "replace"
        },
        {
          "description": "Changed in place.",
          "type": "string",
          "const": "update"
        },
        {
          "description": "Created.",
          "type": "string",
          "const": "create"
        },
        {
          "description": "A data source read during apply.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "Removed from the state without being destroyed (`removed` block).",
          "type": "string",
          "const": "forget"
        },
        {
          "description": "Nothing to do.",
          "type": "string",
          "const": "no_op"
        }
      ]
    },
    "AttrChange": {
      "description": "One attribute that differs (or, for a create or destroy, is set).",
      "type": "object",
      "properties": {
        "path": {
          "description": "Flattened path: `tags.Name`, `ingress[0].port`, `tags[\"a.b\"]`.",
          "type": "string"
        },
        "before": {
          "description": "The value before.",
          "$ref": "#/$defs/AttrValue",
          "default": {
            "kind": "absent"
          }
        },
        "after": {
          "description": "The value after.",
          "$ref": "#/$defs/AttrValue",
          "default": {
            "kind": "absent"
          }
        },
        "forces_replacement": {
          "description": "Changing it forces the resource to be replaced.",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ]
    },
    "AttrValue": {
      "description": "One side of an attribute change.",
      "oneOf": [
        {
          "description": "Not set on this side.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "absent"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "A value (a scalar, or an empty list or map).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "known"
            },
            "value": true
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Marked sensitive: the value is not kept.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sensitive"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Known only after apply.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "OutputChange": {
      "description": "A root module output that changes.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Output name.",
          "type": "string"
        },
        "action": {
          "description": "What happens to it.",
          "$ref": "#/$defs/PlanAction"
        },
        "before": {
          "description": "The value before.",
          "$ref": "#/$defs/AttrValue",
          "default": {
            "kind": "absent"
          }
        },
        "after": {
          "description": "The value after.",
          "$ref": "#/$defs/AttrValue",
          "default": {
            "kind": "absent"
          }
        }
      },
      "required": [
        "name",
        "action"
      ]
    },
    "TerraformPlanSpec": {
      "description": "A Terraform plan.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption; the file name when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path of the file.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Which JSON it was.",
          "$ref": "#/$defs/PlanSource",
          "default": "show"
        },
        "terraform_version": {
          "description": "Terraform (or OpenTofu) version that wrote it.",
          "type": [
            "string",
            "null"
          ]
        },
        "resources": {
          "description": "Resources that change, in the plan's order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceChange"
          }
        },
        "unchanged": {
          "description": "Resources with nothing to do.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "drift": {
          "description": "Addresses changed outside Terraform since the last apply.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "description": "Outputs that change.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputChange"
          }
        },
        "errored": {
          "description": "Planning failed part way (the plan is incomplete).",
          "type": "boolean"
        },
        "applyable": {
          "description": "Whether the plan can be applied, when the file says.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "resources"
      ]
    },
    "DiagramSource": {
      "description": "What the diagram was drawn from.",
      "oneOf": [
        {
          "description": "A Graphviz DOT file.",
          "type": "string",
          "const": "dot"
        },
        {
          "description": "SQL `CREATE TABLE` / `ALTER TABLE` statements.",
          "type": "string",
          "const": "sql_ddl"
        }
      ]
    },
    "ErTable": {
      "description": "A table and its columns.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Table name (schema-qualified when the DDL was).",
          "type": "string"
        },
        "columns": {
          "description": "Columns in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErColumn"
          },
          "default": []
        }
      },
      "required": [
        "name"
      ]
    },
    "ErColumn": {
      "description": "A column of a table.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "data_type": {
          "description": "Its type as written (`varchar(80)`, `bigint`).",
          "type": "string"
        },
        "primary_key": {
          "description": "Part of the primary key.",
          "type": "boolean"
        },
        "nullable": {
          "description": "May hold NULL.",
          "type": "boolean",
          "default": true
        },
        "unique": {
          "description": "Has a unique constraint of its own.",
          "type": "boolean"
        },
        "references": {
          "description": "`table.column` it references.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "data_type"
      ]
    },
    "DiagramSpec": {
      "description": "A diagram, its graph and (for DDL) its tables.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption; the graph's own name or the file name when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path of the file, when it came from one.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "What it was drawn from.",
          "$ref": "#/$defs/DiagramSource"
        },
        "dialect": {
          "description": "The SQL dialect the DDL was read in.",
          "type": [
            "string",
            "null"
          ]
        },
        "graph": {
          "description": "What the block draws.",
          "$ref": "#/$defs/GraphSpec"
        },
        "tables": {
          "description": "Tables of an ER diagram, in DDL order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErTable"
          }
        },
        "warnings": {
          "description": "What was skipped (statements that did not parse, DOT features not\ndrawn).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source",
        "graph"
      ]
    },
    "Bench": {
      "description": "One benchmark.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Criterion's id (`group/function/value`).",
          "type": "string"
        },
        "dir": {
          "description": "Directory under the criterion root.",
          "type": "string"
        },
        "new": {
          "description": "The new run.",
          "$ref": "#/$defs/RunEstimates"
        },
        "base": {
          "description": "The baseline run, when there is one.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunEstimates"
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "description": "Relative change of the mean (fractions), from the change file.",
          "anyOf": [
            {
              "$ref": "#/$defs/Estimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "median_change": {
          "description": "Relative change of the median, from the change file.",
          "anyOf": [
            {
              "$ref": "#/$defs/Estimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "description": "The verdict on [`Self::change`].",
          "$ref": "#/$defs/Verdict"
        },
        "ratio": {
          "description": "`new mean / base mean − 1` when there is a baseline but no change\nfile (no interval).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "id",
        "dir",
        "new",
        "verdict"
      ]
    },
    "RunEstimates": {
      "description": "The estimates of one run, in nanoseconds per iteration.",
      "type": "object",
      "properties": {
        "mean": {
          "description": "Mean time.",
          "$ref": "#/$defs/Estimate"
        },
        "median": {
          "description": "Median time.",
          "anyOf": [
            {
              "$ref": "#/$defs/Estimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "std_dev": {
          "description": "Standard deviation.",
          "anyOf": [
            {
              "$ref": "#/$defs/Estimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "slope": {
          "description": "Slope of the linear regression (iteration count against time), when\ncriterion used linear sampling.",
          "anyOf": [
            {
              "$ref": "#/$defs/Estimate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mean"
      ]
    },
    "Estimate": {
      "description": "A point estimate with its confidence interval.",
      "type": "object",
      "properties": {
        "point": {
          "description": "The point estimate.",
          "type": "number",
          "format": "double"
        },
        "lo": {
          "description": "Lower bound of the interval.",
          "type": "number",
          "format": "double"
        },
        "hi": {
          "description": "Upper bound of the interval.",
          "type": "number",
          "format": "double"
        },
        "confidence": {
          "description": "Confidence level of the interval (0.95).",
          "type": "number",
          "format": "double"
        },
        "standard_error": {
          "description": "Standard error, when the file gives it.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "point",
        "lo",
        "hi",
        "confidence"
      ]
    },
    "Verdict": {
      "description": "What the change of the mean says.",
      "oneOf": [
        {
          "description": "The whole interval is above +noise: slower.",
          "type": "string",
          "const": "regressed"
        },
        {
          "description": "The whole interval is below −noise: faster.",
          "type": "string",
          "const": "improved"
        },
        {
          "description": "The interval excludes 0 but not the noise band.",
          "type": "string",
          "const": "within_noise"
        },
        {
          "description": "The interval includes 0.",
          "type": "string",
          "const": "no_change"
        },
        {
          "description": "No change file: nothing to judge.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "BenchSpec": {
      "description": "The benchmarks of a criterion directory.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption; the directory when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path of the criterion directory.",
          "type": "string"
        },
        "baseline": {
          "description": "Name of the baseline compared against (`base`, or a\n`--save-baseline` name).",
          "type": "string"
        },
        "noise_threshold": {
          "description": "Noise threshold of the verdicts.",
          "type": "number",
          "format": "double"
        },
        "benches": {
          "description": "Benchmarks, by id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bench"
          }
        },
        "skipped": {
          "description": "Directories that had estimates for neither run, or did not parse.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "baseline",
        "noise_threshold",
        "benches"
      ]
    },
    "WaveFormat": {
      "description": "The dump format.",
      "oneOf": [
        {
          "description": "Value change dump (IEEE 1364).",
          "type": "string",
          "const": "vcd"
        },
        {
          "description": "GTKWave's fast signal trace.",
          "type": "string",
          "const": "fst"
        },
        {
          "description": "GHDL's waveform dump.",
          "type": "string",
          "const": "ghw"
        }
      ]
    },
    "Timescale": {
      "description": "Length of a tick: `factor` × 10^`exponent` seconds.",
      "type": "object",
      "properties": {
        "factor": {
          "description": "1, 10 or 100 in VCD files.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "exponent": {
          "description": "Power of ten of the unit: −9 for ns, −12 for ps.",
          "type": "integer",
          "format": "int8",
          "minimum": -128,
          "maximum": 127
        }
      },
      "required": [
        "factor",
        "exponent"
      ]
    },
    "WaveSignal": {
      "description": "One signal with its changes in time order.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name within its scope, with its bit range (`data[7:0]`).",
          "type": "string"
        },
        "scope": {
          "description": "Dotted path of its scope (`tb.cpu`), empty at the top.",
          "type": "string",
          "default": ""
        },
        "kind": {
          "description": "What it carries.",
          "$ref": "#/$defs/SignalKind"
        },
        "width": {
          "description": "Width in bits (1 for a bit, 0 for real and text).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "changes": {
          "description": "The changes, ascending in time.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/WaveChange"
          },
          "default": []
        },
        "truncated": {
          "description": "Whether later changes were dropped to stay under [`MAX_CHANGES`].",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "width"
      ]
    },
    "SignalKind": {
      "description": "What a signal carries.",
      "oneOf": [
        {
          "description": "One bit.",
          "type": "string",
          "const": "bit"
        },
        {
          "description": "A bus of `width` bits.",
          "type": "string",
          "const": "vector"
        },
        {
          "description": "A real number.",
          "type": "string",
          "const": "real"
        },
        {
          "description": "Text (VHDL enumerations, strings).",
          "type": "string",
          "const": "text"
        },
        {
          "description": "A named event (no value).",
          "type": "string",
          "const": "event"
        }
      ]
    },
    "WaveChange": {
      "description": "One value change.",
      "type": "object",
      "properties": {
        "t": {
          "description": "Time in ticks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "v": {
          "description": "The value: bits (msb first), a real number or text.",
          "type": "string"
        }
      },
      "required": [
        "t",
        "v"
      ]
    },
    "Radix": {
      "description": "How a bus value is written.",
      "oneOf": [
        {
          "description": "Hexadecimal digits (`3f`); a digit with an unknown bit is `x`.",
          "type": "string",
          "const": "hex"
        },
        {
          "description": "The bits as written.",
          "type": "string",
          "const": "bin"
        },
        {
          "description": "Unsigned decimal; unknown when any bit is not 0 or 1.",
          "type": "string",
          "const": "dec"
        }
      ]
    },
    "WaveformSpec": {
      "description": "A waveform block.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title shown above the waves; defaults to the file name.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path of the dump.",
          "type": "string"
        },
        "format": {
          "description": "Its format.",
          "$ref": "#/$defs/WaveFormat"
        },
        "timescale": {
          "description": "Length of one tick.",
          "$ref": "#/$defs/Timescale",
          "default": {
            "factor": 1,
            "exponent": -9
          }
        },
        "start": {
          "description": "First time of the dump, in ticks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "end": {
          "description": "Last time of the dump, in ticks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "signals": {
          "description": "Signals shown, in hierarchy order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/WaveSignal"
          },
          "default": []
        },
        "total_signals": {
          "description": "Signals in the file (before any filter or cap).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "radix": {
          "description": "How buses are written at first.",
          "$ref": "#/$defs/Radix",
          "default": "hex"
        },
        "generator": {
          "description": "Simulator and date from the header, when present.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "format"
      ]
    },
    "NetlistFormat": {
      "description": "Where the netlist came from.",
      "oneOf": [
        {
          "description": "A SPICE deck (`.cir`, `.sp`, `.net` from a simulator).",
          "type": "string",
          "const": "spice"
        },
        {
          "description": "A KiCad netlist export (`.net`, s-expressions).",
          "type": "string",
          "const": "kicad"
        }
      ]
    },
    "Component": {
      "description": "One component (a SPICE element or a KiCad symbol instance).",
      "type": "object",
      "properties": {
        "reference": {
          "description": "Reference designator (`R1`, `Q3`, `XU1`).",
          "type": "string"
        },
        "kind": {
          "description": "What it is (`resistor`, `capacitor`, `mosfet`, `subcircuit`, or a\nKiCad library part such as `Device:R`).",
          "type": "string"
        },
        "value": {
          "description": "Its value (`10k`, `100n`, `DC 5`).",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "SPICE model or subcircuit name; KiCad footprint.",
          "type": [
            "string",
            "null"
          ]
        },
        "pins": {
          "description": "The pins in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PinNet"
          },
          "default": []
        }
      },
      "required": [
        "reference",
        "kind"
      ]
    },
    "PinNet": {
      "description": "One pin of a component and its net.",
      "type": "object",
      "properties": {
        "pin": {
          "description": "Pin number or name (`1`, `C`, `d` for a MOSFET drain).",
          "type": "string"
        },
        "net": {
          "description": "Net name.",
          "type": "string"
        },
        "function": {
          "description": "What the pin does, when the file says (`VCC`, `~`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pin",
        "net"
      ]
    },
    "Subcircuit": {
      "description": "A subcircuit defined in a SPICE deck.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "ports": {
          "description": "Its port nodes in order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elements": {
          "description": "Elements inside it.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "ports",
        "elements"
      ]
    },
    "NetlistSpec": {
      "description": "A netlist block.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title shown above; defaults to the file name or the design.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace path, when read from a file.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "The source format.",
          "$ref": "#/$defs/NetlistFormat"
        },
        "design": {
          "description": "The SPICE title line or the KiCad design source.",
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "description": "The top-level components.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "subcircuits": {
          "description": "Subcircuits defined in the deck (not flattened).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Subcircuit"
          }
        },
        "warnings": {
          "description": "Lines or forms the reader skipped, and why.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "format",
        "components"
      ]
    },
    "MaterialProperty": {
      "description": "One property value.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name (`Young's modulus`, `yield strength`, `density`).",
          "type": "string"
        },
        "symbol": {
          "description": "Symbol (`E`, `σy`, `ρ`).",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "The value as given.",
          "type": "number",
          "format": "double"
        },
        "unit": {
          "description": "Its unit (`GPa`, `MPa`, `kg/m³`, `1/K`).",
          "type": "string",
          "default": ""
        },
        "condition": {
          "description": "Condition or basis (`20 °C`, `minimum`, `typical`, `T6 temper`,\n`A-basis`).",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Where the value comes from: a datasheet, standard, handbook (with\nedition and table), a URL, or `user` for a value the user gave.\nEmpty: unverified.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "MaterialSpec": {
      "description": "A material card.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Material name (`aluminium alloy`, `PEEK`).",
          "type": "string"
        },
        "designation": {
          "description": "Designation or grade (`6061-T6`, `EN AW-6061`, `S355JR`).",
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {
          "description": "Form or condition of the whole card (`plate, 6–12 mm`).",
          "type": [
            "string",
            "null"
          ]
        },
        "properties": {
          "description": "The properties.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialProperty"
          }
        },
        "notes": {
          "description": "Notes shown under the table.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "properties"
      ]
    },
    "CadSolid": {
      "description": "A solid (or an open shell) of the part.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Its name in the file (`MANIFOLD_SOLID_BREP('name', …)`), or\n`solid N` when it has none.",
          "type": "string"
        },
        "product": {
          "description": "The product it belongs to, when the file links it.",
          "type": [
            "string",
            "null"
          ]
        },
        "faces": {
          "description": "Faces of its boundary.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "failed_faces": {
          "description": "Faces the tessellator could not mesh (left out of the view).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "first_triangle": {
          "description": "Index of its first triangle in the mesh.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "triangles": {
          "description": "Its triangles.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "min": {
          "description": "Corners of its box, in file units (all zero without triangles).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "description": "See [`Self::min`].",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "name",
        "faces",
        "first_triangle",
        "triangles",
        "min",
        "max"
      ]
    },
    "CadModelSpec": {
      "description": "A tessellated STEP part.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title shown above the view; defaults to the file name.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The file, relative to the workspace.",
          "type": "string"
        },
        "schema": {
          "description": "The schema of `FILE_SCHEMA` (`AUTOMOTIVE_DESIGN`,\n`CONFIG_CONTROL_DESIGN`, `AP242_…`).",
          "type": [
            "string",
            "null"
          ]
        },
        "application": {
          "description": "The originating system of `FILE_NAME` (the CAD tool).",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "The length unit of the coordinates (`mm`, `m`, `in`), when the file\ndeclares one.",
          "type": [
            "string",
            "null"
          ]
        },
        "products": {
          "description": "Names of the products in the file.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "solids": {
          "description": "The solids, in the order of the mesh.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadSolid"
          }
        },
        "mesh": {
          "description": "Every solid's triangles, in file units, Z up.",
          "$ref": "#/$defs/ModelMesh"
        },
        "tolerance": {
          "description": "Chord tolerance of the tessellation, in file units.",
          "type": "number",
          "format": "double"
        },
        "warnings": {
          "description": "Reader notes (shells that could not be converted, skipped\nplacements).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "path",
        "solids",
        "mesh",
        "tolerance"
      ]
    },
    "Extents": {
      "description": "A box in drawing units.",
      "type": "object",
      "properties": {
        "min": {
          "description": "Lower left.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "max": {
          "description": "Upper right.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "DrawingLayer": {
      "description": "A layer of the drawing.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "color": {
          "description": "ACI color (1–255).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "off": {
          "description": "Turned off in the file (shown off at first).",
          "type": "boolean",
          "default": false
        },
        "entities": {
          "description": "Entities on it.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "name",
        "color"
      ]
    },
    "DrawEntity": {
      "description": "An entity: a shape on a layer with its own color, or the layer's.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Index of its layer in [`DrawingSpec::layers`].",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "color": {
          "description": "ACI color (1–255); `None` takes the layer's.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "layer"
      ],
      "oneOf": [
        {
          "description": "A segment.",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "line"
            },
            "a": {
              "description": "Start.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "b": {
              "description": "End.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "shape",
            "a",
            "b"
          ]
        },
        {
          "description": "A full circle.",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "circle"
            },
            "center": {
              "description": "Centre.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "radius": {
              "description": "Radius.",
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "shape",
            "center",
            "radius"
          ]
        },
        {
          "description": "A counter-clockwise arc from `start` to `end` degrees.",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "arc"
            },
            "center": {
              "description": "Centre.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "radius": {
              "description": "Radius.",
              "type": "number",
              "format": "double"
            },
            "start": {
              "description": "Start angle in degrees.",
              "type": "number",
              "format": "double"
            },
            "end": {
              "description": "End angle in degrees.",
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "shape",
            "center",
            "radius",
            "start",
            "end"
          ]
        },
        {
          "description": "A polyline (LWPOLYLINE, POLYLINE; ellipses and splines as\napproximations).",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "polyline"
            },
            "vertices": {
              "description": "Vertices.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/PolyVertex"
              }
            },
            "closed": {
              "description": "Whether the last vertex joins the first.",
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "shape",
            "vertices"
          ]
        },
        {
          "description": "A single-line or multi-line text.",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "text"
            },
            "at": {
              "description": "Insertion point (lower left of the first line).",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "height": {
              "description": "Character height in drawing units.",
              "type": "number",
              "format": "double"
            },
            "rotation": {
              "description": "Rotation in degrees (the viewer draws text unrotated).",
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "text": {
              "description": "The text, formatting codes removed; lines split by `\\n`.",
              "type": "string"
            }
          },
          "required": [
            "shape",
            "at",
            "height",
            "text"
          ]
        },
        {
          "description": "A point marker.",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "point"
            },
            "at": {
              "description": "Where.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "shape",
            "at"
          ]
        }
      ]
    },
    "PolyVertex": {
      "description": "A polyline vertex: its point and the bulge of the segment that starts\nat it (tan of a quarter of the arc's angle; 0 for a straight segment,\npositive counter-clockwise).",
      "type": "object",
      "properties": {
        "x": {
          "description": "X.",
          "type": "number",
          "format": "double"
        },
        "y": {
          "description": "Y.",
          "type": "number",
          "format": "double"
        },
        "bulge": {
          "description": "Bulge of the segment to the next vertex.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "SkippedKind": {
      "description": "Entities of one kind left out of the view.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The DXF entity name (`HATCH`, `DIMENSION`, …).",
          "type": "string"
        },
        "count": {
          "description": "How many.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "count"
      ]
    },
    "DrawingSpec": {
      "description": "A DXF drawing.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title shown above the view; defaults to the file name.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The file, relative to the workspace.",
          "type": "string"
        },
        "version": {
          "description": "The AutoCAD release of the file (`R2000`, `R2018`).",
          "type": [
            "string",
            "null"
          ]
        },
        "units": {
          "description": "The insertion units of `$INSUNITS` (`mm`, `in`), when set.",
          "type": [
            "string",
            "null"
          ]
        },
        "header_extents": {
          "description": "The extents of `$EXTMIN`/`$EXTMAX`, when the file has valid ones.",
          "anyOf": [
            {
              "$ref": "#/$defs/Extents"
            },
            {
              "type": "null"
            }
          ]
        },
        "layers": {
          "description": "The layers, in table order (layers only entities name come last).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DrawingLayer"
          }
        },
        "entities": {
          "description": "What is drawn.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DrawEntity"
          }
        },
        "inserts": {
          "description": "Block inserts expanded into their entities.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "skipped": {
          "description": "Entities left out, by kind.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkippedKind"
          },
          "default": []
        },
        "truncated": {
          "description": "Whether entities were cut at [`MAX_ENTITIES`].",
          "type": "boolean",
          "default": false
        },
        "warnings": {
          "description": "Reader notes.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "path",
        "layers",
        "entities"
      ]
    },
    "IfcStorey": {
      "description": "A building storey.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "elevation": {
          "description": "Elevation in [`IfcScheduleSpec::length_unit`], when given.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "building": {
          "description": "The building it belongs to.",
          "type": [
            "string",
            "null"
          ]
        },
        "spaces": {
          "description": "Its spaces, in file order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcSpace"
          },
          "default": []
        },
        "elements": {
          "description": "Walls, doors and windows contained in it (or in its spaces).",
          "$ref": "#/$defs/ElementCounts",
          "default": {
            "walls": 0,
            "doors": 0,
            "windows": 0
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "IfcSpace": {
      "description": "A space (room) of a storey.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Its `Name` (often the room number).",
          "type": [
            "string",
            "null"
          ]
        },
        "long_name": {
          "description": "Its `LongName` (often the room's use).",
          "type": [
            "string",
            "null"
          ]
        },
        "area": {
          "description": "Floor area in [`IfcScheduleSpec::area_unit`], when the file gives\none.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "area_source": {
          "description": "Where the area was read (`Qto_SpaceBaseQuantities.NetFloorArea`).",
          "type": [
            "string",
            "null"
          ]
        },
        "global_id": {
          "description": "Its `GlobalId`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ElementCounts": {
      "description": "Building elements counted per storey.",
      "type": "object",
      "properties": {
        "walls": {
          "description": "`IfcWall` and its standard/elemented cases.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "doors": {
          "description": "`IfcDoor` (and `IfcDoorStandardCase`).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "windows": {
          "description": "`IfcWindow` (and `IfcWindowStandardCase`).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "IfcScheduleSpec": {
      "description": "The schedule of an IFC file.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title above the schedule; defaults to the file name.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The file, relative to the workspace.",
          "type": "string"
        },
        "schema": {
          "description": "The schema of the header (`IFC2X3`, `IFC4`, `IFC4X3`).",
          "type": "string"
        },
        "project": {
          "description": "The project's name.",
          "type": [
            "string",
            "null"
          ]
        },
        "site": {
          "description": "The site's name.",
          "type": [
            "string",
            "null"
          ]
        },
        "buildings": {
          "description": "Building names.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "length_unit": {
          "description": "The project's length unit (`m`, `mm`, `ft`).",
          "type": [
            "string",
            "null"
          ]
        },
        "area_unit": {
          "description": "The project's area unit (`m²`, `ft²`).",
          "type": [
            "string",
            "null"
          ]
        },
        "storeys": {
          "description": "The storeys, by elevation (file order when not given).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcStorey"
          }
        },
        "unplaced_spaces": {
          "description": "Spaces in no storey.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcSpace"
          },
          "default": []
        },
        "unplaced": {
          "description": "Walls, doors and windows in no storey.",
          "$ref": "#/$defs/ElementCounts",
          "default": {
            "walls": 0,
            "doors": 0,
            "windows": 0
          }
        },
        "warnings": {
          "description": "Reader notes.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "path",
        "schema",
        "storeys"
      ]
    },
    "SequenceFormat": {
      "description": "The file the sequence came from.",
      "oneOf": [
        {
          "description": "A GenBank flat file.",
          "type": "string",
          "const": "genbank"
        },
        {
          "description": "FASTA.",
          "type": "string",
          "const": "fasta"
        },
        {
          "description": "Bare residues.",
          "type": "string",
          "const": "plain"
        }
      ]
    },
    "Alphabet": {
      "description": "What the residues are.",
      "oneOf": [
        {
          "description": "Nucleotides with T.",
          "type": "string",
          "const": "dna"
        },
        {
          "description": "Nucleotides with U.",
          "type": "string",
          "const": "rna"
        },
        {
          "description": "Amino acids.",
          "type": "string",
          "const": "protein"
        }
      ]
    },
    "Topology": {
      "description": "Linear or circular (a plasmid).",
      "oneOf": [
        {
          "description": "Has two ends.",
          "type": "string",
          "const": "linear"
        },
        {
          "description": "Its end joins its start.",
          "type": "string",
          "const": "circular"
        }
      ]
    },
    "SeqFeature": {
      "description": "An annotated region.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Feature key (`CDS`, `gene`, `promoter`, `rep_origin`).",
          "type": "string"
        },
        "label": {
          "description": "Its name: `/label`, `/gene`, `/product` or `/note`, the first given.",
          "type": [
            "string",
            "null"
          ]
        },
        "segments": {
          "description": "Its parts in reading order (two for one crossing the origin).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeqSpan"
          }
        },
        "strand": {
          "description": "The strand.",
          "$ref": "#/$defs/Strand",
          "default": "forward"
        },
        "qualifiers": {
          "description": "Its qualifiers (capped at [`MAX_QUALIFIERS`]).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Qualifier"
          }
        }
      },
      "required": [
        "kind",
        "segments"
      ]
    },
    "SeqSpan": {
      "description": "A half-open range of residues, `start..end`.",
      "type": "object",
      "properties": {
        "start": {
          "description": "First residue, 0-based.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "end": {
          "description": "One past the last residue.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "Strand": {
      "description": "The strand a feature or hit is on.",
      "oneOf": [
        {
          "description": "The given (top) strand.",
          "type": "string",
          "const": "forward"
        },
        {
          "description": "The complementary strand.",
          "type": "string",
          "const": "reverse"
        },
        {
          "description": "No strand (proteins, unstranded features).",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "Qualifier": {
      "description": "A feature qualifier, `/key=\"value\"`.",
      "type": "object",
      "properties": {
        "key": {
          "description": "Its key (`gene`, `product`, `note`).",
          "type": "string"
        },
        "value": {
          "description": "Its value; empty for a flag such as `/pseudo`.",
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "key"
      ]
    },
    "CutSite": {
      "description": "Where a restriction enzyme cuts.",
      "type": "object",
      "properties": {
        "enzyme": {
          "description": "The enzyme (`EcoRI`).",
          "type": "string"
        },
        "site": {
          "description": "Its recognition sequence on the top strand (`GAATTC`).",
          "type": "string"
        },
        "start": {
          "description": "First residue of the recognition site, 0-based.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "cut": {
          "description": "The top-strand cut, before residue `cut` (0-based, modulo the\nlength on a circular sequence).",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "strand": {
          "description": "The strand the site reads on (non-palindromic sites).",
          "$ref": "#/$defs/Strand",
          "default": "forward"
        }
      },
      "required": [
        "enzyme",
        "site",
        "start",
        "cut"
      ]
    },
    "SequenceSpec": {
      "description": "A DNA, RNA or protein sequence with its features and cut sites.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title shown above the viewer.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The workspace file read, when there is one.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "What it was read from.",
          "$ref": "#/$defs/SequenceFormat",
          "default": "plain"
        },
        "name": {
          "description": "Record name (GenBank LOCUS, FASTA id).",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Description (GenBank DEFINITION, the rest of the FASTA header).",
          "type": [
            "string",
            "null"
          ]
        },
        "accession": {
          "description": "Accession and version, when given.",
          "type": [
            "string",
            "null"
          ]
        },
        "organism": {
          "description": "Organism, when given.",
          "type": [
            "string",
            "null"
          ]
        },
        "alphabet": {
          "description": "The residues.",
          "$ref": "#/$defs/Alphabet"
        },
        "topology": {
          "description": "Linear or circular.",
          "$ref": "#/$defs/Topology",
          "default": "linear"
        },
        "sequence": {
          "description": "The residues, upper case.",
          "type": "string"
        },
        "features": {
          "description": "The annotation.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeqFeature"
          }
        },
        "cut_sites": {
          "description": "Restriction sites of the bundled enzyme table (nucleic acids).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CutSite"
          }
        },
        "enzyme_source": {
          "description": "Where the enzyme table comes from, when sites were searched.",
          "type": [
            "string",
            "null"
          ]
        },
        "records": {
          "description": "Records in the file.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        },
        "record": {
          "description": "The record shown, 0-based.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "warnings": {
          "description": "Reader notes (non-IUPAC characters, features dropped).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "alphabet",
        "sequence"
      ]
    },
    "ReactionComponent": {
      "description": "One molecule of the scheme.",
      "type": "object",
      "properties": {
        "role": {
          "description": "Its side.",
          "$ref": "#/$defs/ReactionRole"
        },
        "molecule": {
          "description": "The molecule (SMILES, depiction, computed formula, mass, charge).",
          "$ref": "#/$defs/MoleculeSpec"
        },
        "coefficient": {
          "description": "Its coefficient as given (1 when none was).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "atoms": {
          "description": "Atom counts of one molecule by element, implicit hydrogens\nincluded.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "default": {}
        }
      },
      "required": [
        "role",
        "molecule"
      ]
    },
    "ReactionRole": {
      "description": "The side of the arrow a molecule is on.",
      "oneOf": [
        {
          "description": "Left of the arrow.",
          "type": "string",
          "const": "reactant"
        },
        {
          "description": "Over the arrow (catalysts, solvents): not counted.",
          "type": "string",
          "const": "agent"
        },
        {
          "description": "Right of the arrow.",
          "type": "string",
          "const": "product"
        }
      ]
    },
    "ElementBalance": {
      "description": "One element's count on each side, with the coefficients given.",
      "type": "object",
      "properties": {
        "element": {
          "description": "Element symbol.",
          "type": "string"
        },
        "reactants": {
          "description": "Atoms on the left.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "products": {
          "description": "Atoms on the right.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "element",
        "reactants",
        "products"
      ]
    },
    "Stoichiometry": {
      "description": "What the coefficient search found.",
      "oneOf": [
        {
          "description": "The given coefficients balance.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "balanced"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "These smallest integer coefficients (reactants then products, in\norder) balance it.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "suggested"
            },
            "coefficients": {
              "description": "One per counted molecule.",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            }
          },
          "required": [
            "kind",
            "coefficients"
          ]
        },
        {
          "description": "No positive coefficients balance these molecules: something is\nmissing (a by-product, a counter-ion) or a structure is wrong.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "impossible"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "More than one independent set of coefficients balances it (two\nreactions in one); none is suggested.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ambiguous"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "The search was not run (a molecule did not parse).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not_checked"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ReactionSpec": {
      "description": "A reaction drawn from reaction SMILES with its balance.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title.",
          "type": [
            "string",
            "null"
          ]
        },
        "smiles": {
          "description": "Reaction SMILES as given (`A.B>agent>C.D`).",
          "type": "string"
        },
        "conditions": {
          "description": "Conditions written over the arrow (`Δ, 2 h`).",
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "description": "The molecules, reactants then agents then products.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReactionComponent"
          }
        },
        "elements": {
          "description": "Element counts per side with the given coefficients (implicit H\nincluded), by symbol.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ElementBalance"
          },
          "default": []
        },
        "charge": {
          "description": "Net charge on the left and on the right.",
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "format": "int64"
            },
            {
              "type": "integer",
              "format": "int64"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0,
            0
          ]
        },
        "stoichiometry": {
          "description": "The coefficient search.",
          "$ref": "#/$defs/Stoichiometry"
        },
        "balance": {
          "description": "The balance check as a computed envelope (values `balanced`,\n`charge_delta`, `delta.<element>`, `suggested.<n>`).",
          "$ref": "#/$defs/Computed"
        },
        "error": {
          "description": "Why the reaction could not be read, when it could not.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "smiles",
        "components",
        "stoichiometry",
        "balance"
      ]
    },
    "ActivityDirection": {
      "description": "Whether a higher activity value is better (potency in %, pIC50) or a\nlower one (IC50, Ki).",
      "oneOf": [
        {
          "description": "Higher is better.",
          "type": "string",
          "const": "higher"
        },
        {
          "description": "Lower is better.",
          "type": "string",
          "const": "lower"
        }
      ]
    },
    "GridMolecule": {
      "description": "One molecule of the grid.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Its id (compound number), unique in the grid.",
          "type": "string"
        },
        "molecule": {
          "description": "The structure, depicted (or the parse error).",
          "$ref": "#/$defs/MoleculeSpec"
        },
        "activity": {
          "description": "The measured activity, as given.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "descriptors": {
          "description": "Descriptors, when the SMILES parsed.",
          "anyOf": [
            {
              "$ref": "#/$defs/Descriptors"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "molecule"
      ]
    },
    "Descriptors": {
      "description": "Descriptors computed from a structure.",
      "type": "object",
      "properties": {
        "mw": {
          "description": "Average molecular weight, g/mol.",
          "type": "number",
          "format": "double"
        },
        "heavy_atoms": {
          "description": "Heavy (non-hydrogen) atoms.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hbd": {
          "description": "Hydrogen-bond donors.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hba": {
          "description": "Hydrogen-bond acceptors.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rotatable_bonds": {
          "description": "Rotatable bonds.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rings": {
          "description": "Rings (SSSR size).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "aromatic_rings": {
          "description": "Aromatic rings.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "logp": {
          "description": "Crippen logP (Wildman & Crippen 1999).",
          "type": "number",
          "format": "double"
        },
        "tpsa": {
          "description": "Topological polar surface area, Å² (Ertl 2000, N, O, S and P).",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "mw",
        "heavy_atoms",
        "hbd",
        "hba",
        "rotatable_bonds",
        "rings",
        "aromatic_rings",
        "logp",
        "tpsa"
      ]
    },
    "MoleculeGridSpec": {
      "description": "A grid of molecules with descriptors and activities.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title.",
          "type": [
            "string",
            "null"
          ]
        },
        "activity_label": {
          "description": "What the activity is (`IC50`, `% inhibition at 10 µM`).",
          "type": [
            "string",
            "null"
          ]
        },
        "activity_unit": {
          "description": "Its unit (`nM`).",
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "description": "Which way is better, for the colours.",
          "$ref": "#/$defs/ActivityDirection",
          "default": "higher"
        },
        "molecules": {
          "description": "The molecules in the order given.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GridMolecule"
          }
        },
        "descriptors": {
          "description": "The descriptors as an envelope (values `<id>.<descriptor>`).",
          "$ref": "#/$defs/Computed"
        }
      },
      "required": [
        "molecules",
        "descriptors"
      ]
    },
    "SpectrumFormat": {
      "description": "The file format read.",
      "oneOf": [
        {
          "description": "JCAMP-DX 4.24 / 5.01.",
          "type": "string",
          "const": "jcamp"
        },
        {
          "description": "mzML (HUPO-PSI).",
          "type": "string",
          "const": "mzml"
        },
        {
          "description": "Mascot generic format.",
          "type": "string",
          "const": "mgf"
        }
      ]
    },
    "SpectrumKind": {
      "description": "What was measured.",
      "oneOf": [
        {
          "description": "Infrared (wavenumber, right to left).",
          "type": "string",
          "const": "infrared"
        },
        {
          "description": "Raman (shift, left to right).",
          "type": "string",
          "const": "raman"
        },
        {
          "description": "UV-visible (wavelength).",
          "type": "string",
          "const": "uv_vis"
        },
        {
          "description": "NMR (chemical shift, right to left).",
          "type": "string",
          "const": "nmr"
        },
        {
          "description": "Mass spectrum (m/z).",
          "type": "string",
          "const": "mass"
        },
        {
          "description": "Anything else.",
          "type": "string",
          "const": "other"
        }
      ]
    },
    "Peak": {
      "description": "A picked peak.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Position on the x axis.",
          "type": "number",
          "format": "double"
        },
        "y": {
          "description": "Height (or depth) as read.",
          "type": "number",
          "format": "double"
        },
        "prominence": {
          "description": "Prominence above (below) the surrounding baseline, in y units;\n`None` for a listed stick.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "PeakSense": {
      "description": "Whether peaks are maxima (absorbance, counts) or minima (IR\ntransmittance).",
      "oneOf": [
        {
          "description": "Peaks point up.",
          "type": "string",
          "const": "maxima"
        },
        {
          "description": "Peaks point down.",
          "type": "string",
          "const": "minima"
        }
      ]
    },
    "SpectrumSpec": {
      "description": "A spectrum with its peaks.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title shown above the plot.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The workspace file read.",
          "type": "string"
        },
        "format": {
          "description": "Its format.",
          "$ref": "#/$defs/SpectrumFormat"
        },
        "kind": {
          "description": "What was measured.",
          "$ref": "#/$defs/SpectrumKind"
        },
        "name": {
          "description": "The block's or scan's own title or id.",
          "type": [
            "string",
            "null"
          ]
        },
        "x_label": {
          "description": "x axis label with its unit (`wavenumber (cm⁻¹)`, `δ (ppm)`, `m/z`).",
          "type": "string"
        },
        "y_label": {
          "description": "y axis label with its unit (`transmittance`, `intensity`).",
          "type": "string"
        },
        "x_reversed": {
          "description": "Whether x runs right to left (IR wavenumber, NMR shift).",
          "type": "boolean",
          "default": false
        },
        "x": {
          "description": "The points, in file order.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "y": {
          "description": "One y per x.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sticks": {
          "description": "Whether the points are sticks (centroided MS, a peak table)\nrather than a continuous trace.",
          "type": "boolean",
          "default": false
        },
        "peaks": {
          "description": "The peaks picked by the engine (or the file's sticks, strongest\nfirst), at most [`MAX_PEAKS`].",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Peak"
          },
          "default": []
        },
        "sense": {
          "description": "Which way peaks point.",
          "$ref": "#/$defs/PeakSense",
          "default": "maxima"
        },
        "picking": {
          "description": "The peak picking as an envelope.",
          "$ref": "#/$defs/Computed"
        },
        "metadata": {
          "description": "Header values worth showing (origin, owner, molecular formula,\nnucleus, frequency, precursor).",
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "blocks": {
          "description": "Data blocks or scans in the file.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        },
        "block": {
          "description": "The block or scan shown, 0-based.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "warnings": {
          "description": "Reader notes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "format",
        "kind",
        "x_label",
        "y_label",
        "x",
        "y",
        "picking"
      ]
    },
    "CoordinateSource": {
      "description": "Where the coordinates come from.",
      "oneOf": [
        {
          "description": "Read from a structure file.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "format": {
              "description": "Its format.",
              "$ref": "#/$defs/StructureFormat"
            }
          },
          "required": [
            "kind",
            "format"
          ]
        },
        {
          "description": "Embedded from SMILES by the engine (a computed conformer, not an\nexperimental structure).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "embedded"
            },
            "method": {
              "description": "The method, e.g. `distance geometry + DREIDING (chematic 1.2.1)`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "method"
          ]
        }
      ]
    },
    "StructureFormat": {
      "description": "The file the coordinates come from.",
      "oneOf": [
        {
          "description": "MDL molfile (V2000 or V3000).",
          "type": "string",
          "const": "mol"
        },
        {
          "description": "SD file (its first record).",
          "type": "string",
          "const": "sdf"
        },
        {
          "description": "XYZ.",
          "type": "string",
          "const": "xyz"
        },
        {
          "description": "Protein Data Bank.",
          "type": "string",
          "const": "pdb"
        }
      ]
    },
    "Atom3d": {
      "description": "An atom with its position in Å.",
      "type": "object",
      "properties": {
        "element": {
          "description": "Element symbol (`C`, `Cl`).",
          "type": "string"
        },
        "position": {
          "description": "Position, Å.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "name": {
          "description": "Atom name from the file (PDB `CA`), when given.",
          "type": [
            "string",
            "null"
          ]
        },
        "residue": {
          "description": "Residue (`ALA 12 A`), for PDB atoms.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "element",
        "position"
      ]
    },
    "Bond3d": {
      "description": "A bond between two atoms (indices into the atoms).",
      "type": "object",
      "properties": {
        "a": {
          "description": "First atom.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "b": {
          "description": "Second atom.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "order": {
          "description": "1, 2 or 3; 4 for aromatic.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "a",
        "b",
        "order"
      ]
    },
    "Molecule3dSpec": {
      "description": "A molecule in 3D.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title shown above the view.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Name of the molecule (the file's title line, or the call's).",
          "type": [
            "string",
            "null"
          ]
        },
        "smiles": {
          "description": "The SMILES embedded, when it came from one.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The workspace file read, when there is one.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Where the coordinates come from.",
          "$ref": "#/$defs/CoordinateSource"
        },
        "atoms": {
          "description": "The atoms.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Atom3d"
          }
        },
        "bonds": {
          "description": "The bonds.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bond3d"
          },
          "default": []
        },
        "bonds_inferred": {
          "description": "Whether the bonds were inferred from distances (XYZ, PDB).",
          "type": "boolean",
          "default": false
        },
        "warnings": {
          "description": "Reader notes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source",
        "atoms"
      ]
    },
    "GhsClassification": {
      "description": "One source's classification.",
      "type": "object",
      "properties": {
        "source": {
          "description": "The source (`European Chemicals Agency (ECHA)`).",
          "type": "string"
        },
        "substance": {
          "description": "What the source calls the substance.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "The source's page.",
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "description": "The source's licence note.",
          "type": [
            "string",
            "null"
          ]
        },
        "pictograms": {
          "description": "Pictograms.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pictogram"
          },
          "default": []
        },
        "signal": {
          "description": "`Danger` or `Warning`.",
          "type": [
            "string",
            "null"
          ]
        },
        "hazards": {
          "description": "Hazard statements.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HazardStatement"
          },
          "default": []
        },
        "precautionary": {
          "description": "Precautionary statement codes (`P210`, `P305+P351+P338`); PubChem\ngives the codes, not their texts.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "notes": {
          "description": "The source's notes (share of non-classified reports).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "source"
      ]
    },
    "Pictogram": {
      "description": "A pictogram of a classification.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`GHS01` … `GHS09`.",
          "type": "string"
        },
        "label": {
          "description": "The hazard it stands for, as the source labels it (`Flammable`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code"
      ]
    },
    "HazardStatement": {
      "description": "A hazard statement.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`H225`, `EUH066`.",
          "type": "string"
        },
        "text": {
          "description": "Its text as given, with the class in brackets when the source\nadds it.",
          "type": "string"
        },
        "share": {
          "description": "The share of notifications that report it (`> 99.9%`), for\naggregated sources.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "text"
      ]
    },
    "GhsSpec": {
      "description": "A GHS card.",
      "type": "object",
      "properties": {
        "query": {
          "description": "What was looked up (name, CAS number or CID).",
          "type": "string"
        },
        "cid": {
          "description": "PubChem's compound id, when the compound was found.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "description": "PubChem's name of the compound.",
          "type": [
            "string",
            "null"
          ]
        },
        "classifications": {
          "description": "The classifications, one per source.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GhsClassification"
          },
          "default": []
        },
        "source_url": {
          "description": "The PubChem page to check (the compound's GHS section).",
          "type": "string"
        },
        "fetched_url": {
          "description": "The URL fetched.",
          "type": "string"
        },
        "retrieved": {
          "description": "When it was fetched (UTC date, `YYYY-MM-DD`).",
          "type": "string"
        },
        "message": {
          "description": "Why there is nothing to show (not found, no classification).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query",
        "source_url",
        "fetched_url",
        "retrieved"
      ]
    },
    "MapCrs": {
      "description": "The coordinate reference system of the file.",
      "type": "object",
      "properties": {
        "epsg": {
          "description": "EPSG code, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "Name to show (`WGS 84`, `WGS 84 / UTM zone 32N`, or the proj\nstring given).",
          "type": "string"
        },
        "source": {
          "description": "Where it came from.",
          "$ref": "#/$defs/CrsSource",
          "default": "default"
        },
        "definition": {
          "description": "The PROJ definition used to reproject it.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "definition"
      ]
    },
    "CrsSource": {
      "description": "Where the coordinate reference system came from.",
      "oneOf": [
        {
          "description": "None was named: WGS 84 longitude/latitude, as RFC 7946 requires.",
          "type": "string",
          "const": "default"
        },
        {
          "description": "The file's legacy (2008) `crs` member.",
          "type": "string",
          "const": "member"
        },
        {
          "description": "The caller gave it.",
          "type": "string",
          "const": "given"
        }
      ]
    },
    "MapFeature": {
      "description": "One feature, in display coordinates, with what the engine measured.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The feature's `id`, as text.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Its geometry type.",
          "$ref": "#/$defs/GeometryKind"
        },
        "points": {
          "description": "Points (Web Mercator).",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "lines": {
          "description": "Lines, each a vertex list.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "polygons": {
          "description": "Polygons, each a list of closed rings: the exterior, then holes.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "properties": {
          "description": "The feature's properties as written.",
          "type": "object",
          "additionalProperties": true
        },
        "bbox": {
          "description": "Box in degrees: west, south, east, north (WGS 84).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "area_m2": {
          "description": "Geodesic area of its polygons, holes taken out, in m².",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "length_m": {
          "description": "Geodesic length of its lines, in m.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "perimeter_m": {
          "description": "Geodesic perimeter of its polygons (holes included), in m.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "kind"
      ]
    },
    "GeometryKind": {
      "description": "The GeoJSON geometry type of a feature.",
      "oneOf": [
        {
          "description": "`Point`.",
          "type": "string",
          "const": "point"
        },
        {
          "description": "`MultiPoint`.",
          "type": "string",
          "const": "multi_point"
        },
        {
          "description": "`LineString`.",
          "type": "string",
          "const": "line_string"
        },
        {
          "description": "`MultiLineString`.",
          "type": "string",
          "const": "multi_line_string"
        },
        {
          "description": "`Polygon`.",
          "type": "string",
          "const": "polygon"
        },
        {
          "description": "`MultiPolygon`.",
          "type": "string",
          "const": "multi_polygon"
        },
        {
          "description": "`GeometryCollection`.",
          "type": "string",
          "const": "geometry_collection"
        }
      ]
    },
    "MapSpec": {
      "description": "A map of features.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title shown above the map.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The workspace file read, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "crs": {
          "description": "Coordinate reference system of the source.",
          "$ref": "#/$defs/MapCrs"
        },
        "features": {
          "description": "The features with geometry, in file order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapFeature"
          }
        },
        "total_features": {
          "description": "Features in the file (more than `features` when capped or some had\nno geometry).",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "without_geometry": {
          "description": "Features without geometry, not drawn.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        },
        "color_by": {
          "description": "The property to colour by at first.",
          "type": [
            "string",
            "null"
          ]
        },
        "measures": {
          "description": "The measures (box, area, length) as an envelope.",
          "$ref": "#/$defs/Computed"
        },
        "warnings": {
          "description": "Reader notes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "crs",
        "features",
        "total_features",
        "measures"
      ]
    }
  }
}
