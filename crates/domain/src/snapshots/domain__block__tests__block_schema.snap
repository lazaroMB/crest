        "std_beta": {
          "description": "Standardised coefficient.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "vif": {
          "description": "Variance inflation factor (not for the intercept).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "term",
        "estimate",
        "se",
        "t",
        "p",
        "ci_lo",
        "ci_hi"
      ]
    },
    "FitStats": {
      "description": "Goodness of fit of a regression.",
      "type": "object",
      "properties": {
        "n": {
          "description": "Observations used.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "r_squared": {
          "description": "R².",
          "type": "number",
          "format": "double"
        },
        "adj_r_squared": {
          "description": "Adjusted R².",
          "type": "number",
          "format": "double"
        },
        "f": {
          "description": "F statistic of the overall test.",
          "type": "number",
          "format": "double"
        },
        "df_model": {
          "description": "Model degrees of freedom.",
          "type": "number",
          "format": "double"
        },
        "df_resid": {
          "description": "Residual degrees of freedom.",
          "type": "number",
          "format": "double"
        },
        "f_p": {
          "description": "p-value of the F test.",
          "type": "number",
          "format": "double"
        },
        "sigma": {
          "description": "Residual standard error.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "aic": {
          "description": "Akaike information criterion.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "bic": {
          "description": "Bayesian information criterion.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "n",
        "r_squared",
        "adj_r_squared",
        "f",
        "df_model",
        "df_resid",
        "f_p"
      ]
    },
