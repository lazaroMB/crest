        },
        "estimate": {
          "description": "Estimate.",
          "type": "number",
          "format": "double"
        },
        "se": {
          "description": "Standard error.",
          "type": "number",
          "format": "double"
        },
        "t": {
          "description": "t statistic.",
          "type": "number",
          "format": "double"
        },
        "p": {
          "description": "Two-sided p-value.",
          "type": "number",
          "format": "double"
        },
        "ci_lo": {
          "description": "Lower interval bound.",
          "type": "number",
          "format": "double"
        },
        "ci_hi": {
          "description": "Upper interval bound.",
          "type": "number",
          "format": "double"
