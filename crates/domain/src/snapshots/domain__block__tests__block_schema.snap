    "CorrelationMethod": {
      "description": "Correlation coefficient.",
      "oneOf": [
        {
          "description": "Pearson's r.",
          "type": "string",
          "const": "pearson"
        },
        {
          "description": "Spearman's ρ.",
          "type": "string",
          "const": "spearman"
        },
        {
          "description": "Kendall's τ-b.",
          "type": "string",
          "const": "kendall"
        }
      ]
    },
    "PAdjust": {
      "description": "Multiple-comparison adjustment of p-values.",
      "oneOf": [
        {
          "description": "Raw p-values.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "Holm step-down.",
          "type": "string",
          "const": "holm"
        },
        {
          "description": "Benjamini-Hochberg false discovery rate.",
          "type": "string",
          "const": "bh"
        },
        {
          "description": "Bonferroni.",
          "type": "string",
          "const": "bonferroni"
        }
      ]
    },
    "CorrelationBody": {
      "description": "Body of a correlation matrix. `r`, `p` and `n` are square, one row and\ncolumn per variable; a `None` cell could not be computed.",
      "type": "object",
      "properties": {
        "method": {
          "description": "Coefficient.",
          "$ref": "#/$defs/CorrelationMethod"
        },
        "adjustment": {
          "description": "Multiple-comparison adjustment applied to `p`.",
          "$ref": "#/$defs/PAdjust",
          "default": "none"
        },
        "variables": {
          "description": "Variable names, the matrix order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "r": {
          "description": "Coefficients.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          }
        },
        "p": {
          "description": "Adjusted p-values; the diagonal is `None`.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          }
        },
        "n": {
          "description": "Pairwise complete observations.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "method",
        "variables",
        "r",
        "p",
        "n"
      ]
    },
    "CalcLine": {
      "description": "One line of a calc sheet, `name = expr`.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name later lines use; `None` for a bare expression.",
          "type": [
            "string",
            "null"
          ]
        },
        "expr": {
          "description": "Expression as written.",
          "type": "string"
        },
        "value": {
          "description": "Numeric value in `unit`; `None` on error or for non-numeric results.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "display": {
          "description": "The engine's rendering of the result, e.g. `9.81 m/s²`.",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "Unit of `value`.",
          "type": [
            "string",
            "null"
          ]
        },
        "latex": {
          "description": "LaTeX of the line, when the engine can produce it.",
          "type": [
            "string",
            "null"
          ]
        },
        "dimension": {
          "description": "Physical dimension of the result, e.g. `Length` or `Energy`;\n`None` for a plain number.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "Evaluation error, e.g. a dimension mismatch.",
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "description": "How the engine read an ambiguous name, e.g. `ton read as the metric\ntonne (1000 kg)`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "expr"
      ]
    },
    "CalcSheetBody": {
      "description": "Body of a calc sheet: lines evaluated in order.",
      "type": "object",
      "properties": {
        "lines": {
          "description": "Lines, in evaluation order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CalcLine"
          }
        }
      },
      "required": [
        "lines"
      ]
    },
    "Quantity": {
      "description": "A value with a unit.",
      "type": "object",
      "properties": {
        "value": {
          "description": "Magnitude.",
          "type": "number",
          "format": "double"
        },
        "unit": {
          "description": "Unit, e.g. `km/h`.",
          "type": "string"
        },
        "uncertainty": {
          "description": "Standard uncertainty of `value`, in `unit`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "value",
        "unit"
      ]
    },
    "ConversionStep": {
      "description": "One step of a conversion chain.",
      "type": "object",
      "properties": {
        "from_unit": {
          "description": "Unit converted from.",
          "type": "string"
        },
        "to_unit": {
          "description": "Unit converted to.",
          "type": "string"
        },
        "factor": {
          "description": "Multiplier of this step.",
          "type": "number",
          "format": "double"
        },
        "note": {
          "description": "E.g. `exact by definition (1959)`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from_unit",
        "to_unit",
        "factor"
      ]
    },
    "QuantityBody": {
      "description": "Body of a unit conversion.",
      "type": "object",
      "properties": {
        "from": {
          "description": "What was converted.",
          "$ref": "#/$defs/Quantity"
        },
        "to": {
          "description": "The result.",
          "$ref": "#/$defs/Quantity"
        },
        "factor": {
          "description": "Multiplier from `from.unit` to `to.unit` (for affine units like °C,\nthe slope).",
          "type": "number",
          "format": "double"
        },
        "exact": {
          "description": "Whether the factor is exact by definition (inch → mm) rather than\nrounded.",
          "type": "boolean"
        },
        "dimension": {
          "description": "Physical dimension, e.g. `length`, `energy / time`.",
          "type": "string"
        },
        "chain": {
          "description": "Steps through base units, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConversionStep"
          },
          "default": []
        }
      },
      "required": [
        "from",
        "to",
        "factor",
        "exact",
        "dimension"
      ]
    },
    "BinRule": {
      "description": "How the histogram bins were chosen.",
      "oneOf": [
        {
          "description": "Freedman-Diaconis: width 2·IQR·n^(−1/3) (Sturges when the IQR is 0).",
          "type": "string",
          "const": "freedman_diaconis"
        },
        {
          "description": "Sturges: ⌈log₂ n⌉ + 1 bins.",
          "type": "string",
          "const": "sturges"
        },
        {
          "description": "Scott: width 3.49·SD·n^(−1/3).",
          "type": "string",
          "const": "scott"
        },
        {
          "description": "A bin count given in the request.",
          "type": "string",
          "const": "fixed"
        }
      ]
    },
    "BandwidthRule": {
      "description": "How the kernel bandwidth was chosen.",
      "oneOf": [
        {
          "description": "Silverman's rule of thumb, 0.9·min(SD, IQR/1.34)·n^(−1/5) (R's\n`bw.nrd0`).",
          "type": "string",
          "const": "silverman"
        },
        {
          "description": "Scott's rule, 1.06·min(SD, IQR/1.34)·n^(−1/5) (R's `bw.nrd`).",
          "type": "string",
          "const": "scott"
        },
        {
          "description": "A bandwidth given in the request.",
          "type": "string",
          "const": "fixed"
        }
      ]
    },
    "DistributionGroup": {
      "description": "The distribution of one group.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Group value; `None` without `by`.",
          "type": [
            "string",
            "null"
          ]
        },
        "n": {
          "description": "Non-missing values.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "histogram": {
          "description": "Binned counts.",
          "$ref": "#/$defs/Histogram"
        },
        "kde": {
          "description": "Gaussian kernel density estimate.",
          "$ref": "#/$defs/Curve"
        },
        "bandwidth": {
          "description": "Kernel bandwidth.",
          "type": "number",
          "format": "double"
        },
        "boxplot": {
          "description": "Box-plot summary.",
          "$ref": "#/$defs/BoxSummary"
        },
        "qq": {
          "description": "Normal QQ points, in ascending order of the sample.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/QqPoint"
          },
          "default": []
        },
        "ecdf": {
          "description": "Steps of the empirical CDF: at `x` it rises to `p`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EcdfStep"
          },
          "default": []
        },
        "dkw_epsilon": {
          "description": "Half-width of the Dvoretzky-Kiefer-Wolfowitz band around the ECDF.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "n",
        "histogram",
        "kde",
        "bandwidth",
        "boxplot",
        "dkw_epsilon"
      ]
    },
    "Curve": {
      "description": "A curve as matching x and y coordinates.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Abscissas, ascending.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "y": {
          "description": "Ordinates, one per abscissa.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "BoxSummary": {
      "description": "The five numbers of a Tukey box plot (as R's `boxplot.stats`), plus\nthe points outside.",
      "type": "object",
      "properties": {
        "lower_hinge": {
          "description": "Lower hinge (Tukey's, as `fivenum`).",
          "type": "number",
          "format": "double"
        },
        "median": {
          "description": "Median.",
          "type": "number",
          "format": "double"
        },
        "upper_hinge": {
          "description": "Upper hinge.",
          "type": "number",
          "format": "double"
        },
        "whisker_lo": {
          "description": "Smallest value within 1.5 hinge spreads below the lower hinge.",
          "type": "number",
          "format": "double"
        },
        "whisker_hi": {
          "description": "Largest value within 1.5 hinge spreads above the upper hinge.",
          "type": "number",
          "format": "double"
        },
        "outliers": {
          "description": "Values beyond the whiskers, ascending.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        }
      },
      "required": [
        "lower_hinge",
        "median",
        "upper_hinge",
        "whisker_lo",
        "whisker_hi"
      ]
    },
    "QqPoint": {
      "description": "One point of a normal QQ plot with its pointwise band.",
      "type": "object",
      "properties": {
        "theoretical": {
          "description": "Standard normal quantile of the plotting position.",
          "type": "number",
          "format": "double"
        },
        "sample": {
          "description": "The sample value (an order statistic).",
          "type": "number",
          "format": "double"
        },
        "lo": {
          "description": "Lower band bound for this order statistic under the fitted normal.",
          "type": "number",
          "format": "double"
        },
        "hi": {
          "description": "Upper band bound.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "theoretical",
        "sample",
        "lo",
        "hi"
      ]
    },
    "EcdfStep": {
      "description": "One step of an empirical CDF.",
      "type": "object",
      "properties": {
        "x": {
          "description": "A distinct sample value.",
          "type": "number",
          "format": "double"
        },
        "p": {
          "description": "Share of values ≤ `x`.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "p"
      ]
    },
    "DistributionBody": {
      "description": "Body of a distribution card.",
      "type": "object",
      "properties": {
        "variable": {
          "description": "The variable described.",
          "type": "string"
        },
        "unit": {
          "description": "Its unit.",
          "type": [
            "string",
            "null"
          ]
        },
        "by": {
          "description": "Grouping column, when split by group.",
          "type": [
            "string",
            "null"
          ]
        },
        "bin_rule": {
          "description": "How the bins were chosen.",
          "$ref": "#/$defs/BinRule"
        },
        "bin_width": {
          "description": "Width of every bin.",
          "type": "number",
          "format": "double"
        },
        "bandwidth_rule": {
          "description": "How the kernel bandwidths were chosen.",
          "$ref": "#/$defs/BandwidthRule"
        },
        "conf_level": {
          "description": "Coverage of the QQ and ECDF bands, e.g. `0.95`.",
          "type": "number",
          "format": "double"
        },
        "groups": {
          "description": "One entry per group (one in all when there is no `by`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DistributionGroup"
          }
        }
      },
      "required": [
        "variable",
        "bin_rule",
        "bin_width",
        "bandwidth_rule",
        "conf_level",
        "groups"
      ]
    },
    "ContingencyTest": {
      "description": "The test of independence the engine ran.",
      "oneOf": [
        {
          "description": "Pearson's χ² (with Yates' correction on a 2×2 table when asked).",
          "type": "string",
          "const": "chi_square"
        },
        {
          "description": "Fisher's exact test, by full enumeration of the tables with the\nobserved margins.",
          "type": "string",
          "const": "fisher_exact"
        },
        {
          "description": "Fisher's test with a Monte Carlo p-value (too many tables to\nenumerate), as R's `simulate.p.value`.",
          "type": "string",
          "const": "fisher_simulated"
        }
      ]
    },
    "ContingencyBody": {
      "description": "Body of a contingency-table card. Every matrix is rows × columns in the\norder of the level lists.",
      "type": "object",
      "properties": {
        "row_variable": {
          "description": "Row variable, when built from data.",
          "type": [
            "string",
            "null"
          ]
        },
        "column_variable": {
          "description": "Column variable, when built from data.",
          "type": [
            "string",
            "null"
          ]
        },
        "row_levels": {
          "description": "Row labels.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "column_levels": {
          "description": "Column labels.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed": {
          "description": "Observed counts.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "expected": {
          "description": "Expected counts under independence.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "row_percent": {
          "description": "Each cell as a percentage of its row, 0–100.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "column_percent": {
          "description": "Each cell as a percentage of its column, 0–100.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "std_residuals": {
          "description": "Adjusted standardised residuals (R's `stdres`): about N(0, 1)\nunder independence, so |r| > 2 marks a cell that departs from it.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "test": {
          "description": "The test that produced the p-value.",
          "$ref": "#/$defs/ContingencyTest"
        }
      },
      "required": [
        "row_levels",
        "column_levels",
        "observed",
        "expected",
        "row_percent",
        "column_percent",
        "std_residuals",
        "test"
      ]
    },
    "PowerTest": {
      "description": "The design a power analysis is for.",
      "oneOf": [
        {
          "description": "Two-sample t-test, equal groups; effect Cohen's d.",
          "type": "string",
          "const": "two_sample_t"
        },
        {
          "description": "One-sample t-test; effect Cohen's d.",
          "type": "string",
          "const": "one_sample_t"
        },
        {
          "description": "Paired t-test; effect d of the differences.",
          "type": "string",
          "const": "paired_t"
        },
        {
          "description": "One-way ANOVA with `groups` equal groups; effect Cohen's f.",
          "type": "string",
          "const": "anova"
        },
        {
          "description": "Two proportions, equal groups; effect Cohen's h.",
          "type": "string",
          "const": "two_proportions"
        },
        {
          "description": "One proportion against a null value; effect Cohen's h.",
          "type": "string",
          "const": "one_proportion"
        }
      ]
    },
    "PowerTarget": {
      "description": "The quantity a power analysis solved for.",
      "oneOf": [
        {
          "description": "Sample size (per group where the design has groups).",
          "type": "string",
          "const": "n"
        },
        {
          "description": "Power, 1 − β.",
          "type": "string",
          "const": "power"
        },
        {
          "description": "The smallest effect detectable.",
          "type": "string",
          "const": "effect"
        },
        {
          "description": "Significance level.",
          "type": "string",
          "const": "alpha"
        }
      ]
    },
    "PowerBody": {
      "description": "Body of a power card.",
      "type": "object",
      "properties": {
        "test": {
          "description": "The design.",
          "$ref": "#/$defs/PowerTest"
        },
        "solved_for": {
          "description": "What was solved for; the other three were given.",
          "$ref": "#/$defs/PowerTarget"
        },
        "alternative": {
          "description": "Direction of the alternative.",
          "$ref": "#/$defs/Alternative"
        },
        "n": {
          "description": "Sample size (per group when [`PowerTest::n_per_group`]), unrounded.",
          "type": "number",
          "format": "double"
        },
        "effect": {
          "description": "Effect size (`d`, `f` or `h`).",
          "type": "number",
          "format": "double"
        },
        "alpha": {
          "description": "Significance level.",
          "type": "number",
          "format": "double"
        },
        "power": {
          "description": "Power, 1 − β.",
          "type": "number",
          "format": "double"
        },
        "groups": {
          "description": "Number of groups (ANOVA).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "curve": {
          "description": "Power (y) against n (x) at the effect and α above.",
          "$ref": "#/$defs/Curve"
        }
      },
      "required": [
        "test",
        "solved_for",
        "alternative",
        "n",
        "effect",
        "alpha",
        "power",
        "curve"
      ]
    },
    "AbArm": {
      "description": "One arm of an A/B test.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Arm name, e.g. `A`.",
          "type": "string"
        },
        "visitors": {
          "description": "Units exposed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "conversions": {
          "description": "Units that converted.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rate": {
          "description": "Conversion rate, a fraction.",
          "type": "number",
          "format": "double"
        },
        "rate_lo": {
          "description": "Wilson interval of the rate: lower bound.",
          "type": "number",
          "format": "double"
        },
        "rate_hi": {
          "description": "Wilson interval of the rate: upper bound.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "name",
        "visitors",
        "conversions",
        "rate",
        "rate_lo",
        "rate_hi"
      ]
    },
    "AbMethod": {
      "description": "The test behind an A/B card's p-value.",
      "oneOf": [
        {
          "description": "Two-proportion z-test with the pooled rate (R's `prop.test(...,\ncorrect = FALSE)`).",
          "type": "string",
          "const": "z_test"
        },
        {
          "description": "Fisher's exact test, for small counts.",
          "type": "string",
          "const": "fisher_exact"
        }
      ]
    },
    "AbTestBody": {
      "description": "Body of an A/B test card.",
      "type": "object",
      "properties": {
        "arms": {
          "description": "Control first, then treatment.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AbArm"
          }
        },
        "expected_split": {
          "description": "The share of visitors meant for the treatment, e.g. 0.5.",
          "type": "number",
          "format": "double"
        },
        "conf_level": {
          "description": "Level of the intervals.",
          "type": "number",
          "format": "double"
        },
        "method": {
          "description": "The test behind the p-value.",
          "$ref": "#/$defs/AbMethod"
        },
        "looks": {
          "description": "How often the results were looked at (1 = once, at the end).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sample_ratio_mismatch": {
          "description": "Whether the visitor split departs from `expected_split` (SRM χ²\np < .001).",
          "type": "boolean"
        }
      },
      "required": [
        "arms",
        "expected_split",
        "conf_level",
        "method",
        "looks",
        "sample_ratio_mismatch"
      ]
    },
    "BootStatistic": {
      "description": "The statistic a bootstrap resamples.",
      "oneOf": [
        {
          "description": "Mean of `y`.",
          "type": "string",
          "const": "mean"
        },
        {
          "description": "Median of `y`.",
          "type": "string",
          "const": "median"
        },
        {
          "description": "Standard deviation of `y`.",
          "type": "string",
          "const": "sd"
        },
        {
          "description": "Mean of `y` without the lowest and highest `trim` share.",
          "type": "string",
          "const": "trimmed_mean"
        },
        {
          "description": "Mean of the first group minus the mean of the second.",
          "type": "string",
          "const": "mean_difference"
        },
        {
          "description": "Median of the first group minus the median of the second.",
          "type": "string",
          "const": "median_difference"
        },
        {
          "description": "Pearson correlation of `y` and `y2` (pairs resampled).",
          "type": "string",
          "const": "correlation"
        }
      ]
    },
    "BootInterval": {
      "description": "One bootstrap interval.",
      "type": "object",
      "properties": {
        "method": {
          "description": "How it was formed.",
          "$ref": "#/$defs/BootMethod"
        },
        "lo": {
          "description": "Lower bound.",
          "type": "number",
          "format": "double"
        },
        "hi": {
          "description": "Upper bound.",
          "type": "number",
          "format": "double"
        },
        "lo_mcse": {
          "description": "Monte Carlo SE of the lower bound, when the method has one.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "hi_mcse": {
          "description": "Monte Carlo SE of the upper bound.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "method",
        "lo",
        "hi"
      ]
    },
    "BootMethod": {
      "description": "How a bootstrap interval was formed.",
      "oneOf": [
        {
          "description": "Quantiles of the replicates.",
          "type": "string",
          "const": "percentile"
        },
        {
          "description": "Bias-corrected and accelerated quantiles (Efron 1987).",
          "type": "string",
          "const": "bca"
        },
        {
          "description": "Basic (reverse percentile): 2θ̂ minus the quantiles.",
          "type": "string",
          "const": "basic"
        },
        {
          "description": "θ̂ − bias ± z·SE.",
          "type": "string",
          "const": "normal"
        }
      ]
    },
    "BootstrapBody": {
      "description": "Body of a bootstrap card.",
      "type": "object",
      "properties": {
        "statistic": {
          "description": "What was resampled.",
          "$ref": "#/$defs/BootStatistic"
        },
        "variable": {
          "description": "The variable (and the second variable or the groups).",
          "type": "string"
        },
        "versus": {
          "description": "Second variable or the two groups, e.g. `am: 1 − 0`.",
          "type": [
            "string",
            "null"
          ]
        },
        "observed": {
          "description": "The statistic on the data.",
          "type": "number",
          "format": "double"
        },
        "resamples": {
          "description": "Number of resamples.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "conf_level": {
          "description": "Level of the intervals.",
          "type": "number",
          "format": "double"
        },
        "histogram": {
          "description": "Distribution of the replicates.",
          "$ref": "#/$defs/Histogram"
        },
        "intervals": {
          "description": "The intervals, percentile and BCa first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BootInterval"
          }
        },
        "z0": {
          "description": "BCa bias correction z₀.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "acceleration": {
          "description": "BCa acceleration a (jackknife).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "statistic",
        "variable",
        "observed",
        "resamples",
        "conf_level",
        "histogram",
        "intervals"
      ]
    },
    "SeasonalComponent": {
      "description": "One seasonal component of a decomposition.",
      "type": "object",
      "properties": {
        "period": {
          "description": "Its period, in observations.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "values": {
          "description": "One value per observation.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "period",
        "values"
      ]
    },
    "Holdout": {
      "description": "The forecast of the held-out tail by a model fitted without it.",
      "type": "object",
      "properties": {
        "start": {
          "description": "Index of the first held-out observation.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "predicted": {
          "description": "The forecast of the held-out observations.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "start",
        "predicted"
      ]
    },
    "ForecastBody": {
      "description": "Body of a forecast card. The forecast continues the series' indices\nat `values.len()`, `values.len() + 1`, …",
      "type": "object",
      "properties": {
        "variable": {
          "description": "The variable.",
          "type": "string"
        },
        "time": {
          "description": "Time labels of the observations, when the data had a time column.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "description": "The model, e.g. `MSTL (periods 12) + AutoETS trend`.",
          "type": "string"
        },
        "values": {
          "description": "The observations.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "trend": {
          "description": "Trend of the decomposition (empty without seasonal periods).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "seasonal": {
          "description": "Seasonal components, one per period.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeasonalComponent"
          },
          "default": []
        },
        "remainder": {
          "description": "Remainder of the decomposition.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "forecast": {
          "description": "Point forecasts.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "lo80": {
          "description": "80% interval, lower bounds.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "hi80": {
          "description": "80% interval, upper bounds.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "lo95": {
          "description": "95% interval, lower bounds.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "hi95": {
          "description": "95% interval, upper bounds.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "holdout": {
          "description": "The hold-out check, when one ran.",
          "anyOf": [
            {
              "$ref": "#/$defs/Holdout"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "variable",
        "model",
        "values",
        "forecast",
        "lo80",
        "hi80",
        "lo95",
        "hi95"
      ]
    },
    "Sense": {
      "description": "Direction of the objective.",
      "oneOf": [
        {
          "description": "Largest objective.",
          "type": "string",
          "const": "maximize"
        },
        {
          "description": "Smallest objective.",
          "type": "string",
          "const": "minimize"
        }
      ]
    },
    "OptimizationStatus": {
      "description": "How a solve ended.",
      "oneOf": [
        {
          "description": "Proven optimal.",
          "type": "string",
          "const": "optimal"
        },
        {
          "description": "A feasible point, optimality not proven (node limit reached).",
          "type": "string",
          "const": "feasible"
        },
        {
          "description": "No point satisfies every constraint.",
          "type": "string",
          "const": "infeasible"
        },
        {
          "description": "The objective improves without limit.",
          "type": "string",
          "const": "unbounded"
        },
        {
          "description": "Stopped before any feasible point was found.",
          "type": "string",
          "const": "stopped"
        }
      ]
    },
    "OptVariable": {
      "description": "One decision variable.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "value": {
          "description": "Value at the solution.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "lower": {
          "description": "Lower bound (`None` = −∞).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "upper": {
          "description": "Upper bound (`None` = +∞).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "integer": {
          "description": "Whether it must be a whole number.",
          "type": "boolean",
          "default": false
        },
        "objective_coefficient": {
          "description": "Its coefficient in the objective.",
          "type": "number",
          "format": "double"
        },
        "reduced_cost": {
          "description": "Change of the objective per unit the variable is forced up (0 for a\nvariable strictly between its bounds).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "name",
        "objective_coefficient"
      ]
    },
    "OptConstraint": {
      "description": "One linear constraint.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "expr": {
          "description": "The constraint as written.",
          "type": "string"
        },
        "coefficients": {
          "description": "Coefficient of each variable (in variable order) after moving every\nvariable term to the left.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "op": {
          "description": "Comparison.",
          "$ref": "#/$defs/ConstraintOp"
        },
        "rhs": {
          "description": "Right-hand side after moving every variable term to the left.",
          "type": "number",
          "format": "double"
        },
        "activity": {
          "description": "Value of the left-hand side at the solution.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "slack": {
          "description": "How far it is from binding (≥ 0 when satisfied).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "binding": {
          "description": "Whether it holds with equality.",
          "type": "boolean",
          "default": false
        },
        "dual": {
          "description": "Shadow price: change of the objective per unit increase of `rhs`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "name",
        "expr",
        "op",
        "rhs"
      ]
    },
    "ConstraintOp": {
      "description": "A comparison of a linear constraint.",
      "oneOf": [
        {
          "description": "`≤`.",
          "type": "string",
          "const": "le"
        },
        {
          "description": "`≥`.",
          "type": "string",
          "const": "ge"
        },
        {
          "description": "`=`.",
          "type": "string",
          "const": "eq"
        }
      ]
    },
    "OptimizationBody": {
      "description": "Body of an optimisation card.",
      "type": "object",
      "properties": {
        "sense": {
          "description": "Direction.",
          "$ref": "#/$defs/Sense"
        },
        "objective_expr": {
          "description": "The objective as written.",
          "type": "string"
        },
        "status": {
          "description": "How the solve ended.",
          "$ref": "#/$defs/OptimizationStatus"
        },
        "objective": {
          "description": "Objective value at the solution.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "integer": {
          "description": "Whether some variables are integer (a MILP).",
          "type": "boolean",
          "default": false
        },
        "mip_gap": {
          "description": "Relative gap between the solution and the best bound (MILP).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "variables": {
          "description": "The variables, in request order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptVariable"
          }
        },
        "constraints": {
          "description": "The constraints, in request order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptConstraint"
          }
        }
      },
      "required": [
        "sense",
        "objective_expr",
        "status",
        "variables",
        "constraints"
      ]
    },
    "FormField": {
      "description": "One field of a form.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Key of the value in the answer.",
          "type": "string"
        },
        "label": {
          "description": "Label shown; the name when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Help text under the input.",
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "description": "Whether the form cannot be submitted without it.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "description": "One line of text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            },
            "default": {
              "description": "Initial text.",
              "type": [
                "string",
                "null"
              ]
            },
            "min_length": {
              "description": "Shortest accepted length, in characters.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "max_length": {
              "description": "Longest accepted length, in characters.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Several lines of text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "multiline"
            },
            "default": {
              "description": "Initial text.",
              "type": [
                "string",
                "null"
              ]
            },
            "max_length": {
              "description": "Longest accepted length, in characters.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A real number.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "default": {
              "description": "Initial value.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "min": {
              "description": "Smallest accepted value.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "max": {
              "description": "Largest accepted value.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A whole number.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "default": {
              "description": "Initial value.",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "min": {
              "description": "Smallest accepted value.",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "max": {
              "description": "Largest accepted value.",
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A checkbox.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "default": {
              "description": "Initial state.",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "One choice among options.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "enum"
            },
            "options": {
              "description": "The options.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/FormOption"
              }
            },
            "default": {
              "description": "Value of the option selected at first.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "options"
          ]
        },
        {
          "description": "Any number of choices among options.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "multi_enum"
            },
            "options": {
              "description": "The options.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/FormOption"
              }
            },
            "default": {
              "description": "Values selected at first.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "min_items": {
              "description": "Fewest choices accepted.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "max_items": {
              "description": "Most choices accepted.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "options"
          ]
        }
      ]
    },
    "FormOption": {
      "description": "An option of an enum field.",
      "type": "object",
      "properties": {
        "value": {
          "description": "Value put in the answer.",
          "type": "string"
        },
        "label": {
          "description": "Text shown; the value when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value"
      ]
    },
    "FormState": {
      "description": "Lifecycle of a form.",
      "oneOf": [
        {
          "description": "Waiting for the user.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Submitted; `answer` holds the values.",
          "type": "string",
          "const": "submitted"
        },
        {
          "description": "Dismissed without answering.",
          "type": "string",
          "const": "cancelled"
        }
      ]
    },
    "FormSpec": {
      "description": "A form shown in the timeline.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Heading.",
          "type": "string"
        },
        "description": {
          "description": "Text under the heading: why the model asks.",
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "description": "Fields, in display order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormField"
          }
        },
        "submit_label": {
          "description": "Text of the submit button; the UI picks one when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "Whether the user answered.",
          "$ref": "#/$defs/FormState",
          "default": "pending"
        },
        "answer": {
          "description": "The submitted values by field name, once submitted.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "reason": {
          "description": "Why a cancelled form was cancelled, when known (e.g.\n[`NOT_ANSWERED`]).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title",
        "fields"
      ]
    },
    "TestSuite": {
      "description": "A test suite.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Suite name.",
          "type": "string"
        },
        "time_secs": {
          "description": "Wall time of the suite, in seconds.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cases": {
          "description": "Cases, in report order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestCase"
          }
        }
      },
      "required": [
        "name",
        "cases"
      ]
    },
    "TestCase": {
      "description": "One test case.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Case name.",
          "type": "string"
        },
        "classname": {
          "description": "Class or module, when the report has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "description": "Outcome.",
          "$ref": "#/$defs/TestOutcome"
        },
        "time_secs": {
          "description": "Wall time, in seconds.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "message": {
          "description": "Failure or skip message.",
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "description": "Stack trace or captured output.",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "description": "Where the test or the failure is.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "outcome"
      ]
    },
    "TestOutcome": {
      "description": "Outcome of a [`TestCase`].",
      "oneOf": [
        {
          "description": "Passed.",
          "type": "string",
          "const": "passed"
        },
        {
          "description": "An assertion failed.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "The test could not run to completion (panic, setup error).",
          "type": "string",
          "const": "errored"
        },
        {
          "description": "Not run.",
          "type": "string",
          "const": "skipped"
        }
      ]
    },
    "TestReportSpec": {
      "description": "A test run: suites of cases.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title, e.g. the report file name.",
          "type": [
            "string",
            "null"
          ]
        },
        "suites": {
          "description": "Suites, in report order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestSuite"
          }
        }
      },
      "required": [
        "suites"
      ]
    },
    "Finding": {
      "description": "One finding.",
      "type": "object",
      "properties": {
        "rule": {
          "description": "Rule id, e.g. `clippy::unwrap_used`.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "description": "Severity (SARIF `level`).",
          "$ref": "#/$defs/FindingSeverity"
        },
        "message": {
          "description": "What is wrong.",
          "type": "string"
        },
        "location": {
          "description": "Where; usually a [`SourceRef::File`] with lines.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "snippet": {
          "description": "Source excerpt of the location.",
          "type": [
            "string",
            "null"
          ]
        },
        "help_uri": {
          "description": "Link to the rule's documentation.",
          "type": [
            "string",
            "null"
          ]
        },
        "fix": {
          "description": "Suggested fix as a unified diff, made from [`Finding::fixes`]\nagainst the files.",
          "type": [
            "string",
            "null"
          ]
        },
        "fixes": {
          "description": "Suggested fixes as the log describes them (SARIF `fixes`): edits\nof byte or text ranges. Alternatives; the first is the preferred.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FindingFix"
          }
        }
      },
      "required": [
        "severity",
        "message"
      ]
    },
    "FindingSeverity": {
      "description": "Severity of a [`Finding`], the SARIF levels.",
      "oneOf": [
        {
          "description": "A problem.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "A possible problem.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Information.",
          "type": "string",
          "const": "note"
        },
        {
          "description": "No severity given.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "FindingFix": {
      "description": "A suggested fix: edits of one or more files.",
      "type": "object",
      "properties": {
        "description": {
          "description": "What it does.",
          "type": [
            "string",
            "null"
          ]
        },
        "edits": {
          "description": "The edits, in log order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixEdit"
          }
        }
      },
      "required": [
        "edits"
      ]
    },
    "FixEdit": {
      "description": "Replaces a range of a file with `inserted` (SARIF `replacement`). The\nrange is given by lines and columns (1-based, the end column\nexclusive; columns count characters), by character offset and length,\nor by byte offset and length.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The file, as the log names it (made workspace-relative by the tool).",
          "type": "string"
        },
        "start_line": {
          "description": "First line of the range.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "start_column": {
          "description": "First column; 1 when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "description": "Last line; `start_line` when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_column": {
          "description": "Column after the range; the end of `end_line` when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "char_offset": {
          "description": "Characters before the range, when given by offset.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "char_length": {
          "description": "Characters in the range (0 when absent).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "byte_offset": {
          "description": "Bytes before the range, when given by byte offset.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "byte_length": {
          "description": "Bytes in the range (0 when absent).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inserted": {
          "description": "The new text.",
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "path"
      ]
    },
    "FindingsSpec": {
      "description": "Static-analysis findings, SARIF-like.",
      "type": "object",
      "properties": {
        "tool": {
          "description": "Tool that produced them, e.g. `clippy 0.1.95`.",
          "type": [
            "string",
            "null"
          ]
        },
        "findings": {
          "description": "The findings, in report order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "required": [
        "findings"
      ]
    },
    "DatasetFormat": {
      "description": "Format of a dataset file.",
      "oneOf": [
        {
          "description": "Comma-separated values.",
          "type": "string",
          "const": "csv"
        },
        {
          "description": "Tab-separated values.",
          "type": "string",
          "const": "tsv"
        },
        {
          "description": "Apache Parquet.",
          "type": "string",
          "const": "parquet"
        },
        {
          "description": "Arrow IPC.",
          "type": "string",
          "const": "arrow"
        },
        {
          "description": "JSON lines.",
          "type": "string",
          "const": "jsonl"
        }
      ]
    },
    "DatasetColumn": {
      "description": "Schema and statistics of one column.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "dtype": {
          "description": "Data type as the file or the inference names it, e.g. `int64`,\n`utf8`, `timestamp[ms]`.",
          "type": "string"
        },
        "null_percent": {
          "description": "Share of null values, 0–100.",
          "type": "number",
          "format": "double"
        },
        "distinct": {
          "description": "Number of distinct values, when computed.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "distinct_capped": {
          "description": "Whether counting stopped at a cap: there are at least `distinct`\nvalues.",
          "type": "boolean"
        },
        "min": {
          "description": "Smallest value.",
          "anyOf": [
            {
              "$ref": "#/$defs/Cell"
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "description": "Largest value.",
          "anyOf": [
            {
              "$ref": "#/$defs/Cell"
            },
            {
              "type": "null"
            }
          ]
        },
        "histogram": {
          "description": "Distribution for the sparkline (numeric columns).",
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "dtype",
        "null_percent"
      ]
    },
    "DatasetSpec": {
      "description": "A dataset preview.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Workspace-relative path of the file.",
          "type": "string"
        },
        "format": {
          "description": "File format.",
          "$ref": "#/$defs/DatasetFormat"
        },
        "rows": {
          "description": "Total number of rows, when known without reading everything.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "sampled": {
          "description": "Whether the statistics come from a sample of the rows.",
          "type": "boolean",
          "default": false
        },
        "columns": {
          "description": "One entry per column, in file order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DatasetColumn"
          }
        },
        "preview": {
          "description": "The first rows.",
          "$ref": "#/$defs/TableSpec"
        }
      },
      "required": [
        "path",
        "format",
        "columns",
        "preview"
      ]
    },
    "MoleculeSpec": {
      "description": "A molecule drawn from SMILES.",
      "type": "object",
      "properties": {
        "smiles": {
          "description": "SMILES as given.",
          "type": "string"
        },
        "name": {
          "description": "Name to show beside the drawing.",
          "type": [
            "string",
            "null"
          ]
        },
        "svg": {
          "description": "2D depiction, SVG source.",
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "description": "Molecular formula in Hill order, computed.",
          "type": [
            "string",
            "null"
          ]
        },
        "mw": {
          "description": "Molecular weight in g/mol, computed.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "charge": {
          "description": "Net formal charge, computed.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "canonical": {
          "description": "Canonical SMILES, computed.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "Why the SMILES could not be parsed, with the column when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_formula": {
          "description": "Formula the model stated, to compare with the computed one.",
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_matches": {
          "description": "Whether `claimed_formula` matches `formula` (see [`formulas_match`]).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "smiles"
      ]
    },
    "Well": {
      "description": "One well of a plate.",
      "type": "object",
      "properties": {
        "well": {
          "description": "Position, row letter and 1-based column: `A1`, `P24`.",
          "type": "string"
        },
        "label": {
          "description": "Sample label, e.g. `blank`, `ctrl+`.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "Measured value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "well"
      ]
    },
    "PlateScale": {
      "description": "The colour scale of a plate map.",
      "oneOf": [
        {
          "description": "Faint at the minimum to solid at the maximum.",
          "type": "string",
          "const": "sequential"
        },
        {
          "description": "Two hues away from a centre (fold changes, z-scores, % of control).",
          "type": "string",
          "const": "diverging"
        },
        {
          "description": "Sequential over `log10` of the values (concentrations, counts);\nwells at or below 0 are not coloured.",
          "type": "string",
          "const": "log"
        }
      ]
    },
    "PlateSpec": {
      "description": "A microplate map: a value and a label per well, drawn as a heatmap.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "Number of wells: 96 (8×12) or 384 (16×24).",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "value_label": {
          "description": "What the values are, e.g. `OD600`.",
          "type": [
            "string",
            "null"
          ]
        },
        "wells": {
          "description": "Wells with data; the others are drawn empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Well"
          }
        },
        "scale": {
          "description": "How values map to colours.",
          "$ref": "#/$defs/PlateScale"
        },
        "center": {
          "description": "Centre of a diverging scale; 0 when the values straddle 0, else\ntheir median.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "format",
        "wells"
      ]
    }
  }
}
