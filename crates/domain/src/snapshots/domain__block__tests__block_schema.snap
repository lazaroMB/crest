    "TestCase": {
      "description": "One test case.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Case name.",
          "type": "string"
        },
        "classname": {
          "description": "Class or module, when the report has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "description": "Outcome.",
          "$ref": "#/$defs/TestOutcome"
        },
        "time_secs": {
          "description": "Wall time, in seconds.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "message": {
          "description": "Failure or skip message.",
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "description": "Stack trace or captured output.",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "description": "Where the test or the failure is.",
