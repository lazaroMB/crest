---
source: crates/domain/src/block.rs
expression: "schemars::schema_for!(Block)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Block",
  "description": "A block of the timeline.",
  "type": "object",
  "properties": {
    "id": {
      "description": "Stable id, used to update the block in place (streaming, status).",
      "$ref": "#/$defs/BlockId"
    }
  },
  "required": [
    "id"
  ],
  "oneOf": [
    {
      "description": "Model answer, markdown that may still be streaming.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "markdown": {
          "description": "Markdown source.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "markdown"
      ]
    },
    {
      "description": "Extended thinking of the model.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "thinking"
        },
        "text": {
          "description": "Raw reasoning text.",
          "type": "string"
        },
        "collapsed": {
          "description": "Whether the UI shows it collapsed (the default).",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "text",
        "collapsed"
      ]
    },
    {
      "description": "A tool invocation: one line with name, key arguments and status.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool_call"
        },
        "tool_use_id": {
          "description": "Id of the `tool_use` content block this call belongs to.",
          "type": "string"
        },
        "name": {
          "description": "Tool name.",
          "type": "string"
        },
        "summary": {
          "description": "Short human summary of the key arguments.",
          "type": "string"
        },
        "input": {
          "description": "Raw tool input as sent by the model."
        },
        "status": {
          "description": "Lifecycle state.",
          "$ref": "#/$defs/ToolStatus"
        },
        "output": {
          "description": "Tool output shown when expanded, once available.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "tool_use_id",
        "name",
        "summary",
        "input",
        "status"
      ]
    },
    {
      "description": "Tabular data (tool `show_table`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "table"
        }
      },
      "$ref": "#/$defs/TableSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A chart (tool `show_chart`); the UI can toggle it to a table.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chart"
        }
      },
      "$ref": "#/$defs/ChartSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A proposed file change (`edit_file`, `write_file`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "diff"
        }
      },
      "$ref": "#/$defs/DiffSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A Mermaid diagram (tool `show_mermaid`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "mermaid"
        }
      },
      "$ref": "#/$defs/MermaidSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A markdown document (tool `show_markdown` or a written `.md`), shown\nwith document typography and toggleable to source.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "markdown"
        },
        "title": {
          "description": "Document title, e.g. the file name.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Markdown source.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A block drawn by a Lua plugin from a declarative tree.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "custom"
        },
        "plugin": {
          "description": "Plugin that produced it.",
          "type": "string"
        },
        "name": {
          "description": "Block name within the plugin.",
          "type": "string"
        },
        "tree": {
          "description": "Content to draw.",
          "$ref": "#/$defs/CustomNode"
        }
      },
      "required": [
        "type",
        "plugin",
        "name",
        "tree"
      ]
    },
    {
      "description": "Sources cited by a workflow node; citations in the text link here.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sources"
        },
        "sources": {
          "description": "Cited sources, in citation order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        }
      },
      "required": [
        "type",
        "sources"
      ]
    },
    {
      "description": "An image (screenshot, exported chart, web image) with its source.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "media_type": {
          "description": "MIME type, e.g. `image/png`.",
          "type": "string"
        },
        "data_or_path": {
          "description": "Inline bytes or a path to read them from.",
          "$ref": "#/$defs/ImageData"
        },
        "source": {
          "description": "Where the image came from.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "media_type",
        "data_or_path"
      ]
    },
    {
      "description": "Marks that the workflow entered a new stage, with progress\n(`index` of `total`, 1-based, e.g. 5/14).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "stage_header"
        },
        "stage": {
          "description": "Stage name.",
          "type": "string"
        },
        "index": {
          "description": "1-based position of the stage.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "description": "Number of stages.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "stage",
        "index",
        "total"
      ]
    },
    {
      "description": "A command the user ran with `/!` in the workspace, and what it\nprinted.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "shell"
        },
        "command": {
          "description": "The command line as typed.",
          "type": "string"
        },
        "exit_code": {
          "description": "Exit code; `None` when it was killed (signal or timeout) or could\nnot start.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "stdout": {
          "description": "Standard output.",
          "type": "string",
          "default": ""
        },
        "stderr": {
          "description": "Standard error (or why it could not start).",
          "type": "string",
          "default": ""
        },
        "timed_out": {
          "description": "Whether it was killed for taking too long.",
          "type": "boolean",
          "default": false
        },
        "truncated": {
          "description": "Whether the output was cut to the size limit.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "type",
        "command"
      ]
    },
    {
      "description": "Failure of the API or a tool.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "message": {
          "description": "What went wrong.",
          "type": "string"
        },
        "hint": {
          "description": "Suggested action for the user.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    {
      "description": "An engine-computed result (statistics, calc sheet, unit\nconversion) with its provenance.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "computed"
        },
        "envelope": {
          "description": "The numbers and how they were produced.",
          "$ref": "#/$defs/Computed"
        },
        "body": {
          "description": "What the card draws.",
          "$ref": "#/$defs/ComputedBody"
        }
      },
      "required": [
        "type",
        "envelope",
        "body"
      ]
    },
    {
      "description": "A form the model asks the user to fill (tool `ask_user`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "form"
        }
      },
      "$ref": "#/$defs/FormSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Function plots with parameter sliders and numeric series (tool\n`show_plot`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "plot"
        }
      },
      "$ref": "#/$defs/PlotSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A test run report, e.g. from JUnit XML (tool `show_test_report`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "test_report"
        }
      },
      "$ref": "#/$defs/TestReportSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Static-analysis findings, e.g. from SARIF (tool `show_findings`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "findings"
        }
      },
      "$ref": "#/$defs/FindingsSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Schema, column statistics and first rows of a data file (tool\n`show_dataset`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "dataset"
        }
      },
      "$ref": "#/$defs/DatasetSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A 2D molecule with computed formula and mass (tool `show_molecule`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "molecule"
        }
      },
      "$ref": "#/$defs/MoleculeSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A 96- or 384-well plate map (tool `show_plate`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "plate"
        }
      },
      "$ref": "#/$defs/PlateSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A distributed trace as a waterfall (tool `show_trace`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "trace"
        }
      },
      "$ref": "#/$defs/TraceSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A profile as a flame graph (tool `show_flamegraph`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "flame_graph"
        }
      },
      "$ref": "#/$defs/FlameSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A log file on a filterable list (tool `show_logs`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "logs"
        }
      },
      "$ref": "#/$defs/LogSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A SQL query plan on a tree table (tool `show_query_plan`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "query_plan"
        }
      },
      "$ref": "#/$defs/QueryPlanSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "An HTTP archive as a waterfall, request list and inspector (tool\n`show_har`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "har"
        }
      },
      "$ref": "#/$defs/HarSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A Terraform plan's resource changes on a tree table (tool\n`show_terraform_plan`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "terraform_plan"
        }
      },
      "$ref": "#/$defs/TerraformPlanSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A DOT graph or an ER diagram from SQL DDL on the graph widget\n(tools `show_dot`, `show_er`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "diagram"
        }
      },
      "$ref": "#/$defs/DiagramSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Criterion benchmarks, baseline against new (tool\n`show_benchmarks`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "benchmarks"
        }
      },
      "$ref": "#/$defs/BenchSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Digital waveforms from a VCD, FST or GHW dump (tool\n`show_waveform`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "waveform"
        }
      },
      "$ref": "#/$defs/WaveformSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A SPICE or KiCad netlist as a component–net graph and a component\ntable (tool `show_netlist`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "netlist"
        }
      },
      "$ref": "#/$defs/NetlistSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A material's properties, each with its source or marked\nunverified (tool `show_material`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "material"
        }
      },
      "$ref": "#/$defs/MaterialSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A STEP part tessellated into the 3D view, with its solids (tool\n`show_step`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cad_model"
        }
      },
      "$ref": "#/$defs/CadModelSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A 2D DXF drawing with its layers (tool `show_dxf`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "drawing"
        }
      },
      "$ref": "#/$defs/DrawingSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "An IFC model's room schedule by storey (tool `show_ifc_schedule`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ifc_schedule"
        }
      },
      "$ref": "#/$defs/IfcScheduleSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A DNA, RNA or protein sequence with its features (tool\n`show_sequence`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sequence"
        }
      },
      "$ref": "#/$defs/SequenceSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A reaction scheme with its atom and charge balance (tool\n`show_reaction`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "reaction"
        }
      },
      "$ref": "#/$defs/ReactionSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A grid of molecules with descriptors and activities (tool\n`show_molecule_grid`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "molecule_grid"
        }
      },
      "$ref": "#/$defs/MoleculeGridSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "An IR, UV-Vis, NMR or mass spectrum with its peaks (tool\n`show_spectrum`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "spectrum"
        }
      },
      "$ref": "#/$defs/SpectrumSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A molecule in 3D as ball and stick (tool `show_molecule_3d`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "molecule3d"
        }
      },
      "$ref": "#/$defs/Molecule3dSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A GHS hazard card fetched from PubChem (tool `show_ghs`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ghs"
        }
      },
      "$ref": "#/$defs/GhsSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "GeoJSON features on a map with their geodesic measures (tool\n`show_map`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "geo_map"
        }
      },
      "$ref": "#/$defs/MapSpec",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "BlockId": {
      "description": "Stable identifier of a block in the timeline.",
      "type": "string",
      "format": "uuid"
    },
    "ToolStatus": {
      "description": "Lifecycle of a tool call.",
      "oneOf": [
        {
          "description": "Requested by the model, not started yet.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Waiting for the user to approve it.",
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "description": "Executing.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Finished successfully.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Finished with an error.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Rejected by the user or a permission rule.",
          "type": "string",
          "const": "denied"
        },
        {
          "description": "Interrupted before finishing.",
          "type": "string",
          "const": "cancelled"
        }
      ]
    },
    "Column": {
      "description": "A table column header.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Header text.",
          "type": "string"
        },
        "align": {
          "description": "Horizontal alignment; the UI picks one when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/Align"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "Align": {
      "description": "Horizontal alignment of a column.",
      "oneOf": [
        {
          "description": "Left aligned.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Centered.",
          "type": "string",
          "const": "center"
        },
        {
          "description": "Right aligned.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "Cell": {
      "description": "A table cell: a plain JSON scalar.",
      "anyOf": [
        {
          "description": "Empty cell (`null`).",
          "type": "null"
        },
        {
          "description": "Boolean.",
          "type": "boolean"
        },
        {
          "description": "Number.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "Text.",
          "type": "string"
        }
      ]
    },
    "TableSpec": {
      "description": "A table: named columns and rows of cells.",
      "type": "object",
      "properties": {
        "columns": {
          "description": "Column headers, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "rows": {
          "description": "Rows; each must have one cell per column.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Cell"
            }
          }
        }
      },
      "required": [
        "columns",
        "rows"
      ]
    },
    "ChartKind": {
      "description": "How a chart is drawn.",
      "oneOf": [
        {
          "description": "Vertical bars.",
          "type": "string",
          "const": "bar"
        },
        {
          "description": "Lines.",
          "type": "string",
          "const": "line"
        },
        {
          "description": "Filled areas.",
          "type": "string",
          "const": "area"
        },
        {
          "description": "Pie; takes exactly one series.",
          "type": "string",
          "const": "pie"
        }
      ]
    },
    "Series": {
      "description": "A named series of values, one per chart label.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Legend name.",
          "type": "string"
        },
        "values": {
          "description": "Values, aligned with the chart labels.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "name",
        "values"
      ]
    },
    "ChartSpec": {
      "description": "A chart: labels on one axis and one or more numeric series.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Chart title.",
          "type": "string"
        },
        "kind": {
          "description": "How the series are drawn.",
          "$ref": "#/$defs/ChartKind"
        },
        "labels": {
          "description": "Category labels, one per value of each series.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Data series.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Series"
          }
        }
      },
      "required": [
        "title",
        "kind",
        "labels",
        "series"
      ]
    },
    "ApprovalState": {
      "description": "Decision of the user on a proposed file change.",
      "oneOf": [
        {
          "description": "Waiting for the user.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Accepted.",
          "type": "string",
          "const": "approved"
        },
        {
          "description": "Rejected.",
          "type": "string",
          "const": "rejected"
        }
      ]
    },
    "DiffSpec": {
      "description": "A file change. The adapter computes the diff; this is only data.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of the file, relative to the workspace.",
          "type": "string"
        },
        "old_text": {
          "description": "Previous content; absent when the file is new.",
          "type": [
            "string",
            "null"
          ]
        },
        "new_text": {
          "description": "New content.",
          "type": "string"
        },
        "unified": {
          "description": "Unified diff between both.",
          "type": "string"
        },
        "approval": {
          "description": "Approval state when the change needs the user's decision.",
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "new_text",
        "unified"
      ]
    },
    "MermaidSpec": {
      "description": "A Mermaid diagram; the UI shows the source and the error if it does not\nparse.",
      "type": "object",
      "properties": {
        "source": {
          "description": "Mermaid source.",
          "type": "string"
        },
        "title": {
          "description": "Optional caption.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source"
      ]
    },
    "CustomNode": {
      "description": "Declarative UI primitive of a `Custom` block, tagged by `type`.\n\nLua never touches GPUI: plugins return this tree and the UI turns it\ninto components.",
      "oneOf": [
        {
          "description": "Plain text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "description": "The text.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "description": "Children laid out horizontally.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "row"
            },
            "children": {
              "description": "Child nodes.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomNode"
              }
            }
          },
          "required": [
            "type",
            "children"
          ]
        },
        {
          "description": "Children laid out vertically.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "col"
            },
            "children": {
              "description": "Child nodes.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomNode"
              }
            }
          },
          "required": [
            "type",
            "children"
          ]
        },
        {
          "description": "A bulleted list.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            },
            "items": {
              "description": "One node per item.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomNode"
              }
            }
          },
          "required": [
            "type",
            "items"
          ]
        },
        {
          "description": "A table.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table"
            }
          },
          "$ref": "#/$defs/TableSpec",
          "required": [
            "type"
          ]
        },
        {
          "description": "A chart.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "chart"
            }
          },
          "$ref": "#/$defs/ChartSpec",
          "required": [
            "type"
          ]
        },
        {
          "description": "A code snippet.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            },
            "lang": {
              "description": "Language for highlighting.",
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "description": "Source code.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ]
        },
        {
          "description": "Rendered markdown.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "markdown"
            },
            "source": {
              "description": "Markdown source.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ]
        },
        {
          "description": "A picture, from a file or inline bytes, with zoom and pan.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "source": {
              "description": "Inline bytes or a file. A file must be inside the workspace and\nnot sensitive; the app replaces a rejected one with a text node.",
              "$ref": "#/$defs/ImageData"
            },
            "media_type": {
              "description": "MIME type, e.g. `image/png`; required for inline bytes.",
              "type": [
                "string",
                "null"
              ]
            },
            "alt": {
              "description": "Text shown when the image cannot be drawn.",
              "type": [
                "string",
                "null"
              ]
            },
            "fit": {
              "description": "How the image is sized at first.",
              "$ref": "#/$defs/ImageFit",
              "default": "contain"
            }
          },
          "required": [
            "type",
            "source"
          ]
        },
        {
          "description": "A basic HTML subset (headings, paragraphs, lists, tables, links,\nemphasis, code), drawn natively; no CSS layout and no scripts.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "html"
            },
            "source": {
              "description": "HTML source.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ]
        },
        {
          "description": "A JSON value as a collapsible tree.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "value": {
              "description": "The value."
            },
            "expand_depth": {
              "description": "Levels expanded at first (0 shows only the root collapsed).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A Mermaid diagram, with pan and zoom.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mermaid"
            },
            "source": {
              "description": "Mermaid source.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ]
        },
        {
          "description": "A link that opens in the user's browser.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "link"
            },
            "text": {
              "description": "Text shown.",
              "type": "string"
            },
            "url": {
              "description": "Address; `http`, `https` or `mailto` only.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text",
            "url"
          ]
        },
        {
          "description": "A colored unified diff.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "diff"
            },
            "unified": {
              "description": "Unified diff text.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "unified"
          ]
        },
        {
          "description": "A 3D model (`/open` of an OBJ, STL or PLY file), with an orbit\ncamera.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "model3d"
            }
          },
          "$ref": "#/$defs/ModelSpec",
          "required": [
            "type"
          ]
        },
        {
          "description": "A function plot with parameter sliders, as the `plot` block draws\nit.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plot"
            }
          },
          "$ref": "#/$defs/PlotSpec",
          "required": [
            "type"
          ]
        },
        {
          "description": "Rows of spans on a time axis, with zoom, pan and a tooltip\n(traces, Gantt charts, waveforms).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timeline"
            }
          },
          "$ref": "#/$defs/TimelineSpec",
          "required": [
            "type"
          ]
        },
        {
          "description": "Records (log lines, requests) with a text or regex filter, level\nand field chips, follow mode and rows that open to their fields.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "filter_list"
            }
          },
          "$ref": "#/$defs/ListSpec",
          "required": [
            "type"
          ]
        },
        {
          "description": "Nodes joined by edges, laid out in layers, by forces or on a grid,\nwith pan, zoom and a click to focus a node's neighbourhood (DOT,\nER diagrams, netlists, networks).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "graph"
            }
          },
          "$ref": "#/$defs/GraphSpec",
          "required": [
            "type"
          ]
        },
        {
          "description": "Nested rows with typed columns (text, numbers, durations, inline\nbars) and badges, collapsible (query plans, Terraform plans).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tree"
            }
          },
          "$ref": "#/$defs/TreeSpec",
          "required": [
            "type"
          ]
        }
      ]
    },
    "ImageData": {
      "description": "Bytes of an image block, tagged by `type`.",
      "oneOf": [
        {
          "description": "Inline, base64 encoded.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "base64"
            },
            "data": {
              "description": "Base64 payload.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A file on disk.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "path"
            },
            "path": {
              "description": "File path.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ]
        }
      ]
    },
    "ImageFit": {
      "description": "How an [`CustomNode::Image`] is sized before the user zooms.",
      "oneOf": [
        {
          "description": "Natural size, scaled down to the width available.",
          "type": "string",
          "const": "contain"
        },
        {
          "description": "Natural size (1:1); wider images scroll.",
          "type": "string",
          "const": "actual"
        }
      ]
    },
    "ModelMesh": {
      "description": "A triangle mesh.",
      "type": "object",
      "properties": {
        "positions": {
          "description": "Vertex positions.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "triangles": {
          "description": "Triangles, as indices into `positions`.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "up": {
          "description": "The axis that points up.",
          "$ref": "#/$defs/UpAxis",
          "default": "y"
        }
      },
      "required": [
        "positions",
        "triangles"
      ]
    },
    "UpAxis": {
      "description": "The axis that points up in the file's coordinates.",
      "oneOf": [
        {
          "description": "`+Y` (OBJ, most real-time tools).",
          "type": "string",
          "const": "y"
        },
        {
          "description": "`+Z` (STL, PLY, most CAD tools).",
          "type": "string",
          "const": "z"
        }
      ]
    },
    "ModelSpec": {
      "description": "A model shown in a modal: the mesh and the file it came from.",
      "type": "object",
      "properties": {
        "name": {
          "description": "File name or title.",
          "type": "string"
        },
        "mesh": {
          "description": "The mesh.",
          "$ref": "#/$defs/ModelMesh"
        },
        "unit": {
          "description": "The length unit of the coordinates, when the file says it (`mm`,\n`in`; STEP does, OBJ/STL/PLY do not). Measurements show it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "mesh"
      ]
    },
    "PlotRange": {
      "description": "A closed interval of an axis or of `t`.",
      "type": "object",
      "properties": {
        "min": {
          "description": "Lower end.",
          "type": "number",
          "format": "double"
        },
        "max": {
          "description": "Upper end, greater than `min`.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "PlotFunction": {
      "description": "A function to draw.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "How `expr` is read.",
          "$ref": "#/$defs/FunctionKind"
        },
        "expr": {
          "description": "`f(x)` for explicit, `x(t)` for parametric, `f(x, y)` (drawn where\nit is 0) for implicit.",
          "type": "string"
        },
        "y_expr": {
          "description": "`y(t)`, for parametric functions only.",
          "type": [
            "string",
            "null"
          ]
        },
        "t_range": {
          "description": "Range of `t`, for parametric functions; `0..1` when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlotRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "description": "Legend label; the expression when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "expr"
      ]
    },
    "FunctionKind": {
      "description": "How a [`PlotFunction`] is defined.",
      "oneOf": [
        {
          "description": "`y = f(x)`.",
          "type": "string",
          "const": "explicit"
        },
        {
          "description": "`(x(t), y(t))`.",
          "type": "string",
          "const": "parametric"
        },
        {
          "description": "`f(x, y) = 0`.",
          "type": "string",
          "const": "implicit"
        }
      ]
    },
    "PlotParam": {
      "description": "A parameter with a slider.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Variable name used in the expressions.",
          "type": "string"
        },
        "min": {
          "description": "Slider minimum.",
          "type": "number",
          "format": "double"
        },
        "max": {
          "description": "Slider maximum.",
          "type": "number",
          "format": "double"
        },
        "step": {
          "description": "Slider step; continuous when absent.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "value": {
          "description": "Current value.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "name",
        "min",
        "max",
        "value"
      ]
    },
    "XySeries": {
      "description": "A numeric series.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Legend name.",
          "type": "string"
        },
        "x": {
          "description": "x coordinates.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "y": {
          "description": "y coordinates, one per x.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "style": {
          "description": "Points or a line.",
          "$ref": "#/$defs/SeriesStyle",
          "default": "scatter"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ]
    },
    "SeriesStyle": {
      "description": "How an [`XySeries`] is drawn.",
      "oneOf": [
        {
          "description": "Points.",
          "type": "string",
          "const": "scatter"
        },
        {
          "description": "A line through the points in order.",
          "type": "string",
          "const": "line"
        }
      ]
    },
    "AxisScale": {
      "description": "How an axis maps values to positions.",
      "oneOf": [
        {
          "description": "Equal steps for equal differences.",
          "type": "string",
          "const": "linear"
        },
        {
          "description": "Equal steps for equal ratios (base 10); only positive values show.",
          "type": "string",
          "const": "log"
        }
      ]
    },
    "PlotAspect": {
      "description": "The shape of a plot area.",
      "oneOf": [
        {
          "description": "Height follows the width.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "One unit (axis unit, so a decade on a log axis) is as long on both\naxes: circles stay round.",
          "type": "string",
          "const": "equal"
        }
      ]
    },
    "PlotSpec": {
      "description": "A plot of functions and series.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title.",
          "type": [
            "string",
            "null"
          ]
        },
        "x_range": {
          "description": "Visible x range; the UI fits the data when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlotRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "y_range": {
          "description": "Visible y range; the UI fits the data when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlotRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "x_label": {
          "description": "Label of the x axis.",
          "type": [
            "string",
            "null"
          ]
        },
        "y_label": {
          "description": "Label of the y axis.",
          "type": [
            "string",
            "null"
          ]
        },
        "functions": {
          "description": "Functions to draw.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlotFunction"
          },
          "default": []
        },
        "params": {
          "description": "Parameters the functions use, each with a slider.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlotParam"
          },
          "default": []
        },
        "series": {
          "description": "Numeric series.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/XySeries"
          },
          "default": []
        },
        "x_scale": {
          "description": "Scale of the x axis.",
          "$ref": "#/$defs/AxisScale"
        },
        "y_scale": {
          "description": "Scale of the y axis.",
          "$ref": "#/$defs/AxisScale"
        },
        "aspect": {
          "description": "Shape of the plot area.",
          "$ref": "#/$defs/PlotAspect"
        },
        "x_reversed": {
          "description": "Whether the x axis runs right to left (IR wavenumbers, NMR\nchemical shifts).",
          "type": "boolean"
        }
      }
    },
    "TimeUnit": {
      "description": "Unit of every time in a [`TimelineSpec`].",
      "oneOf": [
        {
          "description": "Nanoseconds.",
          "type": "string",
          "const": "ns"
        },
        {
          "description": "Microseconds.",
          "type": "string",
          "const": "us"
        },
        {
          "description": "Milliseconds.",
          "type": "string",
          "const": "ms"
        },
        {
          "description": "Seconds.",
          "type": "string",
          "const": "s"
        },
        {
          "description": "Calendar time: seconds since 1970-01-01T00:00:00Z.",
          "type": "string",
          "const": "date"
        }
      ]
    },
    "TimelineRow": {
      "description": "One lane of the timeline.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique id of the row (a span id, a signal path).",
          "type": "string"
        },
        "label": {
          "description": "Text in the label column.",
          "type": "string"
        },
        "depth": {
          "description": "Indentation level (0 = top level), for trees of spans.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "group": {
          "description": "Consecutive rows of the same group are banded together.",
          "type": [
            "string",
            "null"
          ]
        },
        "spans": {
          "description": "Intervals of the row.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          },
          "default": []
        },
        "markers": {
          "description": "Instants of the row.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Marker"
          }
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "Span": {
      "description": "One interval of a row.",
      "type": "object",
      "properties": {
        "start": {
          "description": "Start time.",
          "type": "number",
          "format": "double"
        },
        "end": {
          "description": "End time; at least `start` (equal for an instant). `stop` is\naccepted too, since `end` is a keyword in Lua.",
          "type": "number",
          "format": "double"
        },
        "label": {
          "description": "Text drawn inside the bar when it fits, and in the tooltip.",
          "type": [
            "string",
            "null"
          ]
        },
        "color_key": {
          "description": "Spans with the same key share a palette color (a service, a kind).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Outcome; errors and warnings are drawn in their theme colors.",
          "anyOf": [
            {
              "$ref": "#/$defs/SpanStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "attrs": {
          "description": "Extra fields shown when the span is hovered or selected.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "SpanStatus": {
      "description": "How a span ended.",
      "oneOf": [
        {
          "description": "Finished fine.",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "Finished with a warning (slow, retried).",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Failed.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "Marker": {
      "description": "A point in time drawn as a tick across its row.",
      "type": "object",
      "properties": {
        "at": {
          "description": "When.",
          "type": "number",
          "format": "double"
        },
        "label": {
          "description": "What happened (shown in the tooltip).",
          "type": [
            "string",
            "null"
          ]
        },
        "color_key": {
          "description": "Palette key, as for spans.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at"
      ]
    },
    "TimeRange": {
      "description": "A closed time interval.",
      "type": "object",
      "properties": {
        "start": {
          "description": "First time shown.",
          "type": "number",
          "format": "double"
        },
        "end": {
          "description": "Last time shown; greater than `start`.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "TimelineSpec": {
      "description": "Rows of spans on a shared time axis.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption above the timeline.",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "Unit of every time.",
          "$ref": "#/$defs/TimeUnit",
          "default": "ms"
        },
        "rows": {
          "description": "Lanes, top to bottom.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineRow"
          }
        },
        "range": {
          "description": "Axis range at first; the extent of the data when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rows"
      ]
    },
    "ListItem": {
      "description": "One record.",
      "type": "object",
      "properties": {
        "level": {
          "description": "Severity (`error`, `warn`, `info`...); colors the row.",
          "type": [
            "string",
            "null"
          ]
        },
        "ts": {
          "description": "Timestamp as written by the source.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "The message.",
          "type": "string"
        },
        "fields": {
          "description": "Named fields, shown when the row is opened.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "text"
      ]
    },
    "ListSpec": {
      "description": "Records with a text filter and facet chips.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption above the list.",
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "description": "Fields shown as columns between the level and the text.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "description": "The records, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ListItem"
          }
        },
        "facets": {
          "description": "Fields offered as filter chips (besides the level).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "follow": {
          "description": "Start following the tail (scrolled to the last item).",
          "type": "boolean"
        }
      },
      "required": [
        "items"
      ]
    },
    "LayoutKind": {
      "description": "How the nodes are placed.",
      "oneOf": [
        {
          "description": "Layers in the edges' direction (Sugiyama): flows, dependencies,\nplans.",
          "type": "string",
          "const": "layered"
        },
        {
          "description": "A seeded spring embedding: networks without a direction.",
          "type": "string",
          "const": "force"
        },
        {
          "description": "Rows and columns in node order (grouped): loose collections.",
          "type": "string",
          "const": "grid"
        }
      ]
    },
    "FlowDirection": {
      "description": "Which way a layered layout flows.",
      "oneOf": [
        {
          "description": "Top to bottom.",
          "type": "string",
          "const": "down"
        },
        {
          "description": "Left to right.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "GraphNode": {
      "description": "One node.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique id, referenced by edges.",
          "type": "string"
        },
        "label": {
          "description": "Text in the box; the id when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "description": "Id of the group (cluster) the node belongs to.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Class of the node (`table`, `service`, `resistor`); nodes of one\nkind share a color.",
          "type": [
            "string",
            "null"
          ]
        },
        "attrs": {
          "description": "Extra fields shown when the node is focused.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id"
      ]
    },
    "GraphEdge": {
      "description": "One edge, from node id to node id.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Id of the source node.",
          "type": "string"
        },
        "to": {
          "description": "Id of the target node.",
          "type": "string"
        },
        "label": {
          "description": "Text drawn along the edge.",
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "description": "Strength (a count, a cost); thicker edges are heavier.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "GraphGroup": {
      "description": "A named group of nodes, drawn as a box around them.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Id the nodes' `group` refers to.",
          "type": "string"
        },
        "label": {
          "description": "Caption of the box; the id when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ]
    },
    "GraphSpec": {
      "description": "Nodes joined by edges, with a layout.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption above the graph.",
          "type": [
            "string",
            "null"
          ]
        },
        "directed": {
          "description": "Edges have arrowheads (true by default).",
          "type": "boolean"
        },
        "layout": {
          "description": "How the nodes are placed.",
          "$ref": "#/$defs/LayoutKind",
          "default": "layered"
        },
        "direction": {
          "description": "Flow of a layered layout.",
          "$ref": "#/$defs/FlowDirection",
          "default": "down"
        },
        "seed": {
          "description": "Seed of the force layout (the same seed gives the same picture).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "nodes": {
          "description": "The nodes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphNode"
          }
        },
        "edges": {
          "description": "The edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "default": []
        },
        "groups": {
          "description": "Captions of the groups nodes refer to; a group not listed is\ncaptioned with its id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphGroup"
          }
        }
      },
      "required": [
        "nodes"
      ]
    },
    "TreeColumn": {
      "description": "One column.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Header, and the key of the nodes' `values`.",
          "type": "string"
        },
        "kind": {
          "description": "What it holds.",
          "$ref": "#/$defs/ColumnKind",
          "default": "text"
        },
        "unit": {
          "description": "For a duration, its time unit (`ns`, `us`, `ms`, `s`); for a\nnumber or a bar, a suffix (`rows`, `%`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ColumnKind": {
      "description": "What a column holds and how it is drawn.",
      "oneOf": [
        {
          "description": "Any value, as text, left-aligned.",
          "type": "string",
          "const": "text"
        },
        {
          "description": "A number, right-aligned.",
          "type": "string",
          "const": "number"
        },
        {
          "description": "A time span in the column's unit (`ms` by default), right-aligned.",
          "type": "string",
          "const": "duration"
        },
        {
          "description": "A number with a bar scaled to the column's largest value.",
          "type": "string",
          "const": "bar"
        }
      ]
    },
    "TreeNode": {
      "description": "One row, with its children.",
      "type": "object",
      "properties": {
        "label": {
          "description": "Text of the first column.",
          "type": "string"
        },
        "badge": {
          "description": "A short tag after the label (`hot`, `seq scan`, `+create`).",
          "type": [
            "string",
            "null"
          ]
        },
        "tone": {
          "description": "Color of the badge.",
          "anyOf": [
            {
              "$ref": "#/$defs/BadgeTone"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "description": "Value of each column, by column name.",
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "description": "Rows nested under this one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        }
      },
      "required": [
        "label"
      ]
    },
    "BadgeTone": {
      "description": "Color of a badge.",
      "oneOf": [
        {
          "description": "Muted.",
          "type": "string",
          "const": "neutral"
        },
        {
          "description": "Informational (accent).",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Good (success color).",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "Worth a look (warning color).",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Bad (danger color): a hot plan node, a resource destroyed.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "TreeSpec": {
      "description": "Nested rows with typed columns.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption above the tree.",
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "description": "Columns after the label.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeColumn"
          },
          "default": []
        },
        "nodes": {
          "description": "Top-level rows.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        },
        "expand_depth": {
          "description": "Levels open at first (2: the top rows and their children).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 2
        }
      },
      "required": [
        "nodes"
      ]
    },
    "SourceRef": {
      "description": "Where a piece of information came from, tagged by `type`.",
      "oneOf": [
        {
          "description": "A file of the workspace, optionally a 1-based inclusive line range.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "description": "Path relative to the workspace.",
              "type": "string"
            },
            "line_start": {
              "description": "First line.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "line_end": {
              "description": "Last line.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "description": "A git commit.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "commit"
            },
            "sha": {
              "description": "Commit hash.",
              "type": "string"
            },
            "summary": {
              "description": "First line of the message.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sha",
            "summary"
          ]
        },
        {
          "description": "A web page.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "url"
            },
            "url": {
              "description": "Address.",
              "type": "string"
            },
            "title": {
              "description": "Page title.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "description": "Output of a shell command.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "command": {
              "description": "Command line.",
              "type": "string"
            },
            "output_excerpt": {
              "description": "Relevant excerpt of its output.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "command",
            "output_excerpt"
          ]
        }
      ]
    },
    "Computed": {
      "description": "The result of one engine computation, with its provenance.",
      "type": "object",
      "properties": {
        "crest_computed": {
          "description": "Envelope format version, `\"1.0\"`.",
          "type": "string"
        },
        "id": {
          "description": "Id that number slots use (`⟦id.key⟧`); unique within a session.",
          "type": "string"
        },
        "kind": {
          "description": "What was computed, dotted: `stats.ttest_welch`, `calc.sheet`,\n`units.convert`.",
          "type": "string"
        },
        "status": {
          "description": "Whether the computation succeeded.",
          "$ref": "#/$defs/ComputedStatus"
        },
        "error": {
          "description": "Why it failed, when `status` is `error`.",
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "description": "Headline numbers by key (`t`, `df`, `p_value`...), the targets of\nnumber slots.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ComputedValue"
          },
          "default": {}
        },
        "uncertainty_kind": {
          "description": "What kind of uncertainty the intervals express.",
          "anyOf": [
            {
              "$ref": "#/$defs/UncertaintyKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "description": "The method used and why.",
          "$ref": "#/$defs/Method"
        },
        "assumptions": {
          "description": "Assumption checks, including the ones that were not checked.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "default": []
        },
        "warnings": {
          "description": "Misuse and data warnings.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComputedWarning"
          },
          "default": []
        },
        "inputs": {
          "description": "The data and parameters the engine read.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "default": []
        },
        "engine": {
          "description": "The engine that computed it.",
          "$ref": "#/$defs/Engine"
        },
        "seed": {
          "description": "RNG seed; required for resampling kinds (bootstrap, Monte Carlo).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "rng": {
          "description": "RNG algorithm, e.g. `chacha20`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "environment_hash": {
          "description": "Hash of the engine environment, `blake3:<hex>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "reproduce": {
          "description": "Commands that reproduce the result elsewhere.",
          "$ref": "#/$defs/Reproduce",
          "default": {}
        },
        "narrative": {
          "description": "The template the plain-language sentence comes from.",
          "anyOf": [
            {
              "$ref": "#/$defs/Narrative"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "description": "When and for whom it ran.",
          "$ref": "#/$defs/Provenance",
          "default": {}
        },
        "verification": {
          "description": "Result of the last recompute.",
          "$ref": "#/$defs/Verification",
          "default": {
            "recomputed_at": null,
            "match": null
          }
        }
      },
      "required": [
        "crest_computed",
        "id",
        "kind",
        "status",
        "method",
        "engine"
      ]
    },
    "ComputedStatus": {
      "description": "Outcome of a computation.",
      "oneOf": [
        {
          "description": "Computed without problems.",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "Computed, but with warnings the card shows.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Not computed; `error` says why.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "ComputedValue": {
      "description": "One engine number. `v` is the stored value; the other fields only change\nhow it is shown.",
      "type": "object",
      "properties": {
        "v": {
          "description": "Raw value, never rounded.",
          "type": "number",
          "format": "double"
        },
        "display": {
          "description": "Preformatted text the engine chose, e.g. `−3.77`.",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "Unit, from the engine (never the model), e.g. `mi/gal`.",
          "type": [
            "string",
            "null"
          ]
        },
        "sig": {
          "description": "Significant digits to show.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "decimals": {
          "description": "Decimals to show (used when `sig` is absent).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "fmt": {
          "description": "Formatting rule.",
          "anyOf": [
            {
              "$ref": "#/$defs/ValueFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci": {
          "description": "Confidence or credible interval.",
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "description": "A verbal label, e.g. `large` for an effect size.",
          "type": [
            "string",
            "null"
          ]
        },
        "label_rule": {
          "description": "Where the label comes from, e.g. `Cohen 1988`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "v"
      ]
    },
    "ValueFormat": {
      "description": "How a [`ComputedValue`] is formatted when it has no `display`.",
      "oneOf": [
        {
          "description": "An APA p-value: `.043`, `< .001`.",
          "type": "string",
          "const": "apa"
        },
        {
          "description": "A statistic bounded by 1 (r, R², proportions): no leading zero.",
          "type": "string",
          "const": "bounded"
        },
        {
          "description": "Fixed decimals, or `sig` significant digits.",
          "type": "string",
          "const": "fixed"
        },
        {
          "description": "`v` is a fraction shown as a percentage.",
          "type": "string",
          "const": "percent"
        },
        {
          "description": "Scientific notation, `1.23e−4`.",
          "type": "string",
          "const": "scientific"
        }
      ]
    },
    "Interval": {
      "description": "A confidence or credible interval.",
      "type": "object",
      "properties": {
        "level": {
          "description": "Coverage, e.g. `0.95`.",
          "type": "number",
          "format": "double"
        },
        "lo": {
          "description": "Lower bound.",
          "type": "number",
          "format": "double"
        },
        "hi": {
          "description": "Upper bound.",
          "type": "number",
          "format": "double"
        },
        "method": {
          "description": "How it was computed, e.g. `welch_t`, `noncentral_t`, `bca`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "level",
        "lo",
        "hi"
      ]
    },
    "UncertaintyKind": {
      "description": "What the intervals of an envelope express.",
      "oneOf": [
        {
          "description": "Frequentist confidence intervals.",
          "type": "string",
          "const": "frequentist_ci"
        },
        {
          "description": "Bootstrap intervals.",
          "type": "string",
          "const": "bootstrap_ci"
        },
        {
          "description": "Bayesian credible intervals.",
          "type": "string",
          "const": "credible_interval"
        },
        {
          "description": "Monte Carlo standard errors.",
          "type": "string",
          "const": "monte_carlo"
        },
        {
          "description": "Exact arithmetic; no uncertainty.",
          "type": "string",
          "const": "exact"
        }
      ]
    },
    "Method": {
      "description": "The method an engine used.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Human name, e.g. `Welch two-sample t-test`.",
          "type": "string"
        },
        "why": {
          "description": "Why it was chosen, e.g. `Levene p = .02 → unequal variances`.",
          "type": [
            "string",
            "null"
          ]
        },
        "alternatives": {
          "description": "Kinds that could be run instead, e.g. `mann_whitney`.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "params": {
          "description": "Parameters, e.g. `{\"alternative\": \"two-sided\"}`.",
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },
      "required": [
        "name"
      ]
    },
    "Assumption": {
      "description": "One assumption of the method and whether it holds.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id, e.g. `normality_g1`.",
          "type": "string"
        },
        "check": {
          "description": "The check run, e.g. `Shapiro-Wilk`; absent when not checked.",
          "type": [
            "string",
            "null"
          ]
        },
        "stat": {
          "description": "The check's statistic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p": {
          "description": "The check's p-value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "status": {
          "description": "Outcome.",
          "$ref": "#/$defs/AssumptionStatus"
        },
        "consequence": {
          "description": "What the engine did about it, e.g. `used Welch correction`.",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "description": "A note for the user, e.g. `design property; confirm`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "status"
      ]
    },
    "AssumptionStatus": {
      "description": "Outcome of an assumption check.",
      "oneOf": [
        {
          "description": "Holds.",
          "type": "string",
          "const": "pass"
        },
        {
          "description": "Doubtful.",
          "type": "string",
          "const": "warn"
        },
        {
          "description": "Violated.",
          "type": "string",
          "const": "fail"
        },
        {
          "description": "Not checkable by the engine (a design property); shown on purpose.",
          "type": "string",
          "const": "not_checked"
        }
      ]
    },
    "ComputedWarning": {
      "description": "A misuse or data warning attached by the engine.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable code, e.g. `small_n`, `expected_count_lt_5`.",
          "type": "string"
        },
        "severity": {
          "description": "How serious it is.",
          "$ref": "#/$defs/WarningSeverity"
        },
        "text": {
          "description": "Text for the user.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "text"
      ]
    },
    "WarningSeverity": {
      "description": "Severity of a [`ComputedWarning`].",
      "oneOf": [
        {
          "description": "Worth knowing.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "May change the conclusion.",
          "type": "string",
          "const": "warn"
        },
        {
          "description": "The result should not be used as is.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "InputRef": {
      "description": "Data or parameters an engine read.",
      "type": "object",
      "properties": {
        "name": {
          "description": "File name or a label for inline data.",
          "type": "string"
        },
        "role": {
          "description": "`data` or `param`.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Workspace-relative path, when read from a file; a change to it marks\nthe block stale.",
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "description": "Content hash, `blake3:<hex>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rows": {
          "description": "Number of rows read.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "columns": {
          "description": "Columns used.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "filter": {
          "description": "Row filter applied, e.g. `none`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "Engine": {
      "description": "The engine that produced an envelope.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Engine name, e.g. `crest-stats`.",
          "type": "string"
        },
        "version": {
          "description": "Engine version.",
          "type": "string"
        },
        "backend": {
          "description": "Library underneath, e.g. `statrs 0.19.1`.",
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "description": "Target triple, e.g. `x86_64-linux`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Reproduce": {
      "description": "One-line commands that reproduce a result.",
      "type": "object",
      "properties": {
        "lua": {
          "description": "crest Lua, e.g. `app.compute.test{...}`.",
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "description": "Python (scipy, statsmodels).",
          "type": [
            "string",
            "null"
          ]
        },
        "r": {
          "description": "R.",
          "type": [
            "string",
            "null"
          ]
        },
        "shell": {
          "description": "A shell command of a standalone tool, e.g. `numbat -e '…'`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Narrative": {
      "description": "The template of the plain-language sentence.",
      "type": "object",
      "properties": {
        "template": {
          "description": "Template name, e.g. `apa_ttest`.",
          "type": "string"
        },
        "text_slots": {
          "description": "Value keys the sentence uses.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "template"
      ]
    },
    "Provenance": {
      "description": "When and for whom a computation ran.",
      "type": "object",
      "properties": {
        "activity_started": {
          "description": "Start time, RFC 3339.",
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "description": "How long it took.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "agent": {
          "description": "The turn or agent that asked for it.",
          "type": [
            "string",
            "null"
          ]
        },
        "requested_by": {
          "description": "`user` or `model`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Verification": {
      "description": "Result of re-running an envelope.",
      "type": "object",
      "properties": {
        "recomputed_at": {
          "description": "When it was recomputed, RFC 3339; `None` until then.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "match": {
          "description": "Whether every value matched; `None` until recomputed.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "diff": {
          "description": "The values that changed; `null` reads as none.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ValueDiff"
          }
        }
      }
    },
    "ValueDiff": {
      "description": "A value that changed on recompute.",
      "type": "object",
      "properties": {
        "key": {
          "description": "Value key.",
          "type": "string"
        },
        "old": {
          "description": "Stored value; `None` when only the recompute has it.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "new": {
          "description": "Recomputed value; `None` when the recompute lost it.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "key"
      ]
    },
    "ComputedBody": {
      "description": "What a computed card draws, tagged by `type`.",
      "oneOf": [
        {
          "description": "Per-variable summary statistics.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "descriptive"
            }
          },
          "$ref": "#/$defs/DescriptiveBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A hypothesis test.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "test"
            }
          },
          "$ref": "#/$defs/TestBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A linear regression.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "regression"
            }
          },
          "$ref": "#/$defs/RegressionBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A correlation matrix.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "correlation"
            }
          },
          "$ref": "#/$defs/CorrelationBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A unit-checked calc sheet.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "calc_sheet"
            }
          },
          "$ref": "#/$defs/CalcSheetBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A unit conversion.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "quantity"
            }
          },
          "$ref": "#/$defs/QuantityBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "Histogram, density, box/violin, QQ and ECDF of one variable.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "distribution"
            }
          },
          "$ref": "#/$defs/DistributionBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A contingency table with residuals and a test of independence.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "contingency"
            }
          },
          "$ref": "#/$defs/ContingencyBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A power or sample-size calculation.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "power"
            }
          },
          "$ref": "#/$defs/PowerBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "An A/B test of two conversion rates.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ab_test"
            }
          },
          "$ref": "#/$defs/AbTestBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A bootstrap of one statistic.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bootstrap"
            }
          },
          "$ref": "#/$defs/BootstrapBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A time-series decomposition and forecast.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "forecast"
            }
          },
          "$ref": "#/$defs/ForecastBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A linear or mixed-integer program.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "optimization"
            }
          },
          "$ref": "#/$defs/OptimizationBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "An equation or a small system solved numerically.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "equations"
            }
          },
          "$ref": "#/$defs/EquationsBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A Monte Carlo simulation, tornado and Fermi estimate.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "simulation"
            }
          },
          "$ref": "#/$defs/SimulationBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A cash flow's NPV, IRR and MIRR.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cash_flow"
            }
          },
          "$ref": "#/$defs/CashFlowBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A weighted decision matrix.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "decision_matrix"
            }
          },
          "$ref": "#/$defs/DecisionMatrixBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A transfer function's Bode and Nyquist plots with its margins.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bode"
            }
          },
          "$ref": "#/$defs/BodeBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A Boolean function's Karnaugh map with minimal SOP and POS.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "karnaugh"
            }
          },
          "$ref": "#/$defs/KarnaughBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A beam's reactions, shear, moment and deflection.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "beam"
            }
          },
          "$ref": "#/$defs/BeamBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A tolerance stack-up: worst case, RSS and Monte Carlo.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tolerance"
            }
          },
          "$ref": "#/$defs/ToleranceBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A bill of materials costed line by line.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bom"
            }
          },
          "$ref": "#/$defs/BomBody",
          "required": [
            "type"
          ]
        }
      ]
    },
    "VariableSummary": {
      "description": "Summary of one variable.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "group": {
          "description": "Group value, when split by `by`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Numeric or categorical.",
          "$ref": "#/$defs/VariableKind"
        },
        "unit": {
          "description": "Unit of the values.",
          "type": [
            "string",
            "null"
          ]
        },
        "n": {
          "description": "Non-missing values.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "missing": {
          "description": "Missing values.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "mean": {
          "description": "Mean (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sd": {
          "description": "Sample standard deviation (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "median": {
          "description": "Median (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "q1": {
          "description": "First quartile (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "q3": {
          "description": "Third quartile (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "description": "Minimum (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "description": "Maximum (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "skew": {
          "description": "Sample skewness (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "kurtosis": {
          "description": "Excess kurtosis (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "histogram": {
          "description": "Distribution for the sparkline (numeric).",
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ]
        },
        "levels": {
          "description": "Counts per level (categorical), most frequent first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LevelCount"
          }
        }
      },
      "required": [
        "name",
        "kind",
        "n"
      ]
    },
    "VariableKind": {
      "description": "Measurement level of a variable.",
      "oneOf": [
        {
          "description": "Numbers.",
          "type": "string",
          "const": "numeric"
        },
        {
          "description": "Categories.",
          "type": "string",
          "const": "categorical"
        }
      ]
    },
    "Histogram": {
      "description": "Binned counts: `edges` has one more entry than `counts`.",
      "type": "object",
      "properties": {
        "edges": {
          "description": "Bin edges, ascending.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "counts": {
          "description": "Count per bin.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "required": [
        "edges",
        "counts"
      ]
    },
    "LevelCount": {
      "description": "Count of one level of a categorical variable.",
      "type": "object",
      "properties": {
        "level": {
          "description": "Level.",
          "type": "string"
        },
        "count": {
          "description": "Rows with this level.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "percent": {
          "description": "Share of non-missing rows, 0–100.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "level",
        "count",
        "percent"
      ]
    },
    "DescriptiveBody": {
      "description": "Body of a descriptive summary: one row per variable (and group).",
      "type": "object",
      "properties": {
        "by": {
          "description": "Grouping column (`by=`), when rows are split by group.",
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "description": "One summary per variable, or per variable and group.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableSummary"
          }
        }
      },
      "required": [
        "variables"
      ]
    },
    "TestKind": {
      "description": "A hypothesis test the engine runs.",
      "oneOf": [
        {
          "description": "Welch two-sample t-test (unequal variances).",
          "type": "string",
          "const": "welch_t"
        },
        {
          "description": "Student two-sample t-test (equal variances).",
          "type": "string",
          "const": "student_t"
        },
        {
          "description": "Paired t-test.",
          "type": "string",
          "const": "paired_t"
        },
        {
          "description": "One-sample t-test.",
          "type": "string",
          "const": "one_sample_t"
        },
        {
          "description": "Mann-Whitney U (Wilcoxon rank-sum).",
          "type": "string",
          "const": "mann_whitney"
        },
        {
          "description": "Wilcoxon signed-rank.",
          "type": "string",
          "const": "wilcoxon"
        },
        {
          "description": "Pearson χ² test of independence.",
          "type": "string",
          "const": "chi_square"
        },
        {
          "description": "Fisher's exact test, 2×2.",
          "type": "string",
          "const": "fisher"
        }
      ]
    },
    "Alternative": {
      "description": "Alternative hypothesis.",
      "oneOf": [
        {
          "description": "Different in either direction.",
          "type": "string",
          "const": "two_sided"
        },
        {
          "description": "First less than second.",
          "type": "string",
          "const": "less"
        },
        {
          "description": "First greater than second.",
          "type": "string",
          "const": "greater"
        }
      ]
    },
    "GroupSummary": {
      "description": "Summary of one group in a test.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Group name.",
          "type": "string"
        },
        "n": {
          "description": "Size.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mean": {
          "description": "Mean.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sd": {
          "description": "Standard deviation.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "median": {
          "description": "Median.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "name",
        "n"
      ]
    },
    "TestBody": {
      "description": "Body of a hypothesis test. The statistic, df, p and effect size are in\nthe envelope's `values` (`statistic`, `df`, `p_value`, `effect`).",
      "type": "object",
      "properties": {
        "test": {
          "description": "Which test ran.",
          "$ref": "#/$defs/TestKind"
        },
        "alternative": {
          "description": "Direction of the alternative hypothesis.",
          "$ref": "#/$defs/Alternative",
          "default": "two_sided"
        },
        "groups": {
          "description": "Per-group summary, in input order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupSummary"
          },
          "default": []
        },
        "observed": {
          "description": "Observed counts, for χ² and Fisher (rows × columns).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "expected": {
          "description": "Expected counts under independence, same shape as `observed`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "required": [
        "test"
      ]
    },
    "CoefficientRow": {
      "description": "One coefficient of a regression.",
      "type": "object",
      "properties": {
        "term": {
          "description": "Term, e.g. `(Intercept)`, `wt`.",
