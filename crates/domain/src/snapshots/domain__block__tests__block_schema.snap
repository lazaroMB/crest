          },
          "$ref": "#/$defs/TestBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A linear regression.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "regression"
            }
          },
          "$ref": "#/$defs/RegressionBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A correlation matrix.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "correlation"
            }
          },
          "$ref": "#/$defs/CorrelationBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A unit-checked calc sheet.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "calc_sheet"
            }
          },
          "$ref": "#/$defs/CalcSheetBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A unit conversion.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "quantity"
            }
          },
          "$ref": "#/$defs/QuantityBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "Histogram, density, box/violin, QQ and ECDF of one variable.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "distribution"
            }
          },
          "$ref": "#/$defs/DistributionBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A contingency table with residuals and a test of independence.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "contingency"
            }
          },
          "$ref": "#/$defs/ContingencyBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A power or sample-size calculation.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "power"
            }
          },
          "$ref": "#/$defs/PowerBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "An A/B test of two conversion rates.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ab_test"
            }
          },
          "$ref": "#/$defs/AbTestBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A bootstrap of one statistic.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bootstrap"
            }
          },
          "$ref": "#/$defs/BootstrapBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A time-series decomposition and forecast.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "forecast"
            }
          },
          "$ref": "#/$defs/ForecastBody",
          "required": [
            "type"
          ]
        },
        {
          "description": "A linear or mixed-integer program.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "optimization"
            }
          },
          "$ref": "#/$defs/OptimizationBody",
