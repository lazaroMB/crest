            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "residuals": {
          "description": "Residuals, aligned with `fitted`.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        }
      },
      "required": [
