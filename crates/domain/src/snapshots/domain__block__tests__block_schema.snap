          "description": "Durbin-Watson statistic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "jarque_bera": {
          "description": "Jarque-Bera statistic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "jarque_bera_p": {
          "description": "Jarque-Bera p-value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "breusch_pagan": {
          "description": "Breusch-Pagan statistic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "breusch_pagan_p": {
          "description": "Breusch-Pagan p-value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "condition_number": {
          "description": "Condition number of the design matrix.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max_vif": {
          "description": "Largest VIF.",
          "type": [
            "number",
            "null"
          ],
