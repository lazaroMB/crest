          "minimum": 0
        },
        "quantity": {
          "description": "Σ quantity, decimal.",
          "type": "string"
        },
        "total": {
          "description": "Σ extended cost of the priced lines, decimal.",
          "type": "string"
        },
        "missing_prices": {
          "description": "Lines without a price.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "lines",
        "quantity",
        "total",
        "missing_prices"
      ]
    },
    "BomBody": {
      "description": "Body of a BOM costing card.",
      "type": "object",
      "properties": {
        "currency": {
          "description": "Currency of the costs, shown only.",
          "type": [
            "string",
            "null"
          ]
        },
        "builds": {
          "description": "Units built, decimal (the totals are per unit and × this).",
          "type": "string"
        },
        "lines": {
          "description": "The lines in source order.",
