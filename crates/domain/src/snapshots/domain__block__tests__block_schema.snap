        },
        "quantity": {
          "description": "Quantity per unit built, decimal.",
          "type": "string"
        },
        "unit_cost": {
          "description": "Unit cost, decimal; `None` when the source has no price.",
          "type": [
            "string",
            "null"
          ]
        },
        "extended": {
          "description": "Quantity × unit cost, decimal.",
