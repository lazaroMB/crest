    "VariableSummary": {
      "description": "Summary of one variable.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "group": {
          "description": "Group value, when split by `by`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Numeric or categorical.",
          "$ref": "#/$defs/VariableKind"
        },
        "unit": {
          "description": "Unit of the values.",
          "type": [
            "string",
            "null"
          ]
        },
        "n": {
          "description": "Non-missing values.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "missing": {
          "description": "Missing values.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "mean": {
          "description": "Mean (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sd": {
          "description": "Sample standard deviation (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "median": {
          "description": "Median (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "q1": {
          "description": "First quartile (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "q3": {
          "description": "Third quartile (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "description": "Minimum (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "description": "Maximum (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "skew": {
          "description": "Sample skewness (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "kurtosis": {
          "description": "Excess kurtosis (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "histogram": {
          "description": "Distribution for the sparkline (numeric).",
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ]
        },
        "levels": {
          "description": "Counts per level (categorical), most frequent first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LevelCount"
          }
        }
      },
      "required": [
        "name",
        "kind",
        "n"
      ]
    },
    "VariableKind": {
      "description": "Measurement level of a variable.",
      "oneOf": [
        {
          "description": "Numbers.",
          "type": "string",
          "const": "numeric"
        },
        {
          "description": "Categories.",
          "type": "string",
          "const": "categorical"
        }
      ]
    },
    "Histogram": {
      "description": "Binned counts: `edges` has one more entry than `counts`.",
      "type": "object",
      "properties": {
        "edges": {
          "description": "Bin edges, ascending.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "counts": {
          "description": "Count per bin.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "required": [
        "edges",
        "counts"
      ]
    },
    "LevelCount": {
      "description": "Count of one level of a categorical variable.",
      "type": "object",
      "properties": {
        "level": {
          "description": "Level.",
          "type": "string"
        },
        "count": {
          "description": "Rows with this level.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "percent": {
          "description": "Share of non-missing rows, 0–100.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "level",
        "count",
        "percent"
      ]
    },
    "DescriptiveBody": {
      "description": "Body of a descriptive summary: one row per variable (and group).",
      "type": "object",
      "properties": {
        "by": {
          "description": "Grouping column (`by=`), when rows are split by group.",
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "description": "One summary per variable, or per variable and group.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableSummary"
          }
        }
      },
      "required": [
        "variables"
      ]
    },
    "TestKind": {
      "description": "A hypothesis test the engine runs.",
      "oneOf": [
        {
          "description": "Welch two-sample t-test (unequal variances).",
          "type": "string",
          "const": "welch_t"
        },
        {
          "description": "Student two-sample t-test (equal variances).",
          "type": "string",
          "const": "student_t"
        },
        {
          "description": "Paired t-test.",
          "type": "string",
          "const": "paired_t"
        },
        {
          "description": "One-sample t-test.",
          "type": "string",
          "const": "one_sample_t"
        },
        {
          "description": "Mann-Whitney U (Wilcoxon rank-sum).",
          "type": "string",
          "const": "mann_whitney"
        },
        {
          "description": "Wilcoxon signed-rank.",
          "type": "string",
          "const": "wilcoxon"
        },
        {
          "description": "Pearson χ² test of independence.",
          "type": "string",
          "const": "chi_square"
        },
        {
          "description": "Fisher's exact test, 2×2.",
          "type": "string",
          "const": "fisher"
        }
      ]
    },
    "Alternative": {
      "description": "Alternative hypothesis.",
      "oneOf": [
        {
          "description": "Different in either direction.",
          "type": "string",
          "const": "two_sided"
        },
        {
          "description": "First less than second.",
          "type": "string",
          "const": "less"
        },
        {
          "description": "First greater than second.",
          "type": "string",
          "const": "greater"
        }
      ]
    },
    "GroupSummary": {
      "description": "Summary of one group in a test.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Group name.",
          "type": "string"
        },
        "n": {
          "description": "Size.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mean": {
          "description": "Mean.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sd": {
          "description": "Standard deviation.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "median": {
          "description": "Median.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "name",
        "n"
      ]
    },
    "TestBody": {
      "description": "Body of a hypothesis test. The statistic, df, p and effect size are in\nthe envelope's `values` (`statistic`, `df`, `p_value`, `effect`).",
      "type": "object",
      "properties": {
        "test": {
          "description": "Which test ran.",
          "$ref": "#/$defs/TestKind"
        },
        "alternative": {
          "description": "Direction of the alternative hypothesis.",
          "$ref": "#/$defs/Alternative",
          "default": "two_sided"
        },
        "groups": {
          "description": "Per-group summary, in input order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupSummary"
          },
          "default": []
        },
        "observed": {
          "description": "Observed counts, for χ² and Fisher (rows × columns).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "expected": {
          "description": "Expected counts under independence, same shape as `observed`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "required": [
        "test"
      ]
    },
    "CoefficientRow": {
      "description": "One coefficient of a regression.",
      "type": "object",
      "properties": {
        "term": {
          "description": "Term, e.g. `(Intercept)`, `wt`.",
          "type": "string"
        },
        "estimate": {
          "description": "Estimate.",
          "type": "number",
          "format": "double"
        },
        "se": {
          "description": "Standard error.",
          "type": "number",
          "format": "double"
        },
        "t": {
          "description": "t statistic.",
          "type": "number",
          "format": "double"
        },
        "p": {
          "description": "Two-sided p-value.",
          "type": "number",
          "format": "double"
        },
        "ci_lo": {
          "description": "Lower interval bound.",
          "type": "number",
          "format": "double"
        },
        "ci_hi": {
          "description": "Upper interval bound.",
          "type": "number",
          "format": "double"
        },
        "std_beta": {
          "description": "Standardised coefficient.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "vif": {
          "description": "Variance inflation factor (not for the intercept).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "term",
        "estimate",
        "se",
        "t",
        "p",
        "ci_lo",
        "ci_hi"
      ]
    },
    "FitStats": {
      "description": "Goodness of fit of a regression.",
      "type": "object",
      "properties": {
        "n": {
          "description": "Observations used.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "r_squared": {
          "description": "R².",
          "type": "number",
          "format": "double"
        },
        "adj_r_squared": {
          "description": "Adjusted R².",
          "type": "number",
          "format": "double"
        },
        "f": {
          "description": "F statistic of the overall test.",
          "type": "number",
          "format": "double"
        },
        "df_model": {
          "description": "Model degrees of freedom.",
          "type": "number",
          "format": "double"
        },
        "df_resid": {
          "description": "Residual degrees of freedom.",
          "type": "number",
          "format": "double"
        },
        "f_p": {
          "description": "p-value of the F test.",
          "type": "number",
          "format": "double"
        },
        "sigma": {
          "description": "Residual standard error.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "aic": {
          "description": "Akaike information criterion.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "bic": {
          "description": "Bayesian information criterion.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "n",
        "r_squared",
        "adj_r_squared",
        "f",
        "df_model",
        "df_resid",
        "f_p"
      ]
    },
    "Diagnostics": {
      "description": "Residual diagnostics of a regression (the statsmodels footer).",
      "type": "object",
      "properties": {
