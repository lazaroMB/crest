---
source: crates/domain/src/computed.rs
expression: "schemars::schema_for!(ComputedBody)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComputedBody",
  "description": "What a computed card draws, tagged by `type`.",
  "oneOf": [
    {
      "description": "Per-variable summary statistics.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "descriptive"
        }
      },
      "$ref": "#/$defs/DescriptiveBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A hypothesis test.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "test"
        }
      },
      "$ref": "#/$defs/TestBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A linear regression.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "regression"
        }
      },
      "$ref": "#/$defs/RegressionBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A correlation matrix.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "correlation"
        }
      },
      "$ref": "#/$defs/CorrelationBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A unit-checked calc sheet.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "calc_sheet"
        }
      },
      "$ref": "#/$defs/CalcSheetBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A unit conversion.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "quantity"
        }
      },
      "$ref": "#/$defs/QuantityBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "Histogram, density, box/violin, QQ and ECDF of one variable.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "distribution"
        }
      },
      "$ref": "#/$defs/DistributionBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A contingency table with residuals and a test of independence.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "contingency"
        }
      },
      "$ref": "#/$defs/ContingencyBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A power or sample-size calculation.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "power"
        }
      },
      "$ref": "#/$defs/PowerBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "An A/B test of two conversion rates.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ab_test"
        }
      },
      "$ref": "#/$defs/AbTestBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A bootstrap of one statistic.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "bootstrap"
        }
      },
      "$ref": "#/$defs/BootstrapBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A time-series decomposition and forecast.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "forecast"
        }
      },
      "$ref": "#/$defs/ForecastBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A linear or mixed-integer program.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "optimization"
        }
      },
      "$ref": "#/$defs/OptimizationBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "An equation or a small system solved numerically.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "equations"
        }
      },
      "$ref": "#/$defs/EquationsBody",
      "required": [
        "type"
      ]
    },
    {
      "description": "A Monte Carlo simulation, tornado and Fermi estimate.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "simulation"
        }
      },
      "$ref": "#/$defs/SimulationBody",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "VariableSummary": {
      "description": "Summary of one variable.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "group": {
          "description": "Group value, when split by `by`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Numeric or categorical.",
          "$ref": "#/$defs/VariableKind"
        },
        "unit": {
          "description": "Unit of the values.",
          "type": [
            "string",
            "null"
          ]
        },
        "n": {
          "description": "Non-missing values.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "missing": {
          "description": "Missing values.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "mean": {
          "description": "Mean (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sd": {
          "description": "Sample standard deviation (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "median": {
          "description": "Median (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "q1": {
          "description": "First quartile (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "q3": {
          "description": "Third quartile (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "description": "Minimum (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "description": "Maximum (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "skew": {
          "description": "Sample skewness (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "kurtosis": {
          "description": "Excess kurtosis (numeric).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "histogram": {
          "description": "Distribution for the sparkline (numeric).",
          "anyOf": [
            {
              "$ref": "#/$defs/Histogram"
            },
            {
              "type": "null"
            }
          ]
        },
        "levels": {
          "description": "Counts per level (categorical), most frequent first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LevelCount"
          }
        }
      },
      "required": [
        "name",
        "kind",
        "n"
      ]
    },
    "VariableKind": {
      "description": "Measurement level of a variable.",
      "oneOf": [
        {
          "description": "Numbers.",
          "type": "string",
          "const": "numeric"
        },
        {
          "description": "Categories.",
          "type": "string",
          "const": "categorical"
        }
      ]
    },
    "Histogram": {
      "description": "Binned counts: `edges` has one more entry than `counts`.",
      "type": "object",
      "properties": {
        "edges": {
          "description": "Bin edges, ascending.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "counts": {
          "description": "Count per bin.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "required": [
        "edges",
        "counts"
      ]
    },
    "LevelCount": {
      "description": "Count of one level of a categorical variable.",
      "type": "object",
      "properties": {
        "level": {
          "description": "Level.",
          "type": "string"
        },
        "count": {
          "description": "Rows with this level.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "percent": {
          "description": "Share of non-missing rows, 0–100.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "level",
        "count",
        "percent"
      ]
    },
    "DescriptiveBody": {
      "description": "Body of a descriptive summary: one row per variable (and group).",
      "type": "object",
      "properties": {
        "by": {
          "description": "Grouping column (`by=`), when rows are split by group.",
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "description": "One summary per variable, or per variable and group.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableSummary"
          }
        }
      },
      "required": [
        "variables"
      ]
    },
    "TestKind": {
      "description": "A hypothesis test the engine runs.",
      "oneOf": [
        {
          "description": "Welch two-sample t-test (unequal variances).",
          "type": "string",
          "const": "welch_t"
        },
        {
          "description": "Student two-sample t-test (equal variances).",
          "type": "string",
          "const": "student_t"
        },
        {
          "description": "Paired t-test.",
          "type": "string",
          "const": "paired_t"
        },
        {
          "description": "One-sample t-test.",
          "type": "string",
          "const": "one_sample_t"
        },
        {
          "description": "Mann-Whitney U (Wilcoxon rank-sum).",
          "type": "string",
          "const": "mann_whitney"
        },
        {
          "description": "Wilcoxon signed-rank.",
          "type": "string",
          "const": "wilcoxon"
        },
        {
          "description": "Pearson χ² test of independence.",
          "type": "string",
          "const": "chi_square"
        },
        {
          "description": "Fisher's exact test, 2×2.",
          "type": "string",
          "const": "fisher"
        }
      ]
    },
    "Alternative": {
      "description": "Alternative hypothesis.",
      "oneOf": [
        {
          "description": "Different in either direction.",
          "type": "string",
          "const": "two_sided"
        },
        {
          "description": "First less than second.",
          "type": "string",
          "const": "less"
        },
        {
          "description": "First greater than second.",
          "type": "string",
          "const": "greater"
        }
      ]
    },
    "GroupSummary": {
      "description": "Summary of one group in a test.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Group name.",
          "type": "string"
        },
        "n": {
          "description": "Size.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mean": {
          "description": "Mean.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sd": {
          "description": "Standard deviation.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "median": {
          "description": "Median.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "name",
        "n"
      ]
    },
    "TestBody": {
      "description": "Body of a hypothesis test. The statistic, df, p and effect size are in\nthe envelope's `values` (`statistic`, `df`, `p_value`, `effect`).",
      "type": "object",
      "properties": {
        "test": {
          "description": "Which test ran.",
          "$ref": "#/$defs/TestKind"
        },
        "alternative": {
          "description": "Direction of the alternative hypothesis.",
          "$ref": "#/$defs/Alternative",
          "default": "two_sided"
        },
        "groups": {
          "description": "Per-group summary, in input order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupSummary"
          },
          "default": []
        },
        "observed": {
          "description": "Observed counts, for χ² and Fisher (rows × columns).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "expected": {
          "description": "Expected counts under independence, same shape as `observed`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "required": [
        "test"
      ]
    },
    "CoefficientRow": {
      "description": "One coefficient of a regression.",
      "type": "object",
      "properties": {
        "term": {
          "description": "Term, e.g. `(Intercept)`, `wt`.",
          "type": "string"
        },
        "estimate": {
          "description": "Estimate.",
          "type": "number",
          "format": "double"
        },
        "se": {
          "description": "Standard error.",
          "type": "number",
          "format": "double"
        },
        "t": {
          "description": "t statistic.",
          "type": "number",
          "format": "double"
        },
        "p": {
          "description": "Two-sided p-value.",
          "type": "number",
          "format": "double"
        },
        "ci_lo": {
          "description": "Lower interval bound.",
          "type": "number",
          "format": "double"
        },
        "ci_hi": {
          "description": "Upper interval bound.",
          "type": "number",
          "format": "double"
        },
        "std_beta": {
          "description": "Standardised coefficient.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "vif": {
          "description": "Variance inflation factor (not for the intercept).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "term",
        "estimate",
        "se",
        "t",
        "p",
        "ci_lo",
        "ci_hi"
      ]
    },
    "FitStats": {
      "description": "Goodness of fit of a regression.",
      "type": "object",
      "properties": {
        "n": {
          "description": "Observations used.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "r_squared": {
          "description": "R².",
          "type": "number",
          "format": "double"
        },
        "adj_r_squared": {
          "description": "Adjusted R².",
          "type": "number",
          "format": "double"
        },
        "f": {
          "description": "F statistic of the overall test.",
          "type": "number",
          "format": "double"
        },
        "df_model": {
          "description": "Model degrees of freedom.",
          "type": "number",
          "format": "double"
        },
        "df_resid": {
          "description": "Residual degrees of freedom.",
          "type": "number",
          "format": "double"
        },
        "f_p": {
          "description": "p-value of the F test.",
          "type": "number",
          "format": "double"
        },
        "sigma": {
          "description": "Residual standard error.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "aic": {
          "description": "Akaike information criterion.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "bic": {
          "description": "Bayesian information criterion.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "n",
        "r_squared",
        "adj_r_squared",
        "f",
        "df_model",
        "df_resid",
        "f_p"
      ]
    },
    "Diagnostics": {
      "description": "Residual diagnostics of a regression (the statsmodels footer).",
      "type": "object",
      "properties": {
        "durbin_watson": {
          "description": "Durbin-Watson statistic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "jarque_bera": {
          "description": "Jarque-Bera statistic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "jarque_bera_p": {
          "description": "Jarque-Bera p-value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "breusch_pagan": {
          "description": "Breusch-Pagan statistic.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "breusch_pagan_p": {
          "description": "Breusch-Pagan p-value.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "condition_number": {
          "description": "Condition number of the design matrix.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max_vif": {
          "description": "Largest VIF.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max_cooks_d": {
          "description": "Largest Cook's distance.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "RegressionBody": {
      "description": "Body of an OLS regression.",
      "type": "object",
      "properties": {
        "dependent": {
          "description": "Dependent variable.",
          "type": "string"
        },
        "ci_level": {
          "description": "Level of the coefficient intervals, e.g. `0.95`.",
          "type": "number",
          "format": "double"
        },
        "coefficients": {
          "description": "One row per term, intercept first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoefficientRow"
          }
        },
        "fit": {
          "description": "Goodness of fit.",
          "$ref": "#/$defs/FitStats"
        },
        "diagnostics": {
          "description": "Residual diagnostics.",
          "$ref": "#/$defs/Diagnostics",
          "default": {}
        },
        "fitted": {
          "description": "Fitted values, in row order (for residual plots).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "residuals": {
          "description": "Residuals, aligned with `fitted`.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        }
      },
      "required": [
        "dependent",
        "ci_level",
        "coefficients",
        "fit"
      ]
    },
    "CorrelationMethod": {
      "description": "Correlation coefficient.",
      "oneOf": [
        {
          "description": "Pearson's r.",
          "type": "string",
          "const": "pearson"
        },
        {
          "description": "Spearman's ρ.",
          "type": "string",
          "const": "spearman"
        },
        {
          "description": "Kendall's τ-b.",
          "type": "string",
          "const": "kendall"
        }
      ]
    },
    "PAdjust": {
      "description": "Multiple-comparison adjustment of p-values.",
      "oneOf": [
        {
          "description": "Raw p-values.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "Holm step-down.",
          "type": "string",
          "const": "holm"
        },
        {
          "description": "Benjamini-Hochberg false discovery rate.",
          "type": "string",
          "const": "bh"
        },
        {
          "description": "Bonferroni.",
          "type": "string",
          "const": "bonferroni"
        }
      ]
    },
    "CorrelationBody": {
      "description": "Body of a correlation matrix. `r`, `p` and `n` are square, one row and\ncolumn per variable; a `None` cell could not be computed.",
      "type": "object",
      "properties": {
        "method": {
          "description": "Coefficient.",
          "$ref": "#/$defs/CorrelationMethod"
        },
        "adjustment": {
          "description": "Multiple-comparison adjustment applied to `p`.",
          "$ref": "#/$defs/PAdjust",
          "default": "none"
        },
        "variables": {
          "description": "Variable names, the matrix order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "r": {
          "description": "Coefficients.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          }
        },
        "p": {
          "description": "Adjusted p-values; the diagonal is `None`.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          }
        },
        "n": {
          "description": "Pairwise complete observations.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "method",
        "variables",
        "r",
        "p",
        "n"
      ]
    },
    "CalcLine": {
      "description": "One line of a calc sheet, `name = expr`.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name later lines use; `None` for a bare expression.",
          "type": [
            "string",
            "null"
          ]
        },
        "expr": {
          "description": "Expression as written.",
          "type": "string"
        },
        "value": {
          "description": "Numeric value in `unit`; `None` on error or for non-numeric results.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "display": {
          "description": "The engine's rendering of the result, e.g. `9.81 m/s²`.",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "Unit of `value`.",
          "type": [
            "string",
            "null"
          ]
        },
        "latex": {
          "description": "LaTeX of the line, when the engine can produce it.",
          "type": [
            "string",
            "null"
          ]
        },
        "dimension": {
          "description": "Physical dimension of the result, e.g. `Length` or `Energy`;\n`None` for a plain number.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "Evaluation error, e.g. a dimension mismatch.",
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "description": "How the engine read an ambiguous name, e.g. `ton read as the metric\ntonne (1000 kg)`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "expr"
      ]
    },
    "CalcSheetBody": {
      "description": "Body of a calc sheet: lines evaluated in order.",
      "type": "object",
      "properties": {
        "lines": {
          "description": "Lines, in evaluation order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CalcLine"
          }
        }
      },
      "required": [
        "lines"
      ]
    },
    "Quantity": {
      "description": "A value with a unit.",
      "type": "object",
      "properties": {
        "value": {
          "description": "Magnitude.",
          "type": "number",
          "format": "double"
        },
        "unit": {
          "description": "Unit, e.g. `km/h`.",
          "type": "string"
        },
        "uncertainty": {
          "description": "Standard uncertainty of `value`, in `unit`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "value",
        "unit"
      ]
    },
    "ConversionStep": {
      "description": "One step of a conversion chain.",
      "type": "object",
      "properties": {
        "from_unit": {
          "description": "Unit converted from.",
          "type": "string"
        },
        "to_unit": {
          "description": "Unit converted to.",
          "type": "string"
        },
        "factor": {
          "description": "Multiplier of this step.",
          "type": "number",
          "format": "double"
        },
        "note": {
          "description": "E.g. `exact by definition (1959)`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from_unit",
        "to_unit",
        "factor"
      ]
    },
    "QuantityBody": {
      "description": "Body of a unit conversion.",
      "type": "object",
      "properties": {
        "from": {
          "description": "What was converted.",
          "$ref": "#/$defs/Quantity"
        },
        "to": {
          "description": "The result.",
          "$ref": "#/$defs/Quantity"
        },
        "factor": {
          "description": "Multiplier from `from.unit` to `to.unit` (for affine units like °C,\nthe slope).",
          "type": "number",
          "format": "double"
        },
        "exact": {
          "description": "Whether the factor is exact by definition (inch → mm) rather than\nrounded.",
          "type": "boolean"
        },
        "dimension": {
          "description": "Physical dimension, e.g. `length`, `energy / time`.",
          "type": "string"
        },
        "chain": {
          "description": "Steps through base units, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConversionStep"
          },
          "default": []
        }
      },
      "required": [
        "from",
        "to",
        "factor",
        "exact",
        "dimension"
      ]
    },
    "BinRule": {
      "description": "How the histogram bins were chosen.",
      "oneOf": [
        {
          "description": "Freedman-Diaconis: width 2·IQR·n^(−1/3) (Sturges when the IQR is 0).",
          "type": "string",
          "const": "freedman_diaconis"
        },
        {
          "description": "Sturges: ⌈log₂ n⌉ + 1 bins.",
          "type": "string",
          "const": "sturges"
        },
        {
          "description": "Scott: width 3.49·SD·n^(−1/3).",
          "type": "string",
          "const": "scott"
        },
        {
          "description": "A bin count given in the request.",
          "type": "string",
          "const": "fixed"
        }
      ]
    },
    "BandwidthRule": {
      "description": "How the kernel bandwidth was chosen.",
      "oneOf": [
        {
          "description": "Silverman's rule of thumb, 0.9·min(SD, IQR/1.34)·n^(−1/5) (R's\n`bw.nrd0`).",
          "type": "string",
          "const": "silverman"
        },
        {
          "description": "Scott's rule, 1.06·min(SD, IQR/1.34)·n^(−1/5) (R's `bw.nrd`).",
          "type": "string",
          "const": "scott"
        },
        {
          "description": "A bandwidth given in the request.",
          "type": "string",
          "const": "fixed"
        }
      ]
    },
    "DistributionGroup": {
      "description": "The distribution of one group.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Group value; `None` without `by`.",
          "type": [
            "string",
            "null"
          ]
        },
        "n": {
          "description": "Non-missing values.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "histogram": {
          "description": "Binned counts.",
          "$ref": "#/$defs/Histogram"
        },
        "kde": {
          "description": "Gaussian kernel density estimate.",
          "$ref": "#/$defs/Curve"
        },
        "bandwidth": {
          "description": "Kernel bandwidth.",
          "type": "number",
          "format": "double"
        },
        "boxplot": {
          "description": "Box-plot summary.",
          "$ref": "#/$defs/BoxSummary"
        },
        "qq": {
          "description": "Normal QQ points, in ascending order of the sample.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/QqPoint"
          },
          "default": []
        },
        "ecdf": {
          "description": "Steps of the empirical CDF: at `x` it rises to `p`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EcdfStep"
          },
          "default": []
        },
        "dkw_epsilon": {
          "description": "Half-width of the Dvoretzky-Kiefer-Wolfowitz band around the ECDF.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "n",
        "histogram",
        "kde",
        "bandwidth",
        "boxplot",
        "dkw_epsilon"
      ]
    },
    "Curve": {
      "description": "A curve as matching x and y coordinates.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Abscissas, ascending.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "y": {
          "description": "Ordinates, one per abscissa.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "BoxSummary": {
      "description": "The five numbers of a Tukey box plot (as R's `boxplot.stats`), plus\nthe points outside.",
      "type": "object",
      "properties": {
        "lower_hinge": {
          "description": "Lower hinge (Tukey's, as `fivenum`).",
          "type": "number",
          "format": "double"
        },
        "median": {
          "description": "Median.",
          "type": "number",
          "format": "double"
        },
        "upper_hinge": {
          "description": "Upper hinge.",
          "type": "number",
          "format": "double"
        },
        "whisker_lo": {
          "description": "Smallest value within 1.5 hinge spreads below the lower hinge.",
          "type": "number",
          "format": "double"
        },
        "whisker_hi": {
          "description": "Largest value within 1.5 hinge spreads above the upper hinge.",
          "type": "number",
          "format": "double"
        },
        "outliers": {
          "description": "Values beyond the whiskers, ascending.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        }
      },
      "required": [
        "lower_hinge",
        "median",
        "upper_hinge",
        "whisker_lo",
        "whisker_hi"
      ]
    },
    "QqPoint": {
      "description": "One point of a normal QQ plot with its pointwise band.",
      "type": "object",
      "properties": {
        "theoretical": {
          "description": "Standard normal quantile of the plotting position.",
          "type": "number",
          "format": "double"
        },
        "sample": {
          "description": "The sample value (an order statistic).",
          "type": "number",
          "format": "double"
        },
        "lo": {
          "description": "Lower band bound for this order statistic under the fitted normal.",
          "type": "number",
          "format": "double"
        },
        "hi": {
          "description": "Upper band bound.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "theoretical",
        "sample",
        "lo",
        "hi"
      ]
    },
    "EcdfStep": {
      "description": "One step of an empirical CDF.",
      "type": "object",
      "properties": {
        "x": {
          "description": "A distinct sample value.",
          "type": "number",
          "format": "double"
        },
        "p": {
          "description": "Share of values ≤ `x`.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "p"
      ]
    },
    "DistributionBody": {
      "description": "Body of a distribution card.",
      "type": "object",
      "properties": {
        "variable": {
          "description": "The variable described.",
          "type": "string"
        },
        "unit": {
          "description": "Its unit.",
          "type": [
            "string",
            "null"
          ]
        },
        "by": {
          "description": "Grouping column, when split by group.",
          "type": [
            "string",
            "null"
          ]
        },
        "bin_rule": {
          "description": "How the bins were chosen.",
          "$ref": "#/$defs/BinRule"
        },
        "bin_width": {
          "description": "Width of every bin.",
          "type": "number",
          "format": "double"
        },
        "bandwidth_rule": {
          "description": "How the kernel bandwidths were chosen.",
          "$ref": "#/$defs/BandwidthRule"
        },
        "conf_level": {
          "description": "Coverage of the QQ and ECDF bands, e.g. `0.95`.",
          "type": "number",
          "format": "double"
        },
        "groups": {
          "description": "One entry per group (one in all when there is no `by`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DistributionGroup"
          }
        }
      },
      "required": [
        "variable",
        "bin_rule",
        "bin_width",
        "bandwidth_rule",
        "conf_level",
        "groups"
      ]
    },
    "ContingencyTest": {
      "description": "The test of independence the engine ran.",
      "oneOf": [
        {
          "description": "Pearson's χ² (with Yates' correction on a 2×2 table when asked).",
          "type": "string",
          "const": "chi_square"
        },
        {
          "description": "Fisher's exact test, by full enumeration of the tables with the\nobserved margins.",
          "type": "string",
          "const": "fisher_exact"
        },
        {
          "description": "Fisher's test with a Monte Carlo p-value (too many tables to\nenumerate), as R's `simulate.p.value`.",
          "type": "string",
          "const": "fisher_simulated"
        }
      ]
    },
    "ContingencyBody": {
      "description": "Body of a contingency-table card. Every matrix is rows × columns in the\norder of the level lists.",
      "type": "object",
      "properties": {
        "row_variable": {
          "description": "Row variable, when built from data.",
          "type": [
            "string",
            "null"
          ]
        },
        "column_variable": {
          "description": "Column variable, when built from data.",
          "type": [
            "string",
            "null"
          ]
        },
        "row_levels": {
          "description": "Row labels.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "column_levels": {
          "description": "Column labels.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed": {
          "description": "Observed counts.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "expected": {
          "description": "Expected counts under independence.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "row_percent": {
          "description": "Each cell as a percentage of its row, 0–100.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "column_percent": {
          "description": "Each cell as a percentage of its column, 0–100.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "std_residuals": {
          "description": "Adjusted standardised residuals (R's `stdres`): about N(0, 1)\nunder independence, so |r| > 2 marks a cell that departs from it.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "test": {
          "description": "The test that produced the p-value.",
          "$ref": "#/$defs/ContingencyTest"
        }
      },
      "required": [
        "row_levels",
        "column_levels",
        "observed",
        "expected",
        "row_percent",
        "column_percent",
        "std_residuals",
        "test"
      ]
    },
    "PowerTest": {
      "description": "The design a power analysis is for.",
      "oneOf": [
        {
          "description": "Two-sample t-test, equal groups; effect Cohen's d.",
          "type": "string",
          "const": "two_sample_t"
        },
        {
          "description": "One-sample t-test; effect Cohen's d.",
          "type": "string",
          "const": "one_sample_t"
        },
        {
          "description": "Paired t-test; effect d of the differences.",
          "type": "string",
          "const": "paired_t"
        },
        {
          "description": "One-way ANOVA with `groups` equal groups; effect Cohen's f.",
          "type": "string",
          "const": "anova"
        },
        {
          "description": "Two proportions, equal groups; effect Cohen's h.",
          "type": "string",
          "const": "two_proportions"
        },
        {
          "description": "One proportion against a null value; effect Cohen's h.",
          "type": "string",
          "const": "one_proportion"
        }
      ]
    },
    "PowerTarget": {
      "description": "The quantity a power analysis solved for.",
      "oneOf": [
        {
          "description": "Sample size (per group where the design has groups).",
          "type": "string",
          "const": "n"
        },
        {
          "description": "Power, 1 − β.",
          "type": "string",
          "const": "power"
        },
        {
          "description": "The smallest effect detectable.",
          "type": "string",
          "const": "effect"
        },
        {
          "description": "Significance level.",
          "type": "string",
          "const": "alpha"
        }
      ]
    },
    "PowerBody": {
      "description": "Body of a power card.",
      "type": "object",
      "properties": {
        "test": {
          "description": "The design.",
          "$ref": "#/$defs/PowerTest"
        },
        "solved_for": {
          "description": "What was solved for; the other three were given.",
          "$ref": "#/$defs/PowerTarget"
        },
        "alternative": {
          "description": "Direction of the alternative.",
          "$ref": "#/$defs/Alternative"
        },
        "n": {
          "description": "Sample size (per group when [`PowerTest::n_per_group`]), unrounded.",
          "type": "number",
          "format": "double"
        },
        "effect": {
          "description": "Effect size (`d`, `f` or `h`).",
          "type": "number",
          "format": "double"
        },
        "alpha": {
          "description": "Significance level.",
          "type": "number",
          "format": "double"
        },
        "power": {
          "description": "Power, 1 − β.",
          "type": "number",
          "format": "double"
        },
        "groups": {
          "description": "Number of groups (ANOVA).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "curve": {
          "description": "Power (y) against n (x) at the effect and α above.",
          "$ref": "#/$defs/Curve"
        }
      },
      "required": [
        "test",
        "solved_for",
        "alternative",
        "n",
        "effect",
        "alpha",
        "power",
        "curve"
      ]
    },
    "AbArm": {
      "description": "One arm of an A/B test.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Arm name, e.g. `A`.",
          "type": "string"
        },
        "visitors": {
          "description": "Units exposed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "conversions": {
          "description": "Units that converted.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rate": {
          "description": "Conversion rate, a fraction.",
          "type": "number",
          "format": "double"
        },
        "rate_lo": {
          "description": "Wilson interval of the rate: lower bound.",
          "type": "number",
          "format": "double"
        },
        "rate_hi": {
          "description": "Wilson interval of the rate: upper bound.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "name",
        "visitors",
        "conversions",
        "rate",
        "rate_lo",
        "rate_hi"
      ]
    },
    "AbMethod": {
      "description": "The test behind an A/B card's p-value.",
      "oneOf": [
        {
          "description": "Two-proportion z-test with the pooled rate (R's `prop.test(...,\ncorrect = FALSE)`).",
          "type": "string",
          "const": "z_test"
        },
        {
          "description": "Fisher's exact test, for small counts.",
          "type": "string",
          "const": "fisher_exact"
        }
      ]
    },
    "AbTestBody": {
      "description": "Body of an A/B test card.",
      "type": "object",
      "properties": {
        "arms": {
          "description": "Control first, then treatment.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AbArm"
          }
        },
        "expected_split": {
          "description": "The share of visitors meant for the treatment, e.g. 0.5.",
          "type": "number",
          "format": "double"
        },
        "conf_level": {
          "description": "Level of the intervals.",
          "type": "number",
          "format": "double"
        },
        "method": {
          "description": "The test behind the p-value.",
          "$ref": "#/$defs/AbMethod"
        },
        "looks": {
          "description": "How often the results were looked at (1 = once, at the end).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sample_ratio_mismatch": {
          "description": "Whether the visitor split departs from `expected_split` (SRM χ²\np < .001).",
          "type": "boolean"
        }
      },
      "required": [
        "arms",
        "expected_split",
        "conf_level",
        "method",
        "looks",
        "sample_ratio_mismatch"
      ]
    },
    "BootStatistic": {
      "description": "The statistic a bootstrap resamples.",
      "oneOf": [
        {
          "description": "Mean of `y`.",
          "type": "string",
          "const": "mean"
        },
        {
          "description": "Median of `y`.",
          "type": "string",
          "const": "median"
        },
        {
          "description": "Standard deviation of `y`.",
          "type": "string",
          "const": "sd"
        },
        {
          "description": "Mean of `y` without the lowest and highest `trim` share.",
          "type": "string",
          "const": "trimmed_mean"
        },
        {
          "description": "Mean of the first group minus the mean of the second.",
          "type": "string",
          "const": "mean_difference"
        },
        {
          "description": "Median of the first group minus the median of the second.",
          "type": "string",
          "const": "median_difference"
        },
        {
          "description": "Pearson correlation of `y` and `y2` (pairs resampled).",
          "type": "string",
          "const": "correlation"
        }
      ]
    },
    "BootInterval": {
      "description": "One bootstrap interval.",
      "type": "object",
      "properties": {
        "method": {
          "description": "How it was formed.",
          "$ref": "#/$defs/BootMethod"
        },
        "lo": {
          "description": "Lower bound.",
          "type": "number",
          "format": "double"
        },
        "hi": {
          "description": "Upper bound.",
          "type": "number",
          "format": "double"
        },
        "lo_mcse": {
          "description": "Monte Carlo SE of the lower bound, when the method has one.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "hi_mcse": {
          "description": "Monte Carlo SE of the upper bound.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "method",
        "lo",
        "hi"
      ]
    },
    "BootMethod": {
      "description": "How a bootstrap interval was formed.",
      "oneOf": [
        {
          "description": "Quantiles of the replicates.",
          "type": "string",
          "const": "percentile"
        },
        {
          "description": "Bias-corrected and accelerated quantiles (Efron 1987).",
          "type": "string",
          "const": "bca"
        },
        {
          "description": "Basic (reverse percentile): 2θ̂ minus the quantiles.",
          "type": "string",
          "const": "basic"
        },
        {
          "description": "θ̂ − bias ± z·SE.",
          "type": "string",
          "const": "normal"
        }
      ]
    },
    "BootstrapBody": {
      "description": "Body of a bootstrap card.",
      "type": "object",
      "properties": {
        "statistic": {
          "description": "What was resampled.",
          "$ref": "#/$defs/BootStatistic"
        },
        "variable": {
          "description": "The variable (and the second variable or the groups).",
          "type": "string"
        },
        "versus": {
          "description": "Second variable or the two groups, e.g. `am: 1 − 0`.",
          "type": [
            "string",
            "null"
          ]
        },
        "observed": {
          "description": "The statistic on the data.",
          "type": "number",
          "format": "double"
        },
        "resamples": {
          "description": "Number of resamples.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "conf_level": {
          "description": "Level of the intervals.",
          "type": "number",
          "format": "double"
        },
        "histogram": {
          "description": "Distribution of the replicates.",
          "$ref": "#/$defs/Histogram"
        },
        "intervals": {
          "description": "The intervals, percentile and BCa first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BootInterval"
          }
        },
        "z0": {
          "description": "BCa bias correction z₀.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "acceleration": {
          "description": "BCa acceleration a (jackknife).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "statistic",
        "variable",
        "observed",
        "resamples",
        "conf_level",
        "histogram",
        "intervals"
      ]
    },
    "SeasonalComponent": {
      "description": "One seasonal component of a decomposition.",
      "type": "object",
      "properties": {
        "period": {
          "description": "Its period, in observations.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "values": {
          "description": "One value per observation.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "period",
        "values"
      ]
    },
    "Holdout": {
      "description": "The forecast of the held-out tail by a model fitted without it.",
      "type": "object",
      "properties": {
        "start": {
          "description": "Index of the first held-out observation.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "predicted": {
          "description": "The forecast of the held-out observations.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "start",
        "predicted"
      ]
    },
    "ForecastBody": {
      "description": "Body of a forecast card. The forecast continues the series' indices\nat `values.len()`, `values.len() + 1`, …",
      "type": "object",
      "properties": {
        "variable": {
          "description": "The variable.",
          "type": "string"
        },
        "time": {
          "description": "Time labels of the observations, when the data had a time column.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "description": "The model, e.g. `MSTL (periods 12) + AutoETS trend`.",
          "type": "string"
        },
        "values": {
          "description": "The observations.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "trend": {
          "description": "Trend of the decomposition (empty without seasonal periods).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "seasonal": {
          "description": "Seasonal components, one per period.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeasonalComponent"
          },
          "default": []
        },
        "remainder": {
          "description": "Remainder of the decomposition.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "forecast": {
          "description": "Point forecasts.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "lo80": {
          "description": "80% interval, lower bounds.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "hi80": {
          "description": "80% interval, upper bounds.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "lo95": {
          "description": "95% interval, lower bounds.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "hi95": {
          "description": "95% interval, upper bounds.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "holdout": {
          "description": "The hold-out check, when one ran.",
          "anyOf": [
            {
              "$ref": "#/$defs/Holdout"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "variable",
        "model",
        "values",
        "forecast",
        "lo80",
        "hi80",
        "lo95",
        "hi95"
      ]
    },
    "Sense": {
      "description": "Direction of the objective.",
      "oneOf": [
        {
          "description": "Largest objective.",
          "type": "string",
          "const": "maximize"
        },
        {
          "description": "Smallest objective.",
          "type": "string",
          "const": "minimize"
        }
      ]
    },
    "OptimizationStatus": {
      "description": "How a solve ended.",
      "oneOf": [
        {
          "description": "Proven optimal.",
          "type": "string",
          "const": "optimal"
        },
        {
          "description": "A feasible point, optimality not proven (node limit reached).",
          "type": "string",
          "const": "feasible"
        },
        {
          "description": "No point satisfies every constraint.",
          "type": "string",
          "const": "infeasible"
        },
        {
          "description": "The objective improves without limit.",
          "type": "string",
          "const": "unbounded"
        },
        {
          "description": "Stopped before any feasible point was found.",
          "type": "string",
          "const": "stopped"
        }
      ]
    },
    "OptVariable": {
      "description": "One decision variable.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "value": {
          "description": "Value at the solution.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "lower": {
          "description": "Lower bound (`None` = −∞).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "upper": {
          "description": "Upper bound (`None` = +∞).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "integer": {
          "description": "Whether it must be a whole number.",
          "type": "boolean",
          "default": false
        },
        "objective_coefficient": {
          "description": "Its coefficient in the objective.",
          "type": "number",
          "format": "double"
        },
        "reduced_cost": {
          "description": "Change of the objective per unit the variable is forced up (0 for a\nvariable strictly between its bounds).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "name",
        "objective_coefficient"
      ]
    },
    "OptConstraint": {
      "description": "One linear constraint.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "expr": {
          "description": "The constraint as written.",
          "type": "string"
        },
        "coefficients": {
          "description": "Coefficient of each variable (in variable order) after moving every\nvariable term to the left.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "op": {
          "description": "Comparison.",
          "$ref": "#/$defs/ConstraintOp"
        },
        "rhs": {
          "description": "Right-hand side after moving every variable term to the left.",
          "type": "number",
          "format": "double"
        },
        "activity": {
          "description": "Value of the left-hand side at the solution.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "slack": {
          "description": "How far it is from binding (≥ 0 when satisfied).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "binding": {
          "description": "Whether it holds with equality.",
          "type": "boolean",
          "default": false
        },
        "dual": {
          "description": "Shadow price: change of the objective per unit increase of `rhs`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "name",
        "expr",
        "op",
        "rhs"
      ]
    },
    "ConstraintOp": {
      "description": "A comparison of a linear constraint.",
      "oneOf": [
        {
          "description": "`≤`.",
          "type": "string",
          "const": "le"
        },
        {
          "description": "`≥`.",
          "type": "string",
          "const": "ge"
        },
        {
          "description": "`=`.",
          "type": "string",
          "const": "eq"
        }
      ]
    },
    "OptimizationBody": {
      "description": "Body of an optimisation card.",
      "type": "object",
      "properties": {
        "sense": {
          "description": "Direction.",
          "$ref": "#/$defs/Sense"
        },
        "objective_expr": {
          "description": "The objective as written.",
          "type": "string"
        },
        "status": {
          "description": "How the solve ended.",
          "$ref": "#/$defs/OptimizationStatus"
        },
        "objective": {
          "description": "Objective value at the solution.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "integer": {
          "description": "Whether some variables are integer (a MILP).",
          "type": "boolean",
          "default": false
        },
        "mip_gap": {
          "description": "Relative gap between the solution and the best bound (MILP).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "variables": {
          "description": "The variables, in request order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptVariable"
          }
        },
        "constraints": {
          "description": "The constraints, in request order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptConstraint"
          }
        }
      },
      "required": [
        "sense",
        "objective_expr",
        "status",
        "variables",
        "constraints"
      ]
    },
    "SolveMethod": {
      "description": "How the solver searched.",
      "oneOf": [
        {
          "description": "Damped Newton with a finite-difference Jacobian, from a guess.",
          "type": "string",
          "const": "newton"
        },
        {
          "description": "Sign changes scanned on a grid over a range, each refined by\nbisection (one unknown).",
          "type": "string",
          "const": "bracket_scan"
        }
      ]
    },
    "SolvedUnknown": {
      "description": "One unknown at the solution.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "value": {
          "description": "Value (the first root of a scan).",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "PlugBack": {
      "description": "One equation evaluated at the solution.",
      "type": "object",
      "properties": {
        "equation": {
          "description": "The equation as written.",
          "type": "string"
        },
        "lhs": {
          "description": "Its left-hand side at the solution.",
          "type": "number",
          "format": "double"
        },
        "rhs": {
          "description": "Its right-hand side at the solution.",
          "type": "number",
          "format": "double"
        },
        "residual": {
          "description": "`lhs − rhs`.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "equation",
        "lhs",
        "rhs",
        "residual"
      ]
    },
    "EquationsBody": {
      "description": "Body of an equation-solver card.",
      "type": "object",
      "properties": {
        "method": {
          "description": "How the solver searched.",
          "$ref": "#/$defs/SolveMethod"
        },
        "converged": {
          "description": "Whether it met the tolerance.",
          "type": "boolean"
        },
        "unknowns": {
          "description": "The unknowns at the solution.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SolvedUnknown"
          }
        },
        "roots": {
          "description": "Every root found in the range (bracket scan).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "plug_back": {
          "description": "The equations at the solution.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlugBack"
          }
        },
        "residual_norm": {
          "description": "Largest |residual|.",
          "type": "number",
          "format": "double"
        },
        "iterations": {
          "description": "Iterations used (Newton steps or bisection halvings in total).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tolerance": {
          "description": "Tolerance on the residuals.",
          "type": "number",
          "format": "double"
        },
        "condition_number": {
          "description": "Condition number of the Jacobian at the solution (Newton).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "curve": {
          "description": "`lhs − rhs` over the range, for one unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/Curve"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "method",
        "converged",
        "unknowns",
        "plug_back",
        "residual_norm",
        "iterations",
        "tolerance"
      ]
    },
    "SimInputSummary": {
      "description": "One input as simulated.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "distribution": {
          "description": "Its distribution in words, e.g. `lognormal, 90% in [2, 8]`.",
          "type": "string"
        },
        "p10": {
          "description": "10th percentile of the distribution.",
          "type": "number",
          "format": "double"
        },
        "p50": {
          "description": "Median.",
          "type": "number",
          "format": "double"
        },
        "p90": {
          "description": "90th percentile.",
          "type": "number",
          "format": "double"
        },
        "source": {
          "description": "Where the estimate comes from.",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "Unit.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "distribution",
        "p10",
        "p50",
        "p90"
      ]
    },
    "TornadoBar": {
      "description": "One bar of the tornado: the output with one input at its 10th and 90th\npercentiles, the others at their medians.",
      "type": "object",
      "properties": {
        "input": {
          "description": "The input moved.",
          "type": "string"
        },
        "at_p10": {
          "description": "Output at the input's 10th percentile.",
          "type": "number",
          "format": "double"
        },
        "at_p90": {
          "description": "Output at its 90th percentile.",
          "type": "number",
          "format": "double"
        },
        "swing": {
          "description": "|at_p90 − at_p10|.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "input",
        "at_p10",
        "at_p90",
        "swing"
      ]
    },
    "SimulationBody": {
      "description": "Body of a Monte Carlo card.",
      "type": "object",
      "properties": {
        "output": {
          "description": "Name of the output.",
          "type": "string"
        },
        "unit": {
          "description": "Its unit.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "The model, e.g. `price * volume - cost`.",
          "type": "string"
        },
        "fermi": {
          "description": "Whether the output is the product of the inputs (a Fermi estimate).",
          "type": "boolean",
          "default": false
        },
        "samples": {
          "description": "Draws.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "inputs": {
          "description": "The inputs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SimInputSummary"
          }
        },
        "histogram": {
          "description": "Distribution of the output.",
          "$ref": "#/$defs/Histogram"
        },
        "convergence": {
          "description": "The running mean (y) after n draws (x).",
          "$ref": "#/$defs/Curve"
        },
        "convergence_mcse": {
          "description": "Monte Carlo SE of the running mean at each point of `convergence`.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "default": []
        },
        "base": {
          "description": "The output with every input at its median.",
          "type": "number",
          "format": "double"
        },
        "tornado": {
          "description": "Tornado bars, largest swing first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TornadoBar"
          },
          "default": []
        }
      },
      "required": [
        "output",
        "model",
        "samples",
        "inputs",
        "histogram",
        "convergence",
        "base"
      ]
    }
  }
}
