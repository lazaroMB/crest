---
source: crates/domain/src/block.rs
expression: "schemars::schema_for!(CustomNode)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CustomNode",
  "description": "Declarative UI primitive of a `Custom` block, tagged by `type`.\n\nLua never touches GPUI: plugins return this tree and the UI turns it\ninto components.",
  "oneOf": [
    {
      "description": "Plain text.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "description": "The text.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    {
      "description": "Children laid out horizontally.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "row"
        },
        "children": {
          "description": "Child nodes.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "type",
        "children"
      ]
    },
    {
      "description": "Children laid out vertically.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "col"
        },
        "children": {
          "description": "Child nodes.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "type",
        "children"
      ]
    },
    {
      "description": "A bulleted list.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "list"
        },
        "items": {
          "description": "One node per item.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "type",
        "items"
      ]
    },
    {
      "description": "A table.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "table"
        }
      },
      "$ref": "#/$defs/TableSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A chart.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chart"
        }
      },
      "$ref": "#/$defs/ChartSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A code snippet.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "code"
        },
        "lang": {
          "description": "Language for highlighting.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Source code.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "Rendered markdown.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "markdown"
        },
        "source": {
          "description": "Markdown source.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A picture, from a file or inline bytes, with zoom and pan.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "source": {
          "description": "Inline bytes or a file. A file must be inside the workspace and\nnot sensitive; the app replaces a rejected one with a text node.",
          "$ref": "#/$defs/ImageData"
        },
        "media_type": {
          "description": "MIME type, e.g. `image/png`; required for inline bytes.",
          "type": [
            "string",
            "null"
          ]
        },
        "alt": {
          "description": "Text shown when the image cannot be drawn.",
          "type": [
            "string",
            "null"
          ]
        },
        "fit": {
          "description": "How the image is sized at first.",
          "$ref": "#/$defs/ImageFit",
          "default": "contain"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A basic HTML subset (headings, paragraphs, lists, tables, links,\nemphasis, code), drawn natively; no CSS layout and no scripts.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "html"
        },
        "source": {
          "description": "HTML source.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A JSON value as a collapsible tree.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "json"
        },
        "value": {
          "description": "The value."
        },
        "expand_depth": {
          "description": "Levels expanded at first (0 shows only the root collapsed).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    {
      "description": "A Mermaid diagram, with pan and zoom.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "mermaid"
        },
        "source": {
          "description": "Mermaid source.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A link that opens in the user's browser.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "link"
        },
        "text": {
          "description": "Text shown.",
          "type": "string"
        },
        "url": {
          "description": "Address; `http`, `https` or `mailto` only.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text",
        "url"
      ]
    },
    {
      "description": "A colored unified diff.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "diff"
        },
        "unified": {
          "description": "Unified diff text.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "unified"
      ]
    }
  ],
  "$defs": {
    "Column": {
      "description": "A table column header.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Header text.",
          "type": "string"
        },
        "align": {
          "description": "Horizontal alignment; the UI picks one when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/Align"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "Align": {
      "description": "Horizontal alignment of a column.",
      "oneOf": [
        {
          "description": "Left aligned.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Centered.",
          "type": "string",
          "const": "center"
        },
        {
          "description": "Right aligned.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "Cell": {
      "description": "A table cell: a plain JSON scalar.",
      "anyOf": [
        {
          "description": "Empty cell (`null`).",
          "type": "null"
        },
        {
          "description": "Boolean.",
          "type": "boolean"
        },
        {
          "description": "Number.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "Text.",
          "type": "string"
        }
      ]
    },
    "TableSpec": {
      "description": "A table: named columns and rows of cells.",
      "type": "object",
      "properties": {
        "columns": {
          "description": "Column headers, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "rows": {
          "description": "Rows; each must have one cell per column.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Cell"
            }
          }
        }
      },
      "required": [
        "columns",
        "rows"
      ]
    },
    "ChartKind": {
      "description": "How a chart is drawn.",
      "oneOf": [
        {
          "description": "Vertical bars.",
          "type": "string",
          "const": "bar"
        },
        {
          "description": "Lines.",
          "type": "string",
          "const": "line"
        },
        {
          "description": "Filled areas.",
          "type": "string",
          "const": "area"
        },
        {
          "description": "Pie; takes exactly one series.",
          "type": "string",
          "const": "pie"
        }
      ]
    },
    "Series": {
      "description": "A named series of values, one per chart label.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Legend name.",
          "type": "string"
        },
        "values": {
          "description": "Values, aligned with the chart labels.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "name",
        "values"
      ]
    },
    "ChartSpec": {
      "description": "A chart: labels on one axis and one or more numeric series.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Chart title.",
          "type": "string"
        },
        "kind": {
          "description": "How the series are drawn.",
          "$ref": "#/$defs/ChartKind"
        },
        "labels": {
          "description": "Category labels, one per value of each series.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Data series.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Series"
          }
        }
      },
      "required": [
        "title",
        "kind",
        "labels",
        "series"
      ]
    },
    "ImageData": {
      "description": "Bytes of an image block, tagged by `type`.",
      "oneOf": [
        {
          "description": "Inline, base64 encoded.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "base64"
            },
            "data": {
              "description": "Base64 payload.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A file on disk.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "path"
            },
            "path": {
              "description": "File path.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ]
        }
      ]
    },
    "ImageFit": {
      "description": "How an [`CustomNode::Image`] is sized before the user zooms.",
      "oneOf": [
        {
          "description": "Natural size, scaled down to the width available.",
          "type": "string",
          "const": "contain"
        },
        {
          "description": "Natural size (1:1); wider images scroll.",
          "type": "string",
          "const": "actual"
        }
      ]
    }
  }
}
