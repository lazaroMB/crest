---
source: crates/domain/src/block.rs
expression: "schemars::schema_for!(CustomNode)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CustomNode",
  "description": "Declarative UI primitive of a `Custom` block, tagged by `type`.\n\nLua never touches GPUI: plugins return this tree and the UI turns it\ninto components.",
  "oneOf": [
    {
      "description": "Plain text.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "description": "The text.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    {
      "description": "Children laid out horizontally.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "row"
        },
        "children": {
          "description": "Child nodes.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "type",
        "children"
      ]
    },
    {
      "description": "Children laid out vertically.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "col"
        },
        "children": {
          "description": "Child nodes.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "type",
        "children"
      ]
    },
    {
      "description": "A bulleted list.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "list"
        },
        "items": {
          "description": "One node per item.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "type",
        "items"
      ]
    },
    {
      "description": "A table.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "table"
        }
      },
      "$ref": "#/$defs/TableSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A chart.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chart"
        }
      },
      "$ref": "#/$defs/ChartSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A code snippet.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "code"
        },
        "lang": {
          "description": "Language for highlighting.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Source code.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "Rendered markdown.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "markdown"
        },
        "source": {
          "description": "Markdown source.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A picture, from a file or inline bytes, with zoom and pan.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "source": {
          "description": "Inline bytes or a file. A file must be inside the workspace and\nnot sensitive; the app replaces a rejected one with a text node.",
          "$ref": "#/$defs/ImageData"
        },
        "media_type": {
          "description": "MIME type, e.g. `image/png`; required for inline bytes.",
          "type": [
            "string",
            "null"
          ]
        },
        "alt": {
          "description": "Text shown when the image cannot be drawn.",
          "type": [
            "string",
            "null"
          ]
        },
        "fit": {
          "description": "How the image is sized at first.",
          "$ref": "#/$defs/ImageFit",
          "default": "contain"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A basic HTML subset (headings, paragraphs, lists, tables, links,\nemphasis, code), drawn natively; no CSS layout and no scripts.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "html"
        },
        "source": {
          "description": "HTML source.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A JSON value as a collapsible tree.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "json"
        },
        "value": {
          "description": "The value."
        },
        "expand_depth": {
          "description": "Levels expanded at first (0 shows only the root collapsed).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    {
      "description": "A Mermaid diagram, with pan and zoom.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "mermaid"
        },
        "source": {
          "description": "Mermaid source.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source"
      ]
    },
    {
      "description": "A link that opens in the user's browser.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "link"
        },
        "text": {
          "description": "Text shown.",
          "type": "string"
        },
        "url": {
          "description": "Address; `http`, `https` or `mailto` only.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text",
        "url"
      ]
    },
    {
      "description": "A colored unified diff.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "diff"
        },
        "unified": {
          "description": "Unified diff text.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "unified"
      ]
    },
    {
      "description": "A 3D model (`/open` of an OBJ, STL or PLY file), with an orbit\ncamera.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "model3d"
        }
      },
      "$ref": "#/$defs/ModelSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "A function plot with parameter sliders, as the `plot` block draws\nit.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "plot"
        }
      },
      "$ref": "#/$defs/PlotSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Rows of spans on a time axis, with zoom, pan and a tooltip\n(traces, Gantt charts, waveforms).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "timeline"
        }
      },
      "$ref": "#/$defs/TimelineSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Records (log lines, requests) with a text or regex filter, level\nand field chips, follow mode and rows that open to their fields.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "filter_list"
        }
      },
      "$ref": "#/$defs/ListSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Nodes joined by edges, laid out in layers, by forces or on a grid,\nwith pan, zoom and a click to focus a node's neighbourhood (DOT,\nER diagrams, netlists, networks).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "graph"
        }
      },
      "$ref": "#/$defs/GraphSpec",
      "required": [
        "type"
      ]
    },
    {
      "description": "Nested rows with typed columns (text, numbers, durations, inline\nbars) and badges, collapsible (query plans, Terraform plans).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tree"
        }
      },
      "$ref": "#/$defs/TreeSpec",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "Column": {
      "description": "A table column header.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Header text.",
          "type": "string"
        },
        "align": {
          "description": "Horizontal alignment; the UI picks one when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/Align"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "Align": {
      "description": "Horizontal alignment of a column.",
      "oneOf": [
        {
          "description": "Left aligned.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Centered.",
          "type": "string",
          "const": "center"
        },
        {
          "description": "Right aligned.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "Cell": {
      "description": "A table cell: a plain JSON scalar.",
      "anyOf": [
        {
          "description": "Empty cell (`null`).",
          "type": "null"
        },
        {
          "description": "Boolean.",
          "type": "boolean"
        },
        {
          "description": "Number.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "Text.",
          "type": "string"
        }
      ]
    },
    "TableSpec": {
      "description": "A table: named columns and rows of cells.",
      "type": "object",
      "properties": {
        "columns": {
          "description": "Column headers, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "rows": {
          "description": "Rows; each must have one cell per column.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Cell"
            }
          }
        }
      },
      "required": [
        "columns",
        "rows"
      ]
    },
    "ChartKind": {
      "description": "How a chart is drawn.",
      "oneOf": [
        {
          "description": "Vertical bars.",
          "type": "string",
          "const": "bar"
        },
        {
          "description": "Lines.",
          "type": "string",
          "const": "line"
        },
        {
          "description": "Filled areas.",
          "type": "string",
          "const": "area"
        },
        {
          "description": "Pie; takes exactly one series.",
          "type": "string",
          "const": "pie"
        }
      ]
    },
    "Series": {
      "description": "A named series of values, one per chart label.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Legend name.",
          "type": "string"
        },
        "values": {
          "description": "Values, aligned with the chart labels.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "name",
        "values"
      ]
    },
    "ChartSpec": {
      "description": "A chart: labels on one axis and one or more numeric series.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Chart title.",
          "type": "string"
        },
        "kind": {
          "description": "How the series are drawn.",
          "$ref": "#/$defs/ChartKind"
        },
        "labels": {
          "description": "Category labels, one per value of each series.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "description": "Data series.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Series"
          }
        }
      },
      "required": [
        "title",
        "kind",
        "labels",
        "series"
      ]
    },
    "ImageData": {
      "description": "Bytes of an image block, tagged by `type`.",
      "oneOf": [
        {
          "description": "Inline, base64 encoded.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "base64"
            },
            "data": {
              "description": "Base64 payload.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "A file on disk.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "path"
            },
            "path": {
              "description": "File path.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ]
        }
      ]
    },
    "ImageFit": {
      "description": "How an [`CustomNode::Image`] is sized before the user zooms.",
      "oneOf": [
        {
          "description": "Natural size, scaled down to the width available.",
          "type": "string",
          "const": "contain"
        },
        {
          "description": "Natural size (1:1); wider images scroll.",
          "type": "string",
          "const": "actual"
        }
      ]
    },
    "ModelMesh": {
      "description": "A triangle mesh.",
      "type": "object",
      "properties": {
        "positions": {
          "description": "Vertex positions.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "triangles": {
          "description": "Triangles, as indices into `positions`.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "up": {
          "description": "The axis that points up.",
          "$ref": "#/$defs/UpAxis",
          "default": "y"
        }
      },
      "required": [
        "positions",
        "triangles"
      ]
    },
    "UpAxis": {
      "description": "The axis that points up in the file's coordinates.",
      "oneOf": [
        {
          "description": "`+Y` (OBJ, most real-time tools).",
          "type": "string",
          "const": "y"
        },
        {
          "description": "`+Z` (STL, PLY, most CAD tools).",
          "type": "string",
          "const": "z"
        }
      ]
    },
    "ModelSpec": {
      "description": "A model shown in a modal: the mesh and the file it came from.",
      "type": "object",
      "properties": {
        "name": {
          "description": "File name or title.",
          "type": "string"
        },
        "mesh": {
          "description": "The mesh.",
          "$ref": "#/$defs/ModelMesh"
        },
        "unit": {
          "description": "The length unit of the coordinates, when the file says it (`mm`,\n`in`; STEP does, OBJ/STL/PLY do not). Measurements show it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "mesh"
      ]
    },
    "PlotRange": {
      "description": "A closed interval of an axis or of `t`.",
      "type": "object",
      "properties": {
        "min": {
          "description": "Lower end.",
          "type": "number",
          "format": "double"
        },
        "max": {
          "description": "Upper end, greater than `min`.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "PlotFunction": {
      "description": "A function to draw.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "How `expr` is read.",
          "$ref": "#/$defs/FunctionKind"
        },
        "expr": {
          "description": "`f(x)` for explicit, `x(t)` for parametric, `f(x, y)` (drawn where\nit is 0) for implicit.",
          "type": "string"
        },
        "y_expr": {
          "description": "`y(t)`, for parametric functions only.",
          "type": [
            "string",
            "null"
          ]
        },
        "t_range": {
          "description": "Range of `t`, for parametric functions; `0..1` when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlotRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "description": "Legend label; the expression when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "expr"
      ]
    },
    "FunctionKind": {
      "description": "How a [`PlotFunction`] is defined.",
      "oneOf": [
        {
          "description": "`y = f(x)`.",
          "type": "string",
          "const": "explicit"
        },
        {
          "description": "`(x(t), y(t))`.",
          "type": "string",
          "const": "parametric"
        },
        {
          "description": "`f(x, y) = 0`.",
          "type": "string",
          "const": "implicit"
        }
      ]
    },
    "PlotParam": {
      "description": "A parameter with a slider.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Variable name used in the expressions.",
          "type": "string"
        },
        "min": {
          "description": "Slider minimum.",
          "type": "number",
          "format": "double"
        },
        "max": {
          "description": "Slider maximum.",
          "type": "number",
          "format": "double"
        },
        "step": {
          "description": "Slider step; continuous when absent.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "value": {
          "description": "Current value.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "name",
        "min",
        "max",
        "value"
      ]
    },
    "XySeries": {
      "description": "A numeric series.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Legend name.",
          "type": "string"
        },
        "x": {
          "description": "x coordinates.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "y": {
          "description": "y coordinates, one per x.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "style": {
          "description": "Points or a line.",
          "$ref": "#/$defs/SeriesStyle",
          "default": "scatter"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ]
    },
    "SeriesStyle": {
      "description": "How an [`XySeries`] is drawn.",
      "oneOf": [
        {
          "description": "Points.",
          "type": "string",
          "const": "scatter"
        },
        {
          "description": "A line through the points in order.",
          "type": "string",
          "const": "line"
        }
      ]
    },
    "AxisScale": {
      "description": "How an axis maps values to positions.",
      "oneOf": [
        {
          "description": "Equal steps for equal differences.",
          "type": "string",
          "const": "linear"
        },
        {
          "description": "Equal steps for equal ratios (base 10); only positive values show.",
          "type": "string",
          "const": "log"
        }
      ]
    },
    "PlotAspect": {
      "description": "The shape of a plot area.",
      "oneOf": [
        {
          "description": "Height follows the width.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "One unit (axis unit, so a decade on a log axis) is as long on both\naxes: circles stay round.",
          "type": "string",
          "const": "equal"
        }
      ]
    },
    "PlotSpec": {
      "description": "A plot of functions and series.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Title.",
          "type": [
            "string",
            "null"
          ]
        },
        "x_range": {
          "description": "Visible x range; the UI fits the data when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlotRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "y_range": {
          "description": "Visible y range; the UI fits the data when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlotRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "x_label": {
          "description": "Label of the x axis.",
          "type": [
            "string",
            "null"
          ]
        },
        "y_label": {
          "description": "Label of the y axis.",
          "type": [
            "string",
            "null"
          ]
        },
        "functions": {
          "description": "Functions to draw.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlotFunction"
          },
          "default": []
        },
        "params": {
          "description": "Parameters the functions use, each with a slider.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlotParam"
          },
          "default": []
        },
        "series": {
          "description": "Numeric series.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/XySeries"
          },
          "default": []
        },
        "x_scale": {
          "description": "Scale of the x axis.",
          "$ref": "#/$defs/AxisScale"
        },
        "y_scale": {
          "description": "Scale of the y axis.",
          "$ref": "#/$defs/AxisScale"
        },
        "aspect": {
          "description": "Shape of the plot area.",
          "$ref": "#/$defs/PlotAspect"
        },
        "x_reversed": {
          "description": "Whether the x axis runs right to left (IR wavenumbers, NMR\nchemical shifts).",
          "type": "boolean"
        }
      }
    },
    "TimeUnit": {
      "description": "Unit of every time in a [`TimelineSpec`].",
      "oneOf": [
        {
          "description": "Nanoseconds.",
          "type": "string",
          "const": "ns"
        },
        {
          "description": "Microseconds.",
          "type": "string",
          "const": "us"
        },
        {
          "description": "Milliseconds.",
          "type": "string",
          "const": "ms"
        },
        {
          "description": "Seconds.",
          "type": "string",
          "const": "s"
        },
        {
          "description": "Calendar time: seconds since 1970-01-01T00:00:00Z.",
          "type": "string",
          "const": "date"
        }
      ]
    },
    "TimelineRow": {
      "description": "One lane of the timeline.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique id of the row (a span id, a signal path).",
          "type": "string"
        },
        "label": {
          "description": "Text in the label column.",
          "type": "string"
        },
        "depth": {
          "description": "Indentation level (0 = top level), for trees of spans.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "group": {
          "description": "Consecutive rows of the same group are banded together.",
          "type": [
            "string",
            "null"
          ]
        },
        "spans": {
          "description": "Intervals of the row.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          },
          "default": []
        },
        "markers": {
          "description": "Instants of the row.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Marker"
          }
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "Span": {
      "description": "One interval of a row.",
      "type": "object",
      "properties": {
        "start": {
          "description": "Start time.",
          "type": "number",
          "format": "double"
        },
        "end": {
          "description": "End time; at least `start` (equal for an instant). `stop` is\naccepted too, since `end` is a keyword in Lua.",
          "type": "number",
          "format": "double"
        },
        "label": {
          "description": "Text drawn inside the bar when it fits, and in the tooltip.",
          "type": [
            "string",
            "null"
          ]
        },
        "color_key": {
          "description": "Spans with the same key share a palette color (a service, a kind).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Outcome; errors and warnings are drawn in their theme colors.",
          "anyOf": [
            {
              "$ref": "#/$defs/SpanStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "attrs": {
          "description": "Extra fields shown when the span is hovered or selected.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "SpanStatus": {
      "description": "How a span ended.",
      "oneOf": [
        {
          "description": "Finished fine.",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "Finished with a warning (slow, retried).",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Failed.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "On a critical path (a Gantt chart's critical tasks).",
          "type": "string",
          "const": "critical"
        },
        {
          "description": "Room a task may slip (a Gantt chart's slack), drawn faint.",
          "type": "string",
          "const": "slack"
        }
      ]
    },
    "Marker": {
      "description": "A point in time drawn as a tick across its row.",
      "type": "object",
      "properties": {
        "at": {
          "description": "When.",
          "type": "number",
          "format": "double"
        },
        "label": {
          "description": "What happened (shown in the tooltip).",
          "type": [
            "string",
            "null"
          ]
        },
        "color_key": {
          "description": "Palette key, as for spans.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at"
      ]
    },
    "TimeRange": {
      "description": "A closed time interval.",
      "type": "object",
      "properties": {
        "start": {
          "description": "First time shown.",
          "type": "number",
          "format": "double"
        },
        "end": {
          "description": "Last time shown; greater than `start`.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "TimelineSpec": {
      "description": "Rows of spans on a shared time axis.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption above the timeline.",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "Unit of every time.",
          "$ref": "#/$defs/TimeUnit",
          "default": "ms"
        },
        "rows": {
          "description": "Lanes, top to bottom.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineRow"
          }
        },
        "range": {
          "description": "Axis range at first; the extent of the data when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rows"
      ]
    },
    "ListItem": {
      "description": "One record.",
      "type": "object",
      "properties": {
        "level": {
          "description": "Severity (`error`, `warn`, `info`...); colors the row.",
          "type": [
            "string",
            "null"
          ]
        },
        "ts": {
          "description": "Timestamp as written by the source.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "The message.",
          "type": "string"
        },
        "fields": {
          "description": "Named fields, shown when the row is opened.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "text"
      ]
    },
    "ListSpec": {
      "description": "Records with a text filter and facet chips.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption above the list.",
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "description": "Fields shown as columns between the level and the text.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "description": "The records, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ListItem"
          }
        },
        "facets": {
          "description": "Fields offered as filter chips (besides the level).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "follow": {
          "description": "Start following the tail (scrolled to the last item).",
          "type": "boolean"
        }
      },
      "required": [
        "items"
      ]
    },
    "LayoutKind": {
      "description": "How the nodes are placed.",
      "oneOf": [
        {
          "description": "Layers in the edges' direction (Sugiyama): flows, dependencies,\nplans.",
          "type": "string",
          "const": "layered"
        },
        {
          "description": "A seeded spring embedding: networks without a direction.",
          "type": "string",
          "const": "force"
        },
        {
          "description": "Rows and columns in node order (grouped): loose collections.",
          "type": "string",
          "const": "grid"
        }
      ]
    },
    "FlowDirection": {
      "description": "Which way a layered layout flows.",
      "oneOf": [
        {
          "description": "Top to bottom.",
          "type": "string",
          "const": "down"
        },
        {
          "description": "Left to right.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "GraphNode": {
      "description": "One node.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique id, referenced by edges.",
          "type": "string"
        },
        "label": {
          "description": "Text in the box; the id when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "description": "Id of the group (cluster) the node belongs to.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Class of the node (`table`, `service`, `resistor`); nodes of one\nkind share a color.",
          "type": [
            "string",
            "null"
          ]
        },
        "attrs": {
          "description": "Extra fields shown when the node is focused.",
          "type": "object",
          "additionalProperties": true
        },
        "size": {
          "description": "Relative size from 0 to 1 (a metric scaled to its maximum): the\nbox grows up to twice its width and height.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "id"
      ]
    },
    "GraphEdge": {
      "description": "One edge, from node id to node id.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Id of the source node.",
          "type": "string"
        },
        "to": {
          "description": "Id of the target node.",
          "type": "string"
        },
        "label": {
          "description": "Text drawn along the edge.",
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "description": "Strength (a count, a cost); thicker edges are heavier.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "GraphGroup": {
      "description": "A named group of nodes, drawn as a box around them.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Id the nodes' `group` refers to.",
          "type": "string"
        },
        "label": {
          "description": "Caption of the box; the id when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ]
    },
    "GraphSpec": {
      "description": "Nodes joined by edges, with a layout.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption above the graph.",
          "type": [
            "string",
            "null"
          ]
        },
        "directed": {
          "description": "Edges have arrowheads (true by default).",
          "type": "boolean"
        },
        "layout": {
          "description": "How the nodes are placed.",
          "$ref": "#/$defs/LayoutKind",
          "default": "layered"
        },
        "direction": {
          "description": "Flow of a layered layout.",
          "$ref": "#/$defs/FlowDirection",
          "default": "down"
        },
        "seed": {
          "description": "Seed of the force layout (the same seed gives the same picture).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "nodes": {
          "description": "The nodes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphNode"
          }
        },
        "edges": {
          "description": "The edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "default": []
        },
        "groups": {
          "description": "Captions of the groups nodes refer to; a group not listed is\ncaptioned with its id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphGroup"
          }
        }
      },
      "required": [
        "nodes"
      ]
    },
    "TreeColumn": {
      "description": "One column.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Header, and the key of the nodes' `values`.",
          "type": "string"
        },
        "kind": {
          "description": "What it holds.",
          "$ref": "#/$defs/ColumnKind",
          "default": "text"
        },
        "unit": {
          "description": "For a duration, its time unit (`ns`, `us`, `ms`, `s`); for a\nnumber or a bar, a suffix (`rows`, `%`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ColumnKind": {
      "description": "What a column holds and how it is drawn.",
      "oneOf": [
        {
          "description": "Any value, as text, left-aligned.",
          "type": "string",
          "const": "text"
        },
        {
          "description": "A number, right-aligned.",
          "type": "string",
          "const": "number"
        },
        {
          "description": "A time span in the column's unit (`ms` by default), right-aligned.",
          "type": "string",
          "const": "duration"
        },
        {
          "description": "A number with a bar scaled to the column's largest value.",
          "type": "string",
          "const": "bar"
        }
      ]
    },
    "TreeNode": {
      "description": "One row, with its children.",
      "type": "object",
      "properties": {
        "label": {
          "description": "Text of the first column.",
          "type": "string"
        },
        "badge": {
          "description": "A short tag after the label (`hot`, `seq scan`, `+create`).",
          "type": [
            "string",
            "null"
          ]
        },
        "tone": {
          "description": "Color of the badge.",
          "anyOf": [
            {
              "$ref": "#/$defs/BadgeTone"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "description": "Value of each column, by column name.",
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "description": "Rows nested under this one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        }
      },
      "required": [
        "label"
      ]
    },
    "BadgeTone": {
      "description": "Color of a badge.",
      "oneOf": [
        {
          "description": "Muted.",
          "type": "string",
          "const": "neutral"
        },
        {
          "description": "Informational (accent).",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Good (success color).",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "Worth a look (warning color).",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Bad (danger color): a hot plan node, a resource destroyed.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "TreeSpec": {
      "description": "Nested rows with typed columns.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Caption above the tree.",
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "description": "Columns after the label.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeColumn"
          },
          "default": []
        },
        "nodes": {
          "description": "Top-level rows.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        },
        "expand_depth": {
          "description": "Levels open at first (2: the top rows and their children).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 2
        }
      },
      "required": [
        "nodes"
      ]
    }
  }
}
